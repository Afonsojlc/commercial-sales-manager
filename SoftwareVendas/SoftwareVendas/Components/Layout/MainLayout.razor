@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@using SoftwareVendas

<div class="flex h-screen w-full font-sans text-sm bg-white overflow-hidden">
    
    <!-- Sidebar -->
    <div class="w-60 bg-[#1D212E] flex flex-col text-gray-400 border-r border-gray-800 shrink-0">
        <!-- Logo Area -->
        <div class="h-14 flex items-center px-4 shrink-0">
            <svg class="w-6 h-6 text-green-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-white text-lg font-semibold tracking-wide">AJLC CRM</span>
        </div>
        
        <!-- Navigation Links -->
        <nav class="flex-1 overflow-y-auto py-4 space-y-1">
            <!-- Menus like Flowlu -->
            <NavLink class="flex items-center px-4 py-2 hover:bg-[#2A2F42] hover:text-white transition group border-l-2 border-transparent" ActiveClass="bg-[#2A2F42] text-white border-blue-500" href="dashboard">
                <svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                <span>Dashboard</span>
            </NavLink>
            
            <NavLink class="flex items-center px-4 py-2 hover:bg-[#2A2F42] hover:text-white transition group border-l-2 border-transparent" ActiveClass="bg-[#2A2F42] text-white border-blue-500" href="encomendas">
                <svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                <span>Encomendas</span>
            </NavLink>
            
            <NavLink class="flex items-center px-4 py-2 hover:bg-[#2A2F42] hover:text-white transition group border-l-2 border-transparent" ActiveClass="bg-[#2A2F42] text-white border-blue-500" href="novavenda">
                <svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                <span>Nova Venda</span>
            </NavLink>

            <NavLink class="flex items-center px-4 py-2 hover:bg-[#2A2F42] hover:text-white transition group border-l-2 border-transparent" ActiveClass="bg-[#2A2F42] text-white border-blue-500" href="clientes">
                <svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                <span>Clientes</span>
            </NavLink>
            
            <NavLink class="flex items-center px-4 py-2 hover:bg-[#2A2F42] hover:text-white transition group border-l-2 border-transparent" ActiveClass="bg-[#2A2F42] text-white border-blue-500" href="produtos">
                <svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                <span>Produtos</span>
            </NavLink>
            
            <NavLink class="flex items-center px-4 py-2 hover:bg-[#2A2F42] hover:text-white transition group border-l-2 border-transparent" ActiveClass="bg-[#2A2F42] text-white border-blue-500" href="definicoes">
                <svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                <span>Definições</span>
            </NavLink>
        </nav>
        
        <!-- Bottom User Menu -->
        <div class="p-4 border-t border-gray-800">
            <NavLink class="flex items-center text-gray-400 hover:text-white transition" href="/" Match="NavLinkMatch.All">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                Sair
            </NavLink>
        </div>
    </div>
    
    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
        <!-- Top Header (Flowlu Style) -->
        <header class="h-14 bg-[#1A1D27] flex items-center justify-between px-4 text-white shrink-0 shadow-md z-10">
            <!-- Left Header: Global Search and Add -->
            <div class="flex items-center flex-1">
                <button class="text-gray-400 hover:text-white p-1 rounded">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                </button>
                <div class="ml-4 relative flex items-center">
                    <svg class="w-4 h-4 text-gray-500 absolute left-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <input type="text" placeholder="Search" class="bg-[#2A2F42] text-sm text-gray-300 placeholder-gray-500 rounded-full pl-9 pr-4 py-1.5 focus:outline-none focus:ring-1 focus:ring-blue-500 w-64 transition-all" />
                </div>
            </div>
            
            <!-- Center Header: Day & Event -->
            <div class="flex items-center space-x-4 flex-1 justify-center">
                <div class="flex flex-col items-center justify-center leading-none text-center">
                    <span class="text-xs text-gray-400">@DateTime.Now.ToString("ddd")</span>
                    <span class="text-xl font-bold">@DateTime.Now.ToString("dd")</span>
                </div>
                <div class="flex flex-col text-xs">
                    <span class="font-bold text-gray-200">@Sessao.Nome</span>
                    <span class="text-gray-400">@Sessao.Cargo &bull; @DateTime.Now.ToString("HH:mm")</span>
                </div>
            </div>
            
            <!-- Right Header: Notifications & Profile -->
            <div class="flex items-center space-x-4 flex-1 justify-end">
                <button class="text-gray-400 hover:text-white relative">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                    <span class="absolute -top-1 -right-1 bg-blue-500 text-white text-[10px] font-bold px-1 rounded-full">2</span>
                </button>
                <div class="w-8 h-8 bg-blue-600 rounded-full border-2 border-gray-600 flex items-center justify-center text-sm font-bold text-white shadow-inner cursor-pointer">
                    @(Sessao.Nome.Length > 0 ? Sessao.Nome.Substring(0, 1).ToUpper() : "A")
                </div>
            </div>
        </header>
        
        <!-- Main Workspace Area -->
        <main class="flex-1 overflow-auto bg-[#F7F8FA] relative">
            @Body
        </main>
    </div>
</div>
