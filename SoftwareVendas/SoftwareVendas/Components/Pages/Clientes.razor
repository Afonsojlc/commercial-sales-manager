@page "/clientes"
@using System.Data
@using Microsoft.Data.SqlClient

<div class="p-4 sm:p-6 space-y-6 max-w-[1720px] mx-auto w-full">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Gestão de Clientes</h1>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium tracking-wide bg-cobalt-500/10 text-cobalt-400 border border-cobalt-500/20">
                    AJLC // CLIENTES
                </span>
            </div>
            <p class="text-xs text-slate-400 mt-1">
                Consulta de contas ativas, histórico de compras e ficha cadastral de clientes.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <button @onclick="AbrirModalNovoCliente" class="px-5 py-2.5 rounded-2xl bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs shadow-glow-cobalt flex items-center gap-2 transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                <span>Novo Cliente</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAviso))
    {
        <div class="p-4 rounded-2xl text-xs font-medium border flex items-center gap-2 @(mensagemAviso.Contains("sucesso") ? "bg-emerald-500/10 text-emerald-300 border-emerald-500/30" : "bg-rose-500/10 text-rose-300 border-rose-500/30")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>@mensagemAviso</span>
        </div>
    }

    <!-- Filtros -->
    <div class="rounded-3xl glass-panel p-4 sm:p-5 shadow-floating-card flex flex-wrap items-center gap-3">
        <select @bind="filtro" class="glass-input rounded-2xl px-3 py-2 text-xs text-slate-200 w-44">
            <option value="Nome">Filtrar por Nome</option>
            <option value="NIF">Filtrar por NIF</option>
            <option value="Email">Filtrar por Email</option>
            <option value="Localidade">Filtrar por Cidade</option>
            <option value="Morada">Filtrar por Morada</option>
        </select>
        
        <input @bind="termo" @bind:event="oninput" @onkeyup="Pesquisar" type="text" placeholder="Pesquisar cliente por nome, NIF ou localidade..." class="flex-1 glass-input rounded-2xl px-4 py-2 text-xs text-white placeholder-slate-500" />
        
        <button @onclick="Pesquisar" class="px-5 py-2 rounded-2xl bg-cobalt-600 hover:bg-cobalt-500 text-white text-xs font-bold shadow-glow-cobalt transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <span>Pesquisar</span>
        </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Lista de Clientes -->
        <div class="lg:col-span-2 rounded-3xl glass-panel p-6 shadow-floating-card flex flex-col overflow-hidden">
            <div class="flex justify-between items-center pb-4 mb-2 border-b border-white/10">
                <h2 class="text-base font-bold text-white tracking-tight">Listagem de Contas</h2>
                <span class="px-2.5 py-1 rounded-xl text-xs font-mono font-medium bg-white/5 text-slate-400 border border-white/5">
                    @(dtClientes?.Rows.Count ?? 0) clientes
                </span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="text-[11px] font-mono uppercase tracking-wider text-slate-400 border-b border-white/5">
                            <th class="py-3 px-3 font-semibold">ID</th>
                            <th class="py-3 px-3 font-semibold">Nome</th>
                            <th class="py-3 px-3 font-semibold">NIF</th>
                            <th class="py-3 px-3 font-semibold">Email</th>
                            <th class="py-3 px-3 font-semibold">Telefone</th>
                            <th class="py-3 px-3 font-semibold">Localidade</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/[0.03] text-xs">
                        @if (dtClientes != null && dtClientes.Rows.Count > 0)
                        {
                            @foreach (DataRow row in dtClientes.Rows)
                            {
                                string id = row["ID_Cliente"].ToString()!;
                                bool isSelected = (id == idClienteSelecionado);
                                <tr class="hover:bg-white/[0.04] cursor-pointer transition-colors @(isSelected ? "bg-cobalt-500/15 border-l-2 border-cobalt-400" : "")" @onclick="() => SelecionarCliente(id)">
                                    <td class="py-3.5 px-3 font-mono font-bold text-slate-400">@row["ID_Cliente"]</td>
                                    <td class="py-3.5 px-3 font-semibold text-white">@row["Nome_Cliente"]</td>
                                    <td class="py-3.5 px-3 font-mono text-cobalt-400">@row["NIF"]</td>
                                    <td class="py-3.5 px-3 text-slate-300">@row["Email"]</td>
                                    <td class="py-3.5 px-3 font-mono text-slate-300">@row["Telefone"]</td>
                                    <td class="py-3.5 px-3 text-slate-300">@row["Cidade"]</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-10 text-slate-500 font-mono">Nenhum cliente encontrado.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Histórico do Cliente -->
        <div class="rounded-3xl glass-panel p-6 shadow-floating-card flex flex-col overflow-hidden">
            <div class="flex justify-between items-center pb-4 mb-4 border-b border-white/10">
                <h2 class="text-base font-bold text-white tracking-tight">Histórico de Compras</h2>
                @if (!string.IsNullOrEmpty(idClienteSelecionado))
                {
                    <span class="text-[10px] font-mono text-cobalt-400 bg-cobalt-500/10 px-2 py-0.5 rounded-full border border-cobalt-500/20">
                        CLIENTE #@idClienteSelecionado
                    </span>
                }
            </div>
            <div class="overflow-y-auto space-y-3 max-h-[600px]">
                @if (string.IsNullOrEmpty(idClienteSelecionado))
                {
                    <div class="text-center py-16 text-slate-500 text-xs font-mono">
                        <svg class="w-8 h-8 mx-auto text-slate-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
                        Selecione um cliente na tabela à esquerda para carregar o histórico de encomendas.
                    </div>
                }
                else if (dtHistorico != null && dtHistorico.Rows.Count > 0)
                {
                    @foreach (DataRow row in dtHistorico.Rows)
                    {
                        <div class="bg-obsidian-950/80 p-3.5 rounded-2xl border border-white/10 hover:border-cobalt-500/30 transition flex justify-between items-center text-xs">
                            <div>
                                <p class="font-bold font-mono text-white">Venda #@row["Nº Venda"]</p>
                                <p class="text-[11px] font-mono text-slate-400 mt-0.5">@Convert.ToDateTime(row["Data"]).ToString("dd/MM/yyyy")</p>
                            </div>
                            <div class="text-right">
                                <p class="font-bold font-mono text-cobalt-400 text-sm">€ @Convert.ToDecimal(row["Total (€)"]).ToString("N2")</p>
                                <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                    @row["Estado"]
                                </span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-slate-500 text-center py-16 text-xs font-mono">Sem encomendas registadas para este cliente.</p>
                }
            </div>
        </div>
    </div>

    <!-- Modal Novo Cliente -->
    @if (mostrarModalNovoCliente)
    {
        <div class="fixed inset-0 bg-black/75 backdrop-blur-md z-50 flex items-center justify-center p-4">
            <div class="glass-panel-glow border-cobalt-500/30 rounded-3xl max-w-2xl w-full p-7 max-h-[90vh] overflow-y-auto shadow-2xl">
                <div class="flex justify-between items-center border-b border-white/10 pb-3 mb-5">
                    <h2 class="text-lg font-bold text-white tracking-tight">Registar Novo Cliente</h2>
                    <button @onclick="FecharModalNovoCliente" class="text-slate-400 hover:text-white text-xl leading-none">&times;</button>
                </div>

                @if (!string.IsNullOrEmpty(erroModal))
                {
                    <div class="p-3 mb-4 rounded-xl bg-rose-500/10 text-rose-300 border border-rose-500/20 text-xs font-mono">
                        @erroModal
                    </div>
                }

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                    <div>
                        <label class="block font-mono uppercase tracking-wider text-slate-400 mb-1">ID Cliente *</label>
                        <input type="text" @bind="novoIdCliente" class="w-full glass-input rounded-xl px-3 py-2 font-mono text-white" />
                    </div>
                    <div>
                        <label class="block font-mono uppercase tracking-wider text-slate-400 mb-1">NIF *</label>
                        <input type="text" @bind="novoNIF" placeholder="Ex: 501234567" class="w-full glass-input rounded-xl px-3 py-2 font-mono text-white" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block font-mono uppercase tracking-wider text-slate-400 mb-1">Nome do Cliente / Razão Social *</label>
                        <input type="text" @bind="novoNome" placeholder="Ex: ElectroLuz Lda" class="w-full glass-input rounded-xl px-3 py-2 text-white" />
                    </div>
                    <div>
                        <label class="block font-mono uppercase tracking-wider text-slate-400 mb-1">Email Comercial *</label>
                        <input type="email" @bind="novoEmail" placeholder="contacto@empresa.pt" class="w-full glass-input rounded-xl px-3 py-2 text-white" />
                    </div>
                    <div>
                        <label class="block font-mono uppercase tracking-wider text-slate-400 mb-1">Telefone / Telemóvel *</label>
                        <input type="text" @bind="novoTelefone" placeholder="Ex: 210123456" class="w-full glass-input rounded-xl px-3 py-2 font-mono text-white" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block font-mono uppercase tracking-wider text-slate-400 mb-1">Morada Completa *</label>
                        <input type="text" @bind="novaMorada" placeholder="Rua, Número, Andar..." class="w-full glass-input rounded-xl px-3 py-2 text-white" />
                    </div>
                    <div>
                        <label class="block font-mono uppercase tracking-wider text-slate-400 mb-1">Código Postal</label>
                        <input type="text" @bind="novoCodigoPostal" placeholder="Ex: 4000-001" class="w-full glass-input rounded-xl px-3 py-2 font-mono text-white" />
                    </div>
                    <div>
                        <label class="block font-mono uppercase tracking-wider text-slate-400 mb-1">Cidade / Localidade</label>
                        <input type="text" @bind="novaCidade" placeholder="Ex: Porto" class="w-full glass-input rounded-xl px-3 py-2 text-white" />
                    </div>
                </div>

                <div class="mt-6 pt-4 border-t border-white/10 flex justify-end gap-3">
                    <button @onclick="FecharModalNovoCliente" class="px-4 py-2 text-xs font-semibold text-slate-300 bg-white/5 hover:bg-white/10 rounded-xl transition">
                        Cancelar
                    </button>
                    <button @onclick="GravarNovoCliente" class="px-5 py-2 bg-cobalt-600 hover:bg-cobalt-500 text-white rounded-xl font-bold text-xs shadow-glow-cobalt transition">
                        Guardar Cliente
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string filtro = "Nome";
    private string termo = "";
    private DataTable? dtClientes;
    private DataTable? dtHistorico;
    private string idClienteSelecionado = "";
    private string mensagemAviso = "";

    // Modal Novo Cliente
    private bool mostrarModalNovoCliente = false;
    private string novoIdCliente = "";
    private string novoNome = "";
    private string novoNIF = "";
    private string novoEmail = "";
    private string novoTelefone = "";
    private string novaMorada = "";
    private string novoCodigoPostal = "";
    private string novaCidade = "";
    private string erroModal = "";

    protected override void OnInitialized()
    {
        Pesquisar();
    }

    private void Pesquisar()
    {
        idClienteSelecionado = "";
        dtHistorico = null;
        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = "SELECT ID_Cliente, Nome_Cliente, NIF, Email, Telefone, Cidade FROM Clientes";

                if (!string.IsNullOrWhiteSpace(termo))
                {
                    string coluna = "Nome_Cliente";
                    if (filtro == "NIF") coluna = "NIF";
                    else if (filtro == "Email") coluna = "Email";
                    else if (filtro == "Localidade") coluna = "Cidade";
                    else if (filtro == "Morada") coluna = "Morada_Completa";

                    query += $" WHERE {coluna} LIKE @t";
                }

                query += " ORDER BY Nome_Cliente ASC";

                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    if (!string.IsNullOrWhiteSpace(termo))
                    {
                        cmd.Parameters.AddWithValue("@t", "%" + termo + "%");
                    }
                    SqlDataAdapter da = new SqlDataAdapter(cmd);
                    dtClientes = new DataTable();
                    da.Fill(dtClientes);
                }
            }
            catch (Exception ex)
            {
                mensagemAviso = "Erro ao pesquisar clientes: " + ex.Message;
            }
        }
    }

    private void SelecionarCliente(string id)
    {
        idClienteSelecionado = id;
        CarregarHistorico();
    }

    private void CarregarHistorico()
    {
        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = @"SELECT Numero_Encomenda as 'Nº Venda', Data_Encomenda as 'Data', 
                                Valor_Total as 'Total (€)', Estado, Desconto_Global as 'Desconto (%)'
                                FROM Encomenda WHERE ID_Cliente = @id ORDER BY Data_Encomenda DESC";

                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@id", idClienteSelecionado);
                    SqlDataAdapter da = new SqlDataAdapter(cmd);
                    dtHistorico = new DataTable();
                    da.Fill(dtHistorico);
                }
            }
            catch (Exception ex)
            {
                mensagemAviso = "Erro ao carregar histórico: " + ex.Message;
            }
        }
    }

    private void AbrirModalNovoCliente()
    {
        erroModal = "";
        novoNome = "";
        novoNIF = "";
        novoEmail = "";
        novoTelefone = "";
        novaMorada = "";
        novoCodigoPostal = "";
        novaCidade = "";
        
        // Calcular Próximo ID Sequencial (ex: CLI-004)
        novoIdCliente = ObterProximoIdCliente();
        mostrarModalNovoCliente = true;
    }

    private string ObterProximoIdCliente()
    {
        int maxNumero = 0;
        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = "SELECT ID_Cliente FROM Clientes WHERE ID_Cliente LIKE 'CLI-%'";
                using (SqlCommand cmd = new SqlCommand(query, con))
                using (SqlDataReader rd = cmd.ExecuteReader())
                {
                    while (rd.Read())
                    {
                        string idStr = rd["ID_Cliente"].ToString() ?? "";
                        string numPart = idStr.Replace("CLI-", "").Trim();
                        if (int.TryParse(numPart, out int num) && num > maxNumero)
                        {
                            maxNumero = num;
                        }
                    }
                }
            }
            catch { }
        }
        return $"CLI-{(maxNumero + 1):D3}";
    }

    private void FecharModalNovoCliente()
    {
        mostrarModalNovoCliente = false;
    }

    private void GravarNovoCliente()
    {
        erroModal = "";
        if (string.IsNullOrWhiteSpace(novoIdCliente) || 
            string.IsNullOrWhiteSpace(novoNome) || 
            string.IsNullOrWhiteSpace(novoNIF) || 
            string.IsNullOrWhiteSpace(novaMorada) ||
            string.IsNullOrWhiteSpace(novoEmail) ||
            string.IsNullOrWhiteSpace(novoTelefone))
        {
            erroModal = "Por favor preencha todos os campos obrigatórios assinalados com *.";
            return;
        }

        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                // Verificar se ID ou NIF já existem
                string queryCheck = "SELECT COUNT(*) FROM Clientes WHERE ID_Cliente = @id OR NIF = @nif";
                using (SqlCommand cmdCheck = new SqlCommand(queryCheck, con))
                {
                    cmdCheck.Parameters.AddWithValue("@id", novoIdCliente.Trim());
                    cmdCheck.Parameters.AddWithValue("@nif", novoNIF.Trim());
                    int existe = Convert.ToInt32(cmdCheck.ExecuteScalar());
                    if (existe > 0)
                    {
                        erroModal = "Já existe um cliente registado com este ID ou NIF.";
                        return;
                    }
                }

                string queryInsert = @"
                    INSERT INTO Clientes 
                    (ID_Cliente, Nome_Cliente, NIF, Morada_Completa, Codigo_Postal, Cidade, Email, Telefone)
                    VALUES 
                    (@id, @nome, @nif, @morada, @cp, @cidade, @email, @tel)";

                using (SqlCommand cmd = new SqlCommand(queryInsert, con))
                {
                    cmd.Parameters.AddWithValue("@id", novoIdCliente.Trim());
                    cmd.Parameters.AddWithValue("@nome", novoNome.Trim());
                    cmd.Parameters.AddWithValue("@nif", novoNIF.Trim());
                    cmd.Parameters.AddWithValue("@morada", novaMorada.Trim());
                    cmd.Parameters.AddWithValue("@cp", string.IsNullOrWhiteSpace(novoCodigoPostal) ? DBNull.Value : novoCodigoPostal.Trim());
                    cmd.Parameters.AddWithValue("@cidade", string.IsNullOrWhiteSpace(novaCidade) ? DBNull.Value : novaCidade.Trim());
                    cmd.Parameters.AddWithValue("@email", novoEmail.Trim());
                    cmd.Parameters.AddWithValue("@tel", novoTelefone.Trim());

                    cmd.ExecuteNonQuery();
                }

                mostrarModalNovoCliente = false;
                mensagemAviso = $"Cliente '{novoNome}' ({novoIdCliente}) registado com sucesso!";
                Pesquisar();
                SelecionarCliente(novoIdCliente.Trim());
            }
            catch (Exception ex)
            {
                erroModal = "Erro ao gravar cliente: " + ex.Message;
            }
        }
    }
}
