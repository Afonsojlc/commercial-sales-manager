@page "/clientes"
@using System.Data
@using Microsoft.Data.SqlClient

<div class="p-8 flex flex-col h-full overflow-hidden">
    <!-- Header -->
    <div class="flex justify-between items-center mb-6 shrink-0">
        <h1 class="text-3xl font-bold text-gray-800">Gestão de Clientes</h1>
        <button @onclick="AbrirModalNovoCliente" class="bg-[#3F6CD8] hover:bg-blue-700 text-white font-medium px-4 py-2 rounded shadow transition flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Novo Cliente
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAviso))
    {
        <div class="p-3 mb-4 rounded border text-sm shrink-0 @(mensagemAviso.Contains("sucesso") ? "bg-green-50 text-green-800 border-green-200" : "bg-red-50 text-red-700 border-red-200")">
            @mensagemAviso
        </div>
    }

    <!-- Filtros -->
    <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 flex items-center space-x-4 mb-6 shrink-0">
        <select @bind="filtro" class="border border-gray-300 rounded px-3 py-2 w-48 focus:ring-blue-500 focus:border-blue-500">
            <option value="Nome">Nome</option>
            <option value="NIF">NIF</option>
            <option value="Email">Email</option>
            <option value="Localidade">Localidade</option>
            <option value="Morada">Morada</option>
        </select>
        
        <input @bind="termo" @bind:event="oninput" @onkeyup="Pesquisar" type="text" placeholder="Pesquisar cliente..." class="flex-1 border border-gray-300 rounded px-4 py-2 focus:ring-blue-500 focus:border-blue-500" />
        
        <button @onclick="Pesquisar" class="bg-[#3F6CD8] text-white px-6 py-2 rounded shadow hover:bg-blue-700 transition">
            Pesquisar
        </button>
    </div>

    <div class="flex-1 flex flex-col md:flex-row space-y-6 md:space-y-0 md:space-x-6 overflow-hidden">
        <!-- Lista de Clientes -->
        <div class="w-full md:w-2/3 bg-white rounded-lg shadow-sm border border-gray-100 flex flex-col overflow-hidden">
            <div class="bg-[#2B3347] text-white px-4 py-3 font-semibold flex justify-between items-center">
                <span>Listagem de Clientes</span>
                <span class="text-xs bg-white/20 px-2 py-0.5 rounded text-white font-normal">@(dtClientes?.Rows.Count ?? 0) clientes</span>
            </div>
            <div class="flex-1 overflow-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-gray-50 sticky top-0">
                        <tr>
                            <th class="px-4 py-2 border-b font-medium text-gray-600">ID</th>
                            <th class="px-4 py-2 border-b font-medium text-gray-600">Nome</th>
                            <th class="px-4 py-2 border-b font-medium text-gray-600">NIF</th>
                            <th class="px-4 py-2 border-b font-medium text-gray-600">Email</th>
                            <th class="px-4 py-2 border-b font-medium text-gray-600">Telefone</th>
                            <th class="px-4 py-2 border-b font-medium text-gray-600">Localidade</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (dtClientes != null && dtClientes.Rows.Count > 0)
                        {
                            @foreach (DataRow row in dtClientes.Rows)
                            {
                                string id = row["ID_Cliente"].ToString()!;
                                bool isSelected = (id == idClienteSelecionado);
                                <tr class="border-b hover:bg-blue-50 cursor-pointer @(isSelected ? "bg-blue-100" : "")" @onclick="() => SelecionarCliente(id)">
                                    <td class="px-4 py-3 text-sm font-semibold text-gray-700">@row["ID_Cliente"]</td>
                                    <td class="px-4 py-3 text-sm font-medium text-gray-900">@row["Nome_Cliente"]</td>
                                    <td class="px-4 py-3 text-sm">@row["NIF"]</td>
                                    <td class="px-4 py-3 text-sm text-gray-600">@row["Email"]</td>
                                    <td class="px-4 py-3 text-sm text-gray-600">@row["Telefone"]</td>
                                    <td class="px-4 py-3 text-sm text-gray-600">@row["Cidade"]</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-8 text-gray-400">Nenhum cliente encontrado.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Histórico do Cliente -->
        <div class="w-full md:w-1/3 bg-white rounded-lg shadow-sm border border-gray-100 flex flex-col overflow-hidden">
            <div class="bg-[#2B3347] text-white px-4 py-3 font-semibold">Histórico de Compras</div>
            <div class="flex-1 overflow-auto p-4">
                @if (string.IsNullOrEmpty(idClienteSelecionado))
                {
                    <p class="text-gray-400 text-center mt-10">Selecione um cliente para ver o histórico.</p>
                }
                else if (dtHistorico != null && dtHistorico.Rows.Count > 0)
                {
                    <div class="space-y-4">
                        @foreach (DataRow row in dtHistorico.Rows)
                        {
                            <div class="border border-gray-200 rounded p-3 flex justify-between items-center shadow-sm hover:shadow transition">
                                <div>
                                    <p class="font-semibold text-gray-800">Venda #@row["Nº Venda"]</p>
                                    <p class="text-xs text-gray-500">@Convert.ToDateTime(row["Data"]).ToString("dd/MM/yyyy")</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-bold text-[#3F6CD8]">€ @Convert.ToDecimal(row["Total (€)"]).ToString("N2")</p>
                                    <span class="text-xs px-2 py-1 rounded bg-green-100 text-green-800">@row["Estado"]</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-gray-400 text-center mt-10">Sem encomendas registadas para este cliente.</p>
                }
            </div>
        </div>
    </div>

    <!-- Modal Novo Cliente -->
    @if (mostrarModalNovoCliente)
    {
        <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full p-6 max-h-[90vh] overflow-y-auto">
                <div class="flex justify-between items-center border-b pb-3 mb-4">
                    <h2 class="text-xl font-bold text-[#2B3347]">Registar Novo Cliente</h2>
                    <button @onclick="FecharModalNovoCliente" class="text-gray-400 hover:text-gray-600 text-2xl font-bold">&times;</button>
                </div>

                @if (!string.IsNullOrEmpty(erroModal))
                {
                    <div class="p-3 mb-4 rounded bg-red-50 text-red-700 border border-red-200 text-sm">
                        @erroModal
                    </div>
                }

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">ID Cliente *</label>
                        <input type="text" @bind="novoIdCliente" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-blue-500 font-mono bg-gray-50" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">NIF *</label>
                        <input type="text" @bind="novoNIF" placeholder="Ex: 501234567" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-blue-500" />
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Nome do Cliente / Empresa *</label>
                        <input type="text" @bind="novoNome" placeholder="Ex: ElectroLuz Lda" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Email *</label>
                        <input type="email" @bind="novoEmail" placeholder="contacto@empresa.pt" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Telefone *</label>
                        <input type="text" @bind="novoTelefone" placeholder="Ex: 210123456" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-blue-500" />
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Morada Completa *</label>
                        <input type="text" @bind="novaMorada" placeholder="Rua, Número, Andar..." class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Código Postal</label>
                        <input type="text" @bind="novoCodigoPostal" placeholder="Ex: 4000-001" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Cidade / Localidade</label>
                        <input type="text" @bind="novaCidade" placeholder="Ex: Porto" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-blue-500" />
                    </div>
                </div>

                <div class="mt-6 pt-4 border-t flex justify-end space-x-3">
                    <button @onclick="FecharModalNovoCliente" class="px-4 py-2 border border-gray-300 rounded text-gray-600 hover:bg-gray-100 font-medium text-sm transition">
                        Cancelar
                    </button>
                    <button @onclick="GravarNovoCliente" class="px-5 py-2 bg-[#3F6CD8] hover:bg-blue-700 text-white rounded font-medium text-sm shadow transition">
                        Guardar Cliente
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string filtro = "Nome";
    private string termo = "";
    private DataTable? dtClientes;
    private DataTable? dtHistorico;
    private string idClienteSelecionado = "";
    private string mensagemAviso = "";

    // Modal Novo Cliente
    private bool mostrarModalNovoCliente = false;
    private string novoIdCliente = "";
    private string novoNome = "";
    private string novoNIF = "";
    private string novoEmail = "";
    private string novoTelefone = "";
    private string novaMorada = "";
    private string novoCodigoPostal = "";
    private string novaCidade = "";
    private string erroModal = "";

    protected override void OnInitialized()
    {
        Pesquisar();
    }

    private void Pesquisar()
    {
        idClienteSelecionado = "";
        dtHistorico = null;
        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = "SELECT ID_Cliente, Nome_Cliente, NIF, Email, Telefone, Cidade FROM Clientes";

                if (!string.IsNullOrWhiteSpace(termo))
                {
                    string coluna = "Nome_Cliente";
                    if (filtro == "NIF") coluna = "NIF";
                    else if (filtro == "Email") coluna = "Email";
                    else if (filtro == "Localidade") coluna = "Cidade";
                    else if (filtro == "Morada") coluna = "Morada_Completa";

                    query += $" WHERE {coluna} LIKE @t";
                }

                query += " ORDER BY Nome_Cliente ASC";

                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    if (!string.IsNullOrWhiteSpace(termo))
                    {
                        cmd.Parameters.AddWithValue("@t", "%" + termo + "%");
                    }
                    SqlDataAdapter da = new SqlDataAdapter(cmd);
                    dtClientes = new DataTable();
                    da.Fill(dtClientes);
                }
            }
            catch (Exception ex)
            {
                mensagemAviso = "Erro ao pesquisar clientes: " + ex.Message;
            }
        }
    }

    private void SelecionarCliente(string id)
    {
        idClienteSelecionado = id;
        CarregarHistorico();
    }

    private void CarregarHistorico()
    {
        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = @"SELECT Numero_Encomenda as 'Nº Venda', Data_Encomenda as 'Data', 
                                Valor_Total as 'Total (€)', Estado, Desconto_Global as 'Desconto (%)'
                                FROM Encomenda WHERE ID_Cliente = @id ORDER BY Data_Encomenda DESC";

                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@id", idClienteSelecionado);
                    SqlDataAdapter da = new SqlDataAdapter(cmd);
                    dtHistorico = new DataTable();
                    da.Fill(dtHistorico);
                }
            }
            catch (Exception ex)
            {
                mensagemAviso = "Erro ao carregar histórico: " + ex.Message;
            }
        }
    }

    private void AbrirModalNovoCliente()
    {
        erroModal = "";
        novoNome = "";
        novoNIF = "";
        novoEmail = "";
        novoTelefone = "";
        novaMorada = "";
        novoCodigoPostal = "";
        novaCidade = "";
        
        // Calcular Próximo ID Sequencial (ex: CLI-004)
        novoIdCliente = ObterProximoIdCliente();
        mostrarModalNovoCliente = true;
    }

    private string ObterProximoIdCliente()
    {
        int maxNumero = 0;
        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = "SELECT ID_Cliente FROM Clientes WHERE ID_Cliente LIKE 'CLI-%'";
                using (SqlCommand cmd = new SqlCommand(query, con))
                using (SqlDataReader rd = cmd.ExecuteReader())
                {
                    while (rd.Read())
                    {
                        string idStr = rd["ID_Cliente"].ToString() ?? "";
                        string numPart = idStr.Replace("CLI-", "").Trim();
                        if (int.TryParse(numPart, out int num) && num > maxNumero)
                        {
                            maxNumero = num;
                        }
                    }
                }
            }
            catch { }
        }
        return $"CLI-{(maxNumero + 1):D3}";
    }

    private void FecharModalNovoCliente()
    {
        mostrarModalNovoCliente = false;
    }

    private void GravarNovoCliente()
    {
        erroModal = "";
        if (string.IsNullOrWhiteSpace(novoIdCliente) || 
            string.IsNullOrWhiteSpace(novoNome) || 
            string.IsNullOrWhiteSpace(novoNIF) || 
            string.IsNullOrWhiteSpace(novaMorada) ||
            string.IsNullOrWhiteSpace(novoEmail) ||
            string.IsNullOrWhiteSpace(novoTelefone))
        {
            erroModal = "Por favor preencha todos os campos obrigatórios assinalados com *.";
            return;
        }

        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                // Verificar se ID ou NIF já existem
                string queryCheck = "SELECT COUNT(*) FROM Clientes WHERE ID_Cliente = @id OR NIF = @nif";
                using (SqlCommand cmdCheck = new SqlCommand(queryCheck, con))
                {
                    cmdCheck.Parameters.AddWithValue("@id", novoIdCliente.Trim());
                    cmdCheck.Parameters.AddWithValue("@nif", novoNIF.Trim());
                    int existe = Convert.ToInt32(cmdCheck.ExecuteScalar());
                    if (existe > 0)
                    {
                        erroModal = "Já existe um cliente registado com este ID ou NIF.";
                        return;
                    }
                }

                string queryInsert = @"
                    INSERT INTO Clientes 
                    (ID_Cliente, Nome_Cliente, NIF, Morada_Completa, Codigo_Postal, Cidade, Email, Telefone)
                    VALUES 
                    (@id, @nome, @nif, @morada, @cp, @cidade, @email, @tel)";

                using (SqlCommand cmd = new SqlCommand(queryInsert, con))
                {
                    cmd.Parameters.AddWithValue("@id", novoIdCliente.Trim());
                    cmd.Parameters.AddWithValue("@nome", novoNome.Trim());
                    cmd.Parameters.AddWithValue("@nif", novoNIF.Trim());
                    cmd.Parameters.AddWithValue("@morada", novaMorada.Trim());
                    cmd.Parameters.AddWithValue("@cp", string.IsNullOrWhiteSpace(novoCodigoPostal) ? DBNull.Value : novoCodigoPostal.Trim());
                    cmd.Parameters.AddWithValue("@cidade", string.IsNullOrWhiteSpace(novaCidade) ? DBNull.Value : novaCidade.Trim());
                    cmd.Parameters.AddWithValue("@email", novoEmail.Trim());
                    cmd.Parameters.AddWithValue("@tel", novoTelefone.Trim());

                    cmd.ExecuteNonQuery();
                }

                mostrarModalNovoCliente = false;
                mensagemAviso = $"Cliente '{novoNome}' ({novoIdCliente}) registado com sucesso!";
                Pesquisar();
                SelecionarCliente(novoIdCliente.Trim());
            }
            catch (Exception ex)
            {
                erroModal = "Erro ao gravar cliente: " + ex.Message;
            }
        }
    }
}
