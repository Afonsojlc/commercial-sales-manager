@page "/dashboard"
@using Microsoft.Data.SqlClient
@using SoftwareVendas
@using System.Data
@inject IJSRuntime JS

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        #printableReport, #printableReport * {
            visibility: visible;
        }
        #printableReport {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            padding: 24px;
            margin: 0;
            background: white !important;
        }
        .no-print {
            display: none !important;
        }
    }
</style>

<div class="p-4 sm:p-6 space-y-6 max-w-[1720px] mx-auto w-full">
    
    <!-- 1. Executive Top Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 no-print">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Dashboard: Ganhos & Desempenho</h1>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium tracking-wide bg-cobalt-500/10 text-cobalt-400 border border-cobalt-500/20">
                    AJLC // PAINEL EXECUTIVO
                </span>
            </div>
            <p class="text-xs text-slate-400 mt-1">
                Comercial: <strong class="text-slate-200">@Sessao.Nome (@Sessao.Cargo)</strong> &bull; Taxa de Comissão: <strong class="text-cobalt-400 font-mono">@Sessao.PercentagemComissao.ToString("N1")%</strong>
            </p>
        </div>
        
        <div class="flex items-center gap-3">
            <button @onclick="AbrirModalRelatorio" class="px-4 py-2.5 rounded-2xl bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-500 hover:to-indigo-500 text-white font-semibold text-xs shadow-glow-cobalt transform hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-2">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <span>Emitir Relatório Executivo</span>
            </button>
        </div>
    </div>

    <!-- 2. Dashboard Period Capsule Filter Bar -->
    <div class="glass-panel p-4 sm:p-5 rounded-3xl shadow-floating-card flex flex-wrap items-center justify-between gap-4 no-print">
        <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 mr-1">Período:</span>
            
            <div class="flex flex-wrap items-center bg-obsidian-950/80 p-1 rounded-2xl border border-white/10 text-xs">
                <button @onclick='() => SetFiltroPeriodo("mes")' class="px-3 py-1.5 rounded-xl transition-all font-medium @(filtroPeriodoDashboard == "mes" ? "bg-cobalt-600 text-white shadow-glow-cobalt" : "text-slate-400 hover:text-white")">
                    Este Mês
                </button>
                <button @onclick='() => SetFiltroPeriodo("hoje")' class="px-3 py-1.5 rounded-xl transition-all font-medium @(filtroPeriodoDashboard == "hoje" ? "bg-cobalt-600 text-white shadow-glow-cobalt" : "text-slate-400 hover:text-white")">
                    Hoje
                </button>
                <button @onclick='() => SetFiltroPeriodo("ano")' class="px-3 py-1.5 rounded-xl transition-all font-medium @(filtroPeriodoDashboard == "ano" ? "bg-cobalt-600 text-white shadow-glow-cobalt" : "text-slate-400 hover:text-white")">
                    Este Ano
                </button>
                <button @onclick='() => SetFiltroPeriodo("tudo")' class="px-3 py-1.5 rounded-xl transition-all font-medium @(filtroPeriodoDashboard == "tudo" ? "bg-cobalt-600 text-white shadow-glow-cobalt" : "text-slate-400 hover:text-white")">
                    Todo o Histórico
                </button>
                <button @onclick='() => SetFiltroPeriodo("calendario")' class="px-3 py-1.5 rounded-xl transition-all font-medium @(filtroPeriodoDashboard == "calendario" ? "bg-cobalt-600 text-white shadow-glow-cobalt" : "text-slate-400 hover:text-white")">
                    Calendário
                </button>
            </div>
        </div>

        @if (filtroPeriodoDashboard == "calendario")
        {
            <div class="flex items-center space-x-3 bg-obsidian-950/80 p-2 rounded-2xl border border-white/10">
                <div class="flex items-center space-x-2">
                    <span class="text-xs font-mono text-slate-400">De:</span>
                    <input type="date" @bind="dashboardDataInicio" class="glass-input rounded-xl px-2.5 py-1 text-xs text-slate-100 font-mono" />
                </div>
                <div class="flex items-center space-x-2">
                    <span class="text-xs font-mono text-slate-400">Até:</span>
                    <input type="date" @bind="dashboardDataFim" class="glass-input rounded-xl px-2.5 py-1 text-xs text-slate-100 font-mono" />
                </div>
                <button @onclick="CarregarDashboard" class="bg-cobalt-600 hover:bg-cobalt-500 text-white px-3 py-1 rounded-xl text-xs font-bold shadow-glow-cobalt transition-all">
                    Filtrar
                </button>
            </div>
        }

        <div class="text-xs font-mono text-slate-400 bg-white/5 px-3 py-1.5 rounded-xl border border-white/5">
            Dados de: <strong class="text-cobalt-400 font-semibold">@periodoDescricaoDashboard</strong>
        </div>
    </div>

    <!-- 3. Floating Futuristic KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 no-print">
        
        <!-- Metric 1: Faturado no Período -->
        <div class="group relative rounded-3xl glass-panel p-6 shadow-floating-card hover:border-cobalt-500/40 transition-all duration-300 overflow-hidden">
            <div class="absolute -right-8 -top-8 w-24 h-24 bg-cobalt-500/10 rounded-full blur-2xl group-hover:bg-cobalt-500/20 transition-all duration-500"></div>
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Faturado no Período</span>
                <span class="p-2 rounded-2xl bg-cobalt-500/10 text-cobalt-400 border border-cobalt-500/20">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2 mb-1">
                <h3 class="text-2xl lg:text-3xl font-extrabold font-mono text-white tracking-tight">€ @totalVendasMes.ToString("N2")</h3>
            </div>
            <p class="text-xs text-emerald-400 mb-4 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Vendas comerciais consolidadas
            </p>
            <div class="w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-cobalt-500 to-indigo-500 rounded-full shadow-[0_0_12px_rgba(59,130,246,0.5)]" style="width: 85%;"></div>
            </div>
        </div>
        
        <!-- Metric 2: Comissão a Receber -->
        <div class="group relative rounded-3xl glass-panel p-6 shadow-floating-card hover:border-cobalt-500/40 transition-all duration-300 overflow-hidden">
            <div class="absolute -right-8 -top-8 w-24 h-24 bg-cobalt-500/15 rounded-full blur-2xl group-hover:bg-cobalt-500/25 transition-all duration-500"></div>
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Comissão a Receber</span>
                <span class="p-2 rounded-2xl bg-cobalt-500/15 text-cobalt-300 border border-cobalt-500/30">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 9h6"/></svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2 mb-1">
                <h3 class="text-2xl lg:text-3xl font-extrabold font-mono text-cobalt-400 tracking-tight drop-shadow-[0_0_15px_rgba(59,130,246,0.3)]">
                    € @totalComissao.ToString("N2")
                </h3>
            </div>
            <p class="text-xs text-slate-400 mb-4">
                Taxa de <span class="text-cobalt-400 font-mono">@Sessao.PercentagemComissao.ToString("N1")%</span> sobre vendas
            </p>
            <div class="w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-blue-500 to-indigo-600 rounded-full shadow-[0_0_12px_rgba(59,130,246,0.5)]" style="width: 78%;"></div>
            </div>
        </div>

        <!-- Metric 3: Total de Clientes -->
        <div class="group relative rounded-3xl glass-panel p-6 shadow-floating-card hover:border-white/20 transition-all duration-300 overflow-hidden">
            <div class="absolute -right-8 -top-8 w-24 h-24 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all duration-500"></div>
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total de Clientes</span>
                <span class="p-2 rounded-2xl bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2 mb-1">
                <h3 class="text-2xl lg:text-3xl font-extrabold font-mono text-white tracking-tight">@totalClientes</h3>
            </div>
            <p class="text-xs text-slate-400 mb-4">Registados na base SQL Server</p>
            <div class="w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full" style="width: 90%;"></div>
            </div>
        </div>

        <!-- Metric 4: Encomendas no Período -->
        <div class="group relative rounded-3xl glass-panel p-6 shadow-floating-card hover:border-white/20 transition-all duration-300 overflow-hidden">
            <div class="absolute -right-8 -top-8 w-24 h-24 bg-amber-500/10 rounded-full blur-2xl group-hover:bg-amber-500/20 transition-all duration-500"></div>
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Encomendas no Período</span>
                <span class="p-2 rounded-2xl bg-amber-500/10 text-amber-300 border border-amber-500/20">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2 mb-1">
                <h3 class="text-2xl lg:text-3xl font-extrabold font-mono text-white tracking-tight">@totalEncomendasMes</h3>
            </div>
            <p class="text-xs text-amber-400 mb-4">Volume total de pedidos emitidos</p>
            <div class="w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded-full" style="width: 72%;"></div>
            </div>
        </div>
    </div>

    <!-- 4. Borderless Modern Data Table -->
    <div class="rounded-3xl glass-panel p-6 sm:p-7 shadow-floating-card no-print">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-white/10">
            <div>
                <h2 class="text-lg font-bold text-white tracking-tight">Histórico de Vendas & Comissões</h2>
                <p class="text-xs text-slate-400 mt-0.5">Intervalo ativo: <span class="text-cobalt-400 font-mono">@periodoDescricaoDashboard</span></p>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-mono font-medium bg-cobalt-500/10 text-cobalt-400 border border-cobalt-500/20 self-start sm:self-auto">
                @(vendasRecentes.Count) registo(s) sincronizados
            </span>
        </div>

        <div class="overflow-x-auto mt-4">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="text-[11px] font-mono uppercase tracking-wider text-slate-400 border-b border-white/5">
                        <th class="py-3.5 px-4 font-semibold">Nº Venda</th>
                        <th class="py-3.5 px-4 font-semibold">Data</th>
                        <th class="py-3.5 px-4 font-semibold">Cliente</th>
                        <th class="py-3.5 px-4 font-semibold text-center">Estado</th>
                        <th class="py-3.5 px-4 font-semibold text-right">Valor Total</th>
                        <th class="py-3.5 px-4 font-semibold text-right">Comissão (@Sessao.PercentagemComissao.ToString("N0")%)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/[0.03] text-sm">
                    @if (vendasRecentes.Count > 0)
                    {
                        @foreach (var v in vendasRecentes)
                        {
                            <tr class="group hover:bg-white/[0.04] transition-colors duration-200 cursor-pointer">
                                <td class="py-4 px-4 font-mono font-bold text-white group-hover:text-cobalt-400 transition-colors">
                                    #@v.NE
                                </td>
                                <td class="py-4 px-4 text-xs font-mono text-slate-400">
                                    @v.Data.ToString("dd/MM/yyyy")
                                </td>
                                <td class="py-4 px-4 font-semibold text-slate-100">
                                    @v.Cliente
                                </td>
                                <td class="py-4 px-4 text-center">
                                    @if (v.Estado == "FECHADA")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                            FECHADA
                                        </span>
                                    }
                                    else if (v.Estado == "CANCELADA")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-medium bg-rose-500/10 text-rose-400 border border-rose-500/20">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                                            CANCELADA
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                                            @v.Estado
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-4 text-right font-mono font-bold text-white text-base">
                                    € @v.ValorTotal.ToString("N2")
                                </td>
                                <td class="py-4 px-4 text-right font-mono font-bold text-emerald-400">
                                    + € @v.Comissao.ToString("N2")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-8 text-center text-slate-400 text-xs font-mono">
                                Sem registo de vendas para o período selecionado.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 5. Modal Novo Relatório Executivo -->
    @if (mostrarModalRelatorio)
    {
        <div class="fixed inset-0 bg-black/75 backdrop-blur-md z-50 flex items-center justify-center p-4">
            <div class="rounded-3xl glass-panel-glow max-w-4xl w-full p-7 max-h-[95vh] overflow-y-auto shadow-2xl border border-cobalt-500/30">
                <div class="flex justify-between items-center border-b border-white/10 pb-4 mb-6 no-print">
                    <div>
                        <h2 class="text-xl font-bold text-white tracking-tight">Gerar Relatório de Desempenho</h2>
                        <p class="text-xs text-slate-400 mt-0.5">Selecione o intervalo de tempo para pré-visualizar e imprimir o relatório executivo.</p>
                    </div>
                    <button @onclick="FecharModalRelatorio" class="p-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white transition-all text-xl leading-none">&times;</button>
                </div>

                <!-- Filtros do Relatório (no-print) -->
                <div class="bg-obsidian-950/70 p-4 rounded-2xl border border-white/10 mb-6 flex flex-wrap items-center justify-between gap-4 no-print">
                    <div class="flex items-center space-x-3">
                        <label class="block text-xs font-mono text-slate-400">Período:</label>
                        <select @bind="periodoSelecionado" @bind:after="OnMudarPeriodoRelatorio" class="glass-input rounded-xl px-3 py-1.5 text-xs text-slate-200 font-medium">
                            <option value="mes">Este Mês</option>
                            <option value="hoje">Hoje</option>
                            <option value="ano">Este Ano</option>
                            <option value="tudo">Todo o Histórico</option>
                            <option value="calendario">Escolher no Calendário (Datas)</option>
                        </select>
                    </div>

                    @if (periodoSelecionado == "calendario")
                    {
                        <div class="flex items-center space-x-3 bg-obsidian-900 p-2 rounded-xl border border-white/10">
                            <div class="flex items-center space-x-2">
                                <span class="text-xs text-slate-400">De:</span>
                                <input type="date" @bind="relatorioDataInicio" class="glass-input rounded-xl px-2.5 py-1 text-xs text-slate-200" />
                            </div>
                            <div class="flex items-center space-x-2">
                                <span class="text-xs text-slate-400">Até:</span>
                                <input type="date" @bind="relatorioDataFim" class="glass-input rounded-xl px-2.5 py-1 text-xs text-slate-200" />
                            </div>
                            <button @onclick="GerarRelatorio" class="bg-cobalt-600 hover:bg-cobalt-500 text-white px-3 py-1 rounded-xl text-xs font-bold shadow-glow-cobalt transition">
                                Filtrar Relatório
                            </button>
                        </div>
                    }

                    <div class="flex space-x-3">
                        <button @onclick="ImprimirRelatorio" class="px-4 py-2 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs shadow-glow-cobalt flex items-center gap-2 transition-all">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                            <span>Imprimir Relatório (PDF)</span>
                        </button>
                    </div>
                </div>

                <!-- Documento Formal do Relatório (Printable Area - high contrast for paper print) -->
                <div id="printableReport" class="p-6 border rounded-2xl border-gray-200 bg-white text-gray-900">
                    <!-- Cabeçalho Oficial -->
                    <div class="border-b-2 border-gray-800 pb-4 mb-6">
                        <div class="flex justify-between items-start">
                            <div>
                                <h1 class="text-2xl font-black text-gray-900 tracking-wide uppercase">RELATÓRIO FINANCEIRO & COMISSÕES</h1>
                                <p class="text-xs text-gray-500 mt-0.5">Gestão Comercial & Distribuição de Material Elétrico</p>
                            </div>
                            <div class="text-right">
                                <h2 class="text-lg font-bold text-[#3F6CD8]">AJLC Soluctions</h2>
                                <p class="text-xs text-gray-500">Data de Emissão: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>
                    </div>

                    <!-- Meta Informações -->
                    <div class="grid grid-cols-3 gap-4 p-3 bg-gray-50 rounded-lg text-xs mb-6 border">
                        <div>
                            <span class="text-gray-500">Comercial:</span>
                            <strong class="text-gray-900 ml-1">@Sessao.Nome (@Sessao.Cargo)</strong>
                        </div>
                        <div>
                            <span class="text-gray-500">Taxa de Comissão:</span>
                            <strong class="text-blue-600 ml-1">@Sessao.PercentagemComissao.ToString("N1")%</strong>
                        </div>
                        <div>
                            <span class="text-gray-500">Período:</span>
                            <strong class="text-gray-900 ml-1">@periodoDescricaoRelatorio</strong>
                        </div>
                    </div>

                    <!-- Cards Resumo no Relatório -->
                    <div class="grid grid-cols-4 gap-4 mb-6 text-center">
                        <div class="p-3 border rounded-lg bg-white">
                            <p class="text-[10px] uppercase font-bold text-gray-400">Total Faturado</p>
                            <p class="text-lg font-black text-gray-800 mt-1">€ @relatorioTotalFaturado.ToString("N2")</p>
                        </div>
                        <div class="p-3 border rounded-lg bg-white">
                            <p class="text-[10px] uppercase font-bold text-gray-400">Comissões Acumuladas</p>
                            <p class="text-lg font-black text-amber-600 mt-1">€ @relatorioTotalComissao.ToString("N2")</p>
                        </div>
                        <div class="p-3 border rounded-lg bg-white">
                            <p class="text-[10px] uppercase font-bold text-gray-400">Nº Encomendas</p>
                            <p class="text-lg font-black text-gray-800 mt-1">@relatorioTotalQtd</p>
                        </div>
                        <div class="p-3 border rounded-lg bg-white">
                            <p class="text-[10px] uppercase font-bold text-gray-400">Ticket Médio</p>
                            <p class="text-lg font-black text-blue-600 mt-1">€ @(relatorioTotalQtd > 0 ? (relatorioTotalFaturado / relatorioTotalQtd).ToString("N2") : "0.00")</p>
                        </div>
                    </div>

                    <!-- Tabela de Detalhe -->
                    <table class="w-full text-left border-collapse border border-gray-200 text-xs mb-6">
                        <thead class="bg-gray-100 font-bold text-gray-700">
                            <tr>
                                <th class="p-2 border-b">Nº</th>
                                <th class="p-2 border-b">Data</th>
                                <th class="p-2 border-b">Cliente</th>
                                <th class="p-2 border-b">Estado</th>
                                <th class="p-2 border-b text-right">Valor Total</th>
                                <th class="p-2 border-b text-right">Comissão</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            @if (relatorioLinhas.Count > 0)
                            {
                                @foreach (var r in relatorioLinhas)
                                {
                                    <tr>
                                        <td class="p-2 font-mono">#@r.NE</td>
                                        <td class="p-2">@r.Data.ToString("dd/MM/yyyy")</td>
                                        <td class="p-2 font-medium">@r.Cliente</td>
                                        <td class="p-2">@r.Estado</td>
                                        <td class="p-2 text-right font-semibold">€ @r.ValorTotal.ToString("N2")</td>
                                        <td class="p-2 text-right font-semibold text-amber-700">€ @r.Comissao.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="p-4 text-center text-gray-400">Nenhuma transação registada para este período.</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Rodapé Oficial do Relatório -->
                    <div class="mt-8 pt-6 border-t border-gray-200 flex justify-between text-xs text-gray-500">
                        <div>Documento emitido por computador • Sistema de Vendas AJLC Soluctions</div>
                        <div>Página 1 de 1</div>
                    </div>
                </div>

                <div class="mt-6 flex justify-end no-print">
                    <button @onclick="FecharModalRelatorio" class="px-5 py-2.5 rounded-2xl bg-white/5 hover:bg-white/10 text-slate-300 text-xs font-semibold transition">
                        Fechar
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Filtros Dashboard
    private string filtroPeriodoDashboard = "mes";
    private string periodoDescricaoDashboard = "Este Mês";
    private DateTime dashboardDataInicio = DateTime.Today.AddDays(-30);
    private DateTime dashboardDataFim = DateTime.Today;

    private decimal totalVendasMes = 0;
    private decimal totalComissao = 0;
    private int totalClientes = 0;
    private int totalEncomendasMes = 0;

    private List<VendaGanhosModel> vendasRecentes = new List<VendaGanhosModel>();

    // Modal Relatório
    private bool mostrarModalRelatorio = false;
    private string periodoSelecionado = "mes";
    private string periodoDescricaoRelatorio = "Este Mês";
    private DateTime relatorioDataInicio = DateTime.Today.AddDays(-30);
    private DateTime relatorioDataFim = DateTime.Today;
    private decimal relatorioTotalFaturado = 0;
    private decimal relatorioTotalComissao = 0;
    private int relatorioTotalQtd = 0;
    private List<VendaGanhosModel> relatorioLinhas = new List<VendaGanhosModel>();

    protected override void OnInitialized()
    {
        OnMudarPeriodoDashboard();
    }

    private void SetFiltroPeriodo(string periodo)
    {
        filtroPeriodoDashboard = periodo;
        OnMudarPeriodoDashboard();
    }

    private void OnMudarPeriodoDashboard()
    {
        DateTime hoje = DateTime.Today;
        if (filtroPeriodoDashboard == "hoje")
        {
            periodoDescricaoDashboard = "Hoje (" + hoje.ToString("dd/MM/yyyy") + ")";
        }
        else if (filtroPeriodoDashboard == "mes")
        {
            periodoDescricaoDashboard = "Este Mês (" + hoje.ToString("MMMM yyyy") + ")";
        }
        else if (filtroPeriodoDashboard == "ano")
        {
            periodoDescricaoDashboard = "Este Ano (" + hoje.Year + ")";
        }
        else if (filtroPeriodoDashboard == "calendario")
        {
            periodoDescricaoDashboard = $"{dashboardDataInicio:dd/MM/yyyy} até {dashboardDataFim:dd/MM/yyyy}";
        }
        else
        {
            periodoDescricaoDashboard = "Todo o Histórico";
        }
        CarregarDashboard();
    }

    private void CarregarDashboard()
    {
        totalVendasMes = 0;
        totalComissao = 0;
        totalEncomendasMes = 0;
        vendasRecentes.Clear();

        string filtroData = "";
        if (filtroPeriodoDashboard == "hoje")
        {
            filtroData = "AND CAST(E.Data_Encomenda AS DATE) = CAST(GETDATE() AS DATE)";
        }
        else if (filtroPeriodoDashboard == "mes")
        {
            filtroData = "AND MONTH(E.Data_Encomenda) = MONTH(GETDATE()) AND YEAR(E.Data_Encomenda) = YEAR(GETDATE())";
        }
        else if (filtroPeriodoDashboard == "ano")
        {
            filtroData = "AND YEAR(E.Data_Encomenda) = YEAR(GETDATE())";
        }
        else if (filtroPeriodoDashboard == "calendario")
        {
            filtroData = "AND CAST(E.Data_Encomenda AS DATE) BETWEEN @dI AND @dF";
            periodoDescricaoDashboard = $"{dashboardDataInicio:dd/MM/yyyy} até {dashboardDataFim:dd/MM/yyyy}";
        }

        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                
                int isDiretor = (Sessao.Cargo == "Diretor Comercial" || Sessao.Cargo == "Administrador" || Sessao.ID_Vendedor == 1) ? 1 : 0;

                // 1. Vendas e Comissões do Período (Excluindo Encomendas Canceladas)
                string queryVendas = $@"
                    SELECT SUM(E.Valor_Total) as Total_Vendas, COUNT(E.Numero_Encomenda) as Num_Vendas
                    FROM Encomenda E
                    WHERE (E.ID_Vendedor = @id OR @isDiretor = 1) 
                      AND ISNULL(E.Estado, '') <> 'CANCELADA' {filtroData}";

                using (SqlCommand cmd = new SqlCommand(queryVendas, con))
                {
                    cmd.Parameters.AddWithValue("@id", Sessao.ID_Vendedor);
                    cmd.Parameters.AddWithValue("@isDiretor", isDiretor);
                    if (filtroPeriodoDashboard == "calendario")
                    {
                        cmd.Parameters.AddWithValue("@dI", dashboardDataInicio.Date);
                        cmd.Parameters.AddWithValue("@dF", dashboardDataFim.Date);
                    }

                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        if (rd.Read())
                        {
                            totalVendasMes = rd["Total_Vendas"] != DBNull.Value ? Convert.ToDecimal(rd["Total_Vendas"]) : 0;
                            totalEncomendasMes = rd["Num_Vendas"] != DBNull.Value ? Convert.ToInt32(rd["Num_Vendas"]) : 0;
                            totalComissao = totalVendasMes * (Sessao.PercentagemComissao / 100m);
                        }
                    }
                }

                // 2. Total de Clientes
                string queryClientes = "SELECT COUNT(*) FROM Clientes";
                using (SqlCommand cmd = new SqlCommand(queryClientes, con))
                {
                    object? result = cmd.ExecuteScalar();
                    if (result != null && result != DBNull.Value)
                    {
                        totalClientes = Convert.ToInt32(result);
                    }
                }

                // 3. Vendas Recentes do Período
                string queryGrid = $@"
                    SELECT TOP 50 
                        E.Numero_Encomenda,
                        E.Data_Encomenda,
                        ISNULL(C.Nome_Cliente, 'Cliente Não Identificado') AS Nome_Cliente,
                        ISNULL(E.Estado, 'Pendente') AS Estado,
                        ISNULL(E.Valor_Total, 0) AS Valor_Total
                    FROM Encomenda E
                    LEFT JOIN Clientes C ON E.ID_Cliente = C.ID_Cliente
                    WHERE (E.ID_Vendedor = @id OR @isDiretor = 1) {filtroData}
                    ORDER BY E.Data_Encomenda DESC, E.Numero_Encomenda DESC";

                decimal taxaComissao = Sessao.PercentagemComissao / 100m;
                using (SqlCommand cmdG = new SqlCommand(queryGrid, con))
                {
                    cmdG.Parameters.AddWithValue("@id", Sessao.ID_Vendedor);
                    cmdG.Parameters.AddWithValue("@isDiretor", isDiretor);
                    if (filtroPeriodoDashboard == "calendario")
                    {
                        cmdG.Parameters.AddWithValue("@dI", dashboardDataInicio.Date);
                        cmdG.Parameters.AddWithValue("@dF", dashboardDataFim.Date);
                    }

                    using (SqlDataReader rdG = cmdG.ExecuteReader())
                    {
                        while (rdG.Read())
                        {
                            decimal val = Convert.ToDecimal(rdG["Valor_Total"]);
                            string estado = rdG["Estado"]?.ToString() ?? "Pendente";
                            decimal com = estado == "CANCELADA" ? 0m : val * taxaComissao;

                            vendasRecentes.Add(new VendaGanhosModel
                            {
                                NE = Convert.ToInt32(rdG["Numero_Encomenda"]),
                                Data = rdG["Data_Encomenda"] != DBNull.Value ? Convert.ToDateTime(rdG["Data_Encomenda"]) : DateTime.MinValue,
                                Cliente = rdG["Nome_Cliente"]?.ToString() ?? "N/A",
                                Estado = estado,
                                ValorTotal = val,
                                Comissao = com
                            });
                        }
                    }
                }
            }
            catch { }
        }
    }

    private void AbrirModalRelatorio()
    {
        mostrarModalRelatorio = true;
        OnMudarPeriodoRelatorio();
    }

    private void FecharModalRelatorio()
    {
        mostrarModalRelatorio = false;
    }

    private void OnMudarPeriodoRelatorio()
    {
        DateTime hoje = DateTime.Today;
        if (periodoSelecionado == "hoje")
        {
            periodoDescricaoRelatorio = "Hoje (" + hoje.ToString("dd/MM/yyyy") + ")";
        }
        else if (periodoSelecionado == "mes")
        {
            periodoDescricaoRelatorio = "Este Mês (" + hoje.ToString("MMMM yyyy") + ")";
        }
        else if (periodoSelecionado == "ano")
        {
            periodoDescricaoRelatorio = "Este Ano (" + hoje.Year + ")";
        }
        else if (periodoSelecionado == "calendario")
        {
            periodoDescricaoRelatorio = $"{relatorioDataInicio:dd/MM/yyyy} até {relatorioDataFim:dd/MM/yyyy}";
        }
        else
        {
            periodoDescricaoRelatorio = "Todo o Histórico";
        }
        GerarRelatorio();
    }

    private void GerarRelatorio()
    {
        relatorioLinhas.Clear();
        relatorioTotalFaturado = 0;
        relatorioTotalComissao = 0;
        relatorioTotalQtd = 0;

        string filtroData = "";

        if (periodoSelecionado == "hoje")
        {
            filtroData = "AND CAST(E.Data_Encomenda AS DATE) = CAST(GETDATE() AS DATE)";
        }
        else if (periodoSelecionado == "mes")
        {
            filtroData = "AND MONTH(E.Data_Encomenda) = MONTH(GETDATE()) AND YEAR(E.Data_Encomenda) = YEAR(GETDATE())";
        }
        else if (periodoSelecionado == "ano")
        {
            filtroData = "AND YEAR(E.Data_Encomenda) = YEAR(GETDATE())";
        }
        else if (periodoSelecionado == "calendario")
        {
            filtroData = "AND CAST(E.Data_Encomenda AS DATE) BETWEEN @rdI AND @rdF";
            periodoDescricaoRelatorio = $"{relatorioDataInicio:dd/MM/yyyy} até {relatorioDataFim:dd/MM/yyyy}";
        }
        else
        {
            filtroData = "";
        }

        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                int isDiretor = (Sessao.Cargo == "Diretor Comercial" || Sessao.Cargo == "Administrador" || Sessao.ID_Vendedor == 1) ? 1 : 0;
                string query = $@"
                    SELECT 
                        E.Numero_Encomenda,
                        E.Data_Encomenda,
                        ISNULL(C.Nome_Cliente, 'Cliente Não Identificado') AS Nome_Cliente,
                        ISNULL(E.Estado, 'Pendente') AS Estado,
                        ISNULL(E.Valor_Total, 0) AS Valor_Total
                    FROM Encomenda E
                    LEFT JOIN Clientes C ON E.ID_Cliente = C.ID_Cliente
                    WHERE (E.ID_Vendedor = @id OR @isDiretor = 1) {filtroData}
                    ORDER BY E.Data_Encomenda DESC, E.Numero_Encomenda DESC";

                decimal taxaComissao = Sessao.PercentagemComissao / 100m;
                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@id", Sessao.ID_Vendedor);
                    cmd.Parameters.AddWithValue("@isDiretor", isDiretor);
                    if (periodoSelecionado == "calendario")
                    {
                        cmd.Parameters.AddWithValue("@rdI", relatorioDataInicio.Date);
                        cmd.Parameters.AddWithValue("@rdF", relatorioDataFim.Date);
                    }

                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        while (rd.Read())
                        {
                            decimal val = Convert.ToDecimal(rd["Valor_Total"]);
                            string estado = rd["Estado"]?.ToString() ?? "Pendente";
                            decimal com = estado == "CANCELADA" ? 0m : val * taxaComissao;

                            if (estado != "CANCELADA")
                            {
                                relatorioTotalFaturado += val;
                                relatorioTotalComissao += com;
                                relatorioTotalQtd++;
                            }

                            relatorioLinhas.Add(new VendaGanhosModel
                            {
                                NE = Convert.ToInt32(rd["Numero_Encomenda"]),
                                Data = rd["Data_Encomenda"] != DBNull.Value ? Convert.ToDateTime(rd["Data_Encomenda"]) : DateTime.MinValue,
                                Cliente = rd["Nome_Cliente"]?.ToString() ?? "N/A",
                                Estado = estado,
                                ValorTotal = val,
                                Comissao = com
                            });
                        }
                    }
                }
            }
            catch { }
        }
    }

    private async Task ImprimirRelatorio()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    public class VendaGanhosModel
    {
        public int NE { get; set; }
        public DateTime Data { get; set; }
        public string Cliente { get; set; } = "";
        public string Estado { get; set; } = "";
        public decimal ValorTotal { get; set; }
        public decimal Comissao { get; set; }
    }
}
