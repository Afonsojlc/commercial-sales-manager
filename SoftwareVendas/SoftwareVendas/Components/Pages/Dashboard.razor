@page "/dashboard"
@using Microsoft.Data.SqlClient
@using SoftwareVendas
@using System.Data
@inject IJSRuntime JS

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        #printableReport, #printableReport * {
            visibility: visible;
        }
        #printableReport {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            padding: 24px;
            margin: 0;
            background: white !important;
        }
        .no-print {
            display: none !important;
        }
    }
</style>

<div class="p-8 h-full overflow-auto">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8 no-print">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">Dashboard & Relatórios</h1>
            <p class="text-xs text-gray-500 mt-1">
                Comercial: <strong class="text-gray-700">@Sessao.Nome (@Sessao.Cargo)</strong> &bull; Taxa de Comissão: <strong class="text-blue-600">@Sessao.PercentagemComissao.ToString("N1")%</strong>
            </p>
        </div>
        <div class="flex space-x-3">
            <button @onclick="AbrirModalRelatorio" class="bg-[#3F6CD8] hover:bg-blue-700 text-white font-medium px-4 py-2 rounded shadow transition flex items-center text-sm">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                Novo Relatório
            </button>
        </div>
    </div>

    <!-- Metrics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8 no-print">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between">
            <div>
                <p class="text-gray-500 text-xs font-bold uppercase tracking-wider">Faturado (Este Mês)</p>
                <h3 class="text-2xl font-black text-gray-800 mt-1">€ @totalVendasMes.ToString("N2")</h3>
                <span class="text-xs text-green-600 font-medium mt-1 inline-block">Vendas consolidadas</span>
            </div>
            <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-[#3F6CD8]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
        </div>
        
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between">
            <div>
                <p class="text-gray-500 text-xs font-bold uppercase tracking-wider">Comissão a Receber</p>
                <h3 class="text-2xl font-black text-amber-600 mt-1">€ @totalComissao.ToString("N2")</h3>
                <span class="text-xs text-gray-400 font-medium mt-1 inline-block">@Sessao.PercentagemComissao.ToString("N1")% sobre vendas</span>
            </div>
            <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center text-amber-500">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between">
            <div>
                <p class="text-gray-500 text-xs font-bold uppercase tracking-wider">Total de Clientes</p>
                <h3 class="text-2xl font-black text-gray-800 mt-1">@totalClientes</h3>
                <span class="text-xs text-blue-600 font-medium mt-1 inline-block">Registados na base de dados</span>
            </div>
            <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center text-green-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between">
            <div>
                <p class="text-gray-500 text-xs font-bold uppercase tracking-wider">Encomendas (Mês)</p>
                <h3 class="text-2xl font-black text-gray-800 mt-1">@totalEncomendasMes</h3>
                <span class="text-xs text-gray-400 font-medium mt-1 inline-block">Volume de pedidos</span>
            </div>
            <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center text-purple-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
            </div>
        </div>
    </div>

    <!-- Tabela de Vendas Recentes e Desempenho (Equivalente ao FormGanhos) -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden no-print">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-[#2B3347] text-white">
            <h2 class="font-bold text-base">Histórico Recente de Vendas & Comissões</h2>
            <span class="text-xs bg-white/10 px-3 py-1 rounded-full">Atualizado em tempo real</span>
        </div>
        <div class="overflow-auto max-h-96">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 text-xs font-bold text-gray-500 uppercase tracking-wider sticky top-0 border-b">
                    <tr>
                        <th class="px-6 py-3">Nº Venda</th>
                        <th class="px-6 py-3">Data</th>
                        <th class="px-6 py-3">Cliente</th>
                        <th class="px-6 py-3">Estado</th>
                        <th class="px-6 py-3 text-right">Valor Total</th>
                        <th class="px-6 py-3 text-right">Comissão (@Sessao.PercentagemComissao.ToString("N0")%)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    @if (vendasRecentes.Count > 0)
                    {
                        @foreach (var v in vendasRecentes)
                        {
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-6 py-3 font-semibold text-gray-900">#@v.NE</td>
                                <td class="px-6 py-3 text-gray-600">@v.Data.ToString("dd/MM/yyyy")</td>
                                <td class="px-6 py-3 font-medium text-gray-800">@v.Cliente</td>
                                <td class="px-6 py-3">
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold @(v.Estado == "FECHADA" ? "bg-green-100 text-green-800" : (v.Estado == "CANCELADA" ? "bg-red-100 text-red-800" : "bg-yellow-100 text-yellow-800"))">
                                        @v.Estado
                                    </span>
                                </td>
                                <td class="px-6 py-3 text-right font-bold text-gray-900">€ @v.ValorTotal.ToString("N2")</td>
                                <td class="px-6 py-3 text-right font-bold text-amber-600">€ @v.Comissao.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-gray-400">Sem registo de vendas para o utilizador atual.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Novo Relatório -->
    @if (mostrarModalRelatorio)
    {
        <div class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-2xl shadow-2xl max-w-4xl w-full p-6 max-h-[95vh] overflow-y-auto">
                <div class="flex justify-between items-center border-b pb-4 mb-6 no-print">
                    <div>
                        <h2 class="text-2xl font-bold text-[#2B3347]">Gerar Relatório de Desempenho</h2>
                        <p class="text-xs text-gray-500">Selecione o intervalo de tempo para pré-visualizar e imprimir o relatório executivo.</p>
                    </div>
                    <button @onclick="FecharModalRelatorio" class="text-gray-400 hover:text-gray-600 text-3xl font-light">&times;</button>
                </div>

                <!-- Filtros do Relatório (no-print) -->
                <div class="bg-gray-50 p-4 rounded-xl border border-gray-200 mb-6 flex flex-wrap items-center gap-4 no-print">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Período</label>
                        <select @bind="periodoSelecionado" @bind:after="GerarRelatorio" class="border border-gray-300 rounded px-3 py-1.5 text-sm bg-white focus:ring-blue-500">
                            <option value="mes">Este Mês</option>
                            <option value="hoje">Hoje</option>
                            <option value="ano">Este Ano</option>
                            <option value="tudo">Todo o Histórico</option>
                        </select>
                    </div>

                    <div class="flex-1 flex justify-end space-x-3">
                        <button @onclick="ImprimirRelatorio" class="bg-[#3F6CD8] hover:bg-blue-700 text-white font-medium px-4 py-2 rounded shadow transition flex items-center text-sm">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                            Imprimir Relatório
                        </button>
                    </div>
                </div>

                <!-- Documento Formal do Relatório (Printable Area) -->
                <div id="printableReport" class="p-4 border rounded-xl border-gray-200 bg-white">
                    <!-- Cabeçalho Oficial -->
                    <div class="border-b-2 border-gray-800 pb-4 mb-6">
                        <div class="flex justify-between items-start">
                            <div>
                                <h1 class="text-2xl font-black text-gray-900 tracking-wide uppercase">RELATÓRIO FINANCEIRO & COMISSÕES</h1>
                                <p class="text-xs text-gray-500 mt-0.5">Gestão Comercial & Distribuição de Material Elétrico</p>
                            </div>
                            <div class="text-right">
                                <h2 class="text-lg font-bold text-[#3F6CD8]">AJLC Soluctions</h2>
                                <p class="text-xs text-gray-500">Data de Emissão: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>
                    </div>

                    <!-- Meta Informações -->
                    <div class="grid grid-cols-3 gap-4 p-3 bg-gray-50 rounded-lg text-xs mb-6 border">
                        <div>
                            <span class="text-gray-500">Comercial:</span>
                            <strong class="text-gray-900 ml-1">@Sessao.Nome (@Sessao.Cargo)</strong>
                        </div>
                        <div>
                            <span class="text-gray-500">Taxa de Comissão:</span>
                            <strong class="text-blue-600 ml-1">@Sessao.PercentagemComissao.ToString("N1")%</strong>
                        </div>
                        <div>
                            <span class="text-gray-500">Período:</span>
                            <strong class="text-gray-900 ml-1 capitalize">@periodoDescricao</strong>
                        </div>
                    </div>

                    <!-- Cards Resumo no Relatório -->
                    <div class="grid grid-cols-4 gap-4 mb-6 text-center">
                        <div class="p-3 border rounded-lg bg-white">
                            <p class="text-[10px] uppercase font-bold text-gray-400">Total Faturado</p>
                            <p class="text-lg font-black text-gray-800 mt-1">€ @relatorioTotalFaturado.ToString("N2")</p>
                        </div>
                        <div class="p-3 border rounded-lg bg-white">
                            <p class="text-[10px] uppercase font-bold text-gray-400">Comissões Acumuladas</p>
                            <p class="text-lg font-black text-amber-600 mt-1">€ @relatorioTotalComissao.ToString("N2")</p>
                        </div>
                        <div class="p-3 border rounded-lg bg-white">
                            <p class="text-[10px] uppercase font-bold text-gray-400">Nº Encomendas</p>
                            <p class="text-lg font-black text-gray-800 mt-1">@relatorioTotalQtd</p>
                        </div>
                        <div class="p-3 border rounded-lg bg-white">
                            <p class="text-[10px] uppercase font-bold text-gray-400">Ticket Médio</p>
                            <p class="text-lg font-black text-blue-600 mt-1">€ @(relatorioTotalQtd > 0 ? (relatorioTotalFaturado / relatorioTotalQtd).ToString("N2") : "0.00")</p>
                        </div>
                    </div>

                    <!-- Tabela de Detalhe -->
                    <table class="w-full text-left border-collapse border border-gray-200 text-xs mb-6">
                        <thead class="bg-gray-100 font-bold text-gray-700">
                            <tr>
                                <th class="p-2 border-b">Nº</th>
                                <th class="p-2 border-b">Data</th>
                                <th class="p-2 border-b">Cliente</th>
                                <th class="p-2 border-b">Estado</th>
                                <th class="p-2 border-b text-right">Valor Total</th>
                                <th class="p-2 border-b text-right">Comissão</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            @if (relatorioLinhas.Count > 0)
                            {
                                @foreach (var r in relatorioLinhas)
                                {
                                    <tr>
                                        <td class="p-2 font-mono">#@r.NE</td>
                                        <td class="p-2">@r.Data.ToString("dd/MM/yyyy")</td>
                                        <td class="p-2 font-medium">@r.Cliente</td>
                                        <td class="p-2">@r.Estado</td>
                                        <td class="p-2 text-right font-semibold">€ @r.ValorTotal.ToString("N2")</td>
                                        <td class="p-2 text-right font-semibold text-amber-700">€ @r.Comissao.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="p-4 text-center text-gray-400">Nenhuma transação registada para este período.</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Rodapé Oficial do Relatório -->
                    <div class="mt-8 pt-6 border-t border-gray-200 flex justify-between text-xs text-gray-500">
                        <div>Documento emitido por computador • Sistema de Vendas AJLC Soluctions</div>
                        <div>Página 1 de 1</div>
                    </div>
                </div>

                <div class="mt-6 flex justify-end no-print">
                    <button @onclick="FecharModalRelatorio" class="px-5 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-100 font-medium text-sm transition">
                        Fechar
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private decimal totalVendasMes = 0;
    private decimal totalComissao = 0;
    private int totalClientes = 0;
    private int totalEncomendasMes = 0;

    private List<VendaGanhosModel> vendasRecentes = new List<VendaGanhosModel>();

    // Modal Relatório
    private bool mostrarModalRelatorio = false;
    private string periodoSelecionado = "mes";
    private string periodoDescricao = "Este Mês";
    private decimal relatorioTotalFaturado = 0;
    private decimal relatorioTotalComissao = 0;
    private int relatorioTotalQtd = 0;
    private List<VendaGanhosModel> relatorioLinhas = new List<VendaGanhosModel>();

    protected override void OnInitialized()
    {
        CarregarDashboard();
    }

    private void CarregarDashboard()
    {
        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                
                // 1. Vendas e Comissões do Mês
                string queryVendas = @"
                    SELECT SUM(E.Valor_Total) as Total_Vendas, COUNT(E.Numero_Encomenda) as Num_Vendas
                    FROM Encomenda E
                    WHERE MONTH(E.Data_Encomenda) = MONTH(GETDATE()) 
                      AND YEAR(E.Data_Encomenda) = YEAR(GETDATE())
                      AND (E.ID_Vendedor = @id OR @id = 1)";

                using (SqlCommand cmd = new SqlCommand(queryVendas, con))
                {
                    cmd.Parameters.AddWithValue("@id", Sessao.ID_Vendedor);
                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        if (rd.Read())
                        {
                            totalVendasMes = rd["Total_Vendas"] != DBNull.Value ? Convert.ToDecimal(rd["Total_Vendas"]) : 0;
                            totalEncomendasMes = rd["Num_Vendas"] != DBNull.Value ? Convert.ToInt32(rd["Num_Vendas"]) : 0;
                            totalComissao = totalVendasMes * (Sessao.PercentagemComissao / 100m);
                        }
                    }
                }

                // 2. Total de Clientes
                string queryClientes = "SELECT COUNT(*) FROM Clientes";
                using (SqlCommand cmd = new SqlCommand(queryClientes, con))
                {
                    object? result = cmd.ExecuteScalar();
                    if (result != null && result != DBNull.Value)
                    {
                        totalClientes = Convert.ToInt32(result);
                    }
                }

                // 3. Vendas Recentes (Equivalente ao FormGanhos)
                vendasRecentes.Clear();
                string queryGrid = @"
                    SELECT TOP 20 
                        E.Numero_Encomenda,
                        E.Data_Encomenda,
                        ISNULL(C.Nome_Cliente, 'Cliente Não Identificado') AS Nome_Cliente,
                        ISNULL(E.Estado, 'Pendente') AS Estado,
                        ISNULL(E.Valor_Total, 0) AS Valor_Total
                    FROM Encomenda E
                    LEFT JOIN Clientes C ON E.ID_Cliente = C.ID_Cliente
                    WHERE (E.ID_Vendedor = @id OR @id = 1)
                    ORDER BY E.Data_Encomenda DESC, E.Numero_Encomenda DESC";

                decimal taxaComissao = Sessao.PercentagemComissao / 100m;
                using (SqlCommand cmdG = new SqlCommand(queryGrid, con))
                {
                    cmdG.Parameters.AddWithValue("@id", Sessao.ID_Vendedor);
                    using (SqlDataReader rdG = cmdG.ExecuteReader())
                    {
                        while (rdG.Read())
                        {
                            decimal val = Convert.ToDecimal(rdG["Valor_Total"]);
                            vendasRecentes.Add(new VendaGanhosModel
                            {
                                NE = Convert.ToInt32(rdG["Numero_Encomenda"]),
                                Data = rdG["Data_Encomenda"] != DBNull.Value ? Convert.ToDateTime(rdG["Data_Encomenda"]) : DateTime.MinValue,
                                Cliente = rdG["Nome_Cliente"]?.ToString() ?? "N/A",
                                Estado = rdG["Estado"]?.ToString() ?? "Pendente",
                                ValorTotal = val,
                                Comissao = val * taxaComissao
                            });
                        }
                    }
                }
            }
            catch { }
        }
    }

    private void AbrirModalRelatorio()
    {
        mostrarModalRelatorio = true;
        GerarRelatorio();
    }

    private void FecharModalRelatorio()
    {
        mostrarModalRelatorio = false;
    }

    private void GerarRelatorio()
    {
        relatorioLinhas.Clear();
        relatorioTotalFaturado = 0;
        relatorioTotalComissao = 0;
        relatorioTotalQtd = 0;

        string filtroData = "";
        DateTime hoje = DateTime.Today;

        if (periodoSelecionado == "hoje")
        {
            filtroData = "AND CAST(E.Data_Encomenda AS DATE) = CAST(GETDATE() AS DATE)";
            periodoDescricao = "Hoje (" + hoje.ToString("dd/MM/yyyy") + ")";
        }
        else if (periodoSelecionado == "mes")
        {
            filtroData = "AND MONTH(E.Data_Encomenda) = MONTH(GETDATE()) AND YEAR(E.Data_Encomenda) = YEAR(GETDATE())";
            periodoDescricao = "Este Mês (" + hoje.ToString("MMMM yyyy") + ")";
        }
        else if (periodoSelecionado == "ano")
        {
            filtroData = "AND YEAR(E.Data_Encomenda) = YEAR(GETDATE())";
            periodoDescricao = "Este Ano (" + hoje.Year + ")";
        }
        else
        {
            filtroData = "";
            periodoDescricao = "Todo o Histórico";
        }

        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = $@"
                    SELECT 
                        E.Numero_Encomenda,
                        E.Data_Encomenda,
                        ISNULL(C.Nome_Cliente, 'Cliente Não Identificado') AS Nome_Cliente,
                        ISNULL(E.Estado, 'Pendente') AS Estado,
                        ISNULL(E.Valor_Total, 0) AS Valor_Total
                    FROM Encomenda E
                    LEFT JOIN Clientes C ON E.ID_Cliente = C.ID_Cliente
                    WHERE (E.ID_Vendedor = @id OR @id = 1) {filtroData}
                    ORDER BY E.Data_Encomenda DESC, E.Numero_Encomenda DESC";

                decimal taxaComissao = Sessao.PercentagemComissao / 100m;
                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@id", Sessao.ID_Vendedor);
                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        while (rd.Read())
                        {
                            decimal val = Convert.ToDecimal(rd["Valor_Total"]);
                            decimal com = val * taxaComissao;

                            relatorioTotalFaturado += val;
                            relatorioTotalComissao += com;
                            relatorioTotalQtd++;

                            relatorioLinhas.Add(new VendaGanhosModel
                            {
                                NE = Convert.ToInt32(rd["Numero_Encomenda"]),
                                Data = rd["Data_Encomenda"] != DBNull.Value ? Convert.ToDateTime(rd["Data_Encomenda"]) : DateTime.MinValue,
                                Cliente = rd["Nome_Cliente"]?.ToString() ?? "N/A",
                                Estado = rd["Estado"]?.ToString() ?? "Pendente",
                                ValorTotal = val,
                                Comissao = com
                            });
                        }
                    }
                }
            }
            catch { }
        }
    }

    private async Task ImprimirRelatorio()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    public class VendaGanhosModel
    {
        public int NE { get; set; }
        public DateTime Data { get; set; }
        public string Cliente { get; set; } = "";
        public string Estado { get; set; } = "";
        public decimal ValorTotal { get; set; }
        public decimal Comissao { get; set; }
    }
}
