@page "/definicoes"
@using System.Data.SqlClient
@using SoftwareVendas
@inject NavigationManager NavManager

<div class="p-6 sm:p-8 space-y-6 max-w-[1720px] mx-auto w-full min-h-full bg-slate-50">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900">Definições do Sistema</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                    Parametrizações
                </span>
            </div>
            <p class="text-xs text-slate-500 mt-1">
                Configurações da empresa para notas de encomenda, ligação à base de dados SQL Server e perfil em sessão.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemEmpresa))
    {
        <div class="p-4 rounded-xl text-xs font-semibold border flex items-center gap-2 bg-emerald-50 text-emerald-700 border-emerald-200">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>@mensagemEmpresa</span>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Bloco 1: Dados da Empresa para Faturas / Encomendas (Span 2 cols on lg) -->
        <div class="lg:col-span-2 bg-white rounded-2xl p-6 sm:p-7 shadow-sm border border-slate-200">
            <div class="flex justify-between items-center border-b border-slate-200 pb-3 mb-5">
                <div>
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                        Dados da Empresa (Notas de Encomenda & Impressão)
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">Estes dados aparecem no cabeçalho das notas de encomenda oficiais e relatórios PDF.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Nome Comercial da Empresa</label>
                    <input type="text" @bind="empresaNome" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-slate-900 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white" />
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">NIF / Número de Contribuinte</label>
                    <input type="text" @bind="empresaNif" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-slate-900 font-mono font-bold focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white" />
                </div>
                <div class="sm:col-span-2">
                    <label class="block font-bold text-slate-700 mb-1">Subtítulo / Ramo Comercial</label>
                    <input type="text" @bind="empresaSubtitulo" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white" />
                </div>
                <div class="sm:col-span-2">
                    <label class="block font-bold text-slate-700 mb-1">Morada da Sede / Armazém</label>
                    <input type="text" @bind="empresaMorada" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white" />
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Código Postal & Localidade</label>
                    <input type="text" @bind="empresaCodigoPostal" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-slate-900 font-mono focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white" />
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Telefone Principal</label>
                    <input type="text" @bind="empresaTelefone" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-slate-900 font-mono focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white" />
                </div>
                <div class="sm:col-span-2">
                    <label class="block font-bold text-slate-700 mb-1">Email Geral / Facturação</label>
                    <input type="email" @bind="empresaEmail" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white" />
                </div>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-200 flex justify-end">
                <button @onclick="GuardarDadosEmpresa" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold text-xs shadow-sm transition flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>Guardar Dados da Empresa</span>
                </button>
            </div>
        </div>

        <div class="space-y-6">
            <!-- Bloco 2: Sessão Comercial Ativa -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider border-b border-slate-200 pb-3 mb-4 flex items-center gap-2">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    Perfil em Sessão
                </h2>
                <div class="space-y-3 text-xs">
                    <div class="flex items-center gap-3.5 bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                        <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center font-black text-white text-base shadow-sm">
                            @(string.IsNullOrEmpty(Sessao.Nome) ? "C" : Sessao.Nome.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <p class="font-bold text-slate-900 text-sm">@Sessao.Nome</p>
                            <p class="text-xs text-slate-500 font-medium">@Sessao.Cargo &bull; ID: #@Sessao.ID_Vendedor</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 pt-1">
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                            <p class="uppercase font-bold text-[10px] text-slate-400">Cargo</p>
                            <p class="font-bold text-slate-800 mt-0.5">@Sessao.Cargo</p>
                        </div>
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                            <p class="uppercase font-bold text-[10px] text-slate-400">Comissão</p>
                            <p class="font-mono font-bold text-emerald-600 text-base mt-0.5">@Sessao.PercentagemComissao.ToString("N2")%</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bloco 3: Base de Dados SQL Server -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider border-b border-slate-200 pb-3 mb-4 flex items-center gap-2">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
                    Conexão SQL Server
                </h2>
                <div class="space-y-3">
                    <div>
                        <label class="block text-[11px] uppercase font-bold text-slate-500 mb-1.5">Connection String (ADO.NET)</label>
                        <textarea @bind="connString" rows="3" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-slate-800 font-mono text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white"></textarea>
                    </div>
                    
                    @if(!string.IsNullOrEmpty(mensagem))
                    {
                        <div class="p-3 rounded-xl text-xs font-semibold border flex items-center gap-2 @(sucesso ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-rose-50 text-rose-700 border-rose-200")">
                            @if (sucesso)
                            {
                                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            }
                            else
                            {
                                <svg class="w-4 h-4 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            }
                            <span>@mensagem</span>
                        </div>
                    }

                    <div class="flex justify-end gap-2 pt-1">
                        <button @onclick="TestarConexao" class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">
                            Testar
                        </button>
                        <button @onclick="GuardarConexao" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs shadow-sm transition">
                            Guardar Conexão
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private string connString = "";
    private string mensagem = "";
    private bool sucesso = false;

    // Campos da Empresa
    private string empresaNome = "";
    private string empresaSubtitulo = "";
    private string empresaNif = "";
    private string empresaMorada = "";
    private string empresaCodigoPostal = "";
    private string empresaTelefone = "";
    private string empresaEmail = "";
    private string mensagemEmpresa = "";

    protected override void OnInitialized()
    {
        connString = DatabaseConfig.ConnectionString;

        // Carregar valores de ConfiguracaoEmpresa
        empresaNome = ConfiguracaoEmpresa.NomeEmpresa;
        empresaSubtitulo = ConfiguracaoEmpresa.Subtitulo;
        empresaNif = ConfiguracaoEmpresa.NIF;
        empresaMorada = ConfiguracaoEmpresa.Morada;
        empresaCodigoPostal = ConfiguracaoEmpresa.CodigoPostal;
        empresaTelefone = ConfiguracaoEmpresa.Telefone;
        empresaEmail = ConfiguracaoEmpresa.Email;
    }

    private void GuardarDadosEmpresa()
    {
        ConfiguracaoEmpresa.NomeEmpresa = empresaNome.Trim();
        ConfiguracaoEmpresa.Subtitulo = empresaSubtitulo.Trim();
        ConfiguracaoEmpresa.NIF = empresaNif.Trim();
        ConfiguracaoEmpresa.Morada = empresaMorada.Trim();
        ConfiguracaoEmpresa.CodigoPostal = empresaCodigoPostal.Trim();
        ConfiguracaoEmpresa.Telefone = empresaTelefone.Trim();
        ConfiguracaoEmpresa.Email = empresaEmail.Trim();

        ConfiguracaoEmpresa.Guardar();
        mensagemEmpresa = "Dados da empresa gravados e atualizados em todas as notas de encomenda!";
    }

    private void TestarConexao()
    {
        string stringOriginal = DatabaseConfig.ConnectionString;
        DatabaseConfig.ConnectionString = connString.Trim();

        if (DatabaseConfig.TestarConexao(out string erro))
        {
            sucesso = true;
            mensagem = "Conexão estabelecida com sucesso!";
        }
        else
        {
            sucesso = false;
            mensagem = "Falha: " + erro;
            DatabaseConfig.ConnectionString = stringOriginal;
        }
    }

    private void GuardarConexao()
    {
        if (string.IsNullOrWhiteSpace(connString))
        {
            sucesso = false;
            mensagem = "A Connection String não pode estar vazia.";
            return;
        }

        DatabaseConfig.ConnectionString = connString.Trim();
        sucesso = true;
        mensagem = "Configurações guardadas com sucesso!";
    }
}
