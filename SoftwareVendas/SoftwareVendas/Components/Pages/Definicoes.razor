@page "/definicoes"
@using System.Data.SqlClient
@using SoftwareVendas
@inject NavigationManager NavManager

<div class="p-8 h-full">
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Definições do Sistema</h1>
        <p class="text-gray-500 mt-1">Configuração da Sessão e Base de Dados</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Bloco de Sessão -->
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h2 class="text-lg font-bold text-[#2B3347] border-b pb-2 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                Utilizador Atual
            </h2>
            <div class="space-y-4">
                <div>
                    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">Nome</p>
                    <p class="font-medium text-gray-800 text-lg">@Sessao.Nome</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">Cargo</p>
                    <p class="font-medium text-gray-800 text-lg">@Sessao.Cargo</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">Comissão Atribuída</p>
                    <p class="font-medium text-green-600 text-lg">@Sessao.PercentagemComissao.ToString("N2")%</p>
                </div>
            </div>
        </div>

        <!-- Bloco de Base de Dados -->
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h2 class="text-lg font-bold text-[#2B3347] border-b pb-2 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
                Conexão SQL Server
            </h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-xs text-gray-400 font-bold uppercase tracking-wider mb-2">Connection String</label>
                    <textarea @bind="connString" rows="4" class="w-full border border-gray-300 rounded px-3 py-2 text-gray-700 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 font-mono text-sm"></textarea>
                </div>
                
                @if(!string.IsNullOrEmpty(mensagem))
                {
                    <div class="p-3 rounded text-sm @(sucesso ? "bg-green-50 text-green-800" : "bg-red-50 text-red-800")">
                        @mensagem
                    </div>
                }

                <div class="flex justify-end space-x-3 pt-2">
                    <button @onclick="TestarConexao" class="px-4 py-2 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 font-semibold border border-gray-300 transition">
                        Testar
                    </button>
                    <button @onclick="GuardarConexao" class="px-4 py-2 bg-[#3F6CD8] text-white rounded hover:bg-blue-700 font-semibold shadow transition">
                        Guardar
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private string connString = "";
    private string mensagem = "";
    private bool sucesso = false;

    protected override void OnInitialized()
    {
        connString = DatabaseConfig.ConnectionString;
    }

    private void TestarConexao()
    {
        string stringOriginal = DatabaseConfig.ConnectionString;
        DatabaseConfig.ConnectionString = connString.Trim();

        if (DatabaseConfig.TestarConexao(out string erro))
        {
            sucesso = true;
            mensagem = "Conexão estabelecida com sucesso!";
        }
        else
        {
            sucesso = false;
            mensagem = "Falha: " + erro;
            DatabaseConfig.ConnectionString = stringOriginal;
        }
    }

    private void GuardarConexao()
    {
        if (string.IsNullOrWhiteSpace(connString))
        {
            sucesso = false;
            mensagem = "A Connection String não pode estar vazia.";
            return;
        }

        DatabaseConfig.ConnectionString = connString.Trim();
        sucesso = true;
        mensagem = "Configurações guardadas com sucesso!";
    }
}
