@page "/definicoes"
@using System.Data.SqlClient
@using SoftwareVendas

<div class="p-8 h-full">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Definições do Sistema</h1>
        <button @onclick="Guardar" class="bg-[#3F6CD8] text-white px-6 py-2 rounded shadow hover:bg-blue-700 transition">
            Guardar Alterações
        </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Database Settings -->
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h2 class="text-lg font-semibold text-[#2B3347] border-b pb-2 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
                Base de Dados
            </h2>
            
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">String de Conexão SQL Server</label>
                    <textarea @bind="connString" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded font-mono text-sm focus:ring-blue-500 focus:border-blue-500"></textarea>
                    <p class="text-xs text-gray-500 mt-1">Por exemplo: Data Source=SERVIDOR;Initial Catalog=Vendas;Integrated Security=True</p>
                </div>
                
                <div class="flex space-x-3">
                    <button @onclick="Testar" class="bg-gray-100 text-gray-700 px-4 py-2 rounded hover:bg-gray-200 border border-gray-300 transition text-sm font-semibold">
                        Testar Conexão
                    </button>
                    @if (testeSucesso == true)
                    {
                        <span class="flex items-center text-green-600 text-sm font-semibold"><svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Ligação OK</span>
                    }
                    else if (testeSucesso == false)
                    {
                        <span class="flex items-center text-red-600 text-sm font-semibold"><svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg> Falhou</span>
                    }
                </div>
            </div>
        </div>

        <!-- Preferences -->
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h2 class="text-lg font-semibold text-[#2B3347] border-b pb-2 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                Preferências Locais
            </h2>
            
            <div class="space-y-4">
                <p class="text-gray-500 text-sm">As definições visuais agora são geridas globalmente pelo tema Blazor WebView2. Opções antigas de cor e janelas foram desativadas a favor de um design moderno unificado.</p>
                <div class="bg-blue-50 p-4 rounded text-blue-800 text-sm">
                    <strong>Informação:</strong> O tema Flowlu encontra-se ativado e não pode ser removido.
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string connString = "";
    private bool? testeSucesso = null;

    protected override void OnInitialized()
    {
        connString = DatabaseConfig.ConnectionString;
    }

    private void Testar()
    {
        try
        {
            using (SqlConnection con = new SqlConnection(connString))
            {
                con.Open();
                testeSucesso = true;
            }
        }
        catch
        {
            testeSucesso = false;
        }
    }

    private void Guardar()
    {
        if (!string.IsNullOrWhiteSpace(connString))
        {
            DatabaseConfig.ConnectionString = connString.Trim();
        }
    }
}
