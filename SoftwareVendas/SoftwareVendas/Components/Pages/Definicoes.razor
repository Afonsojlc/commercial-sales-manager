@page "/definicoes"
@using System.Data.SqlClient
@using SoftwareVendas
@inject NavigationManager NavManager

<div class="p-4 sm:p-6 space-y-6 max-w-[1720px] mx-auto w-full">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Definições do Sistema</h1>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium tracking-wide bg-cobalt-500/10 text-cobalt-400 border border-cobalt-500/20">
                    AJLC // DEFINIÇÕES
                </span>
            </div>
            <p class="text-xs text-slate-400 mt-1">
                Parametrizações de infraestrutura, conexão de rede à base de dados SQL Server e perfil comercial ativo.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Bloco de Sessão -->
        <div class="rounded-3xl glass-panel p-6 sm:p-7 shadow-floating-card">
            <h2 class="text-base font-bold text-white tracking-tight border-b border-white/10 pb-3 mb-5 flex items-center gap-2">
                <svg class="w-4 h-4 text-cobalt-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                Perfil Comercial em Sessão
            </h2>
            <div class="space-y-4">
                <div class="flex items-center gap-4 bg-obsidian-950/70 p-4 rounded-2xl border border-white/10">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center font-bold text-white text-lg shadow-glow-cobalt">
                        @(string.IsNullOrEmpty(Sessao.Nome) ? "C" : Sessao.Nome.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <p class="font-bold text-white text-base">@Sessao.Nome</p>
                        <p class="text-xs font-mono text-cobalt-400">@Sessao.Cargo &bull; ID: #@Sessao.ID_Vendedor</p>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4 pt-2">
                    <div class="bg-obsidian-950/70 p-4 rounded-2xl border border-white/10">
                        <p class="font-mono uppercase tracking-wider text-[10px] text-slate-400">Nível de Acesso</p>
                        <p class="font-semibold text-white mt-1">@Sessao.Cargo</p>
                    </div>
                    <div class="bg-obsidian-950/70 p-4 rounded-2xl border border-white/10">
                        <p class="font-mono uppercase tracking-wider text-[10px] text-slate-400">Taxa de Comissão</p>
                        <p class="font-mono font-bold text-emerald-400 text-lg mt-0.5">@Sessao.PercentagemComissao.ToString("N2")%</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bloco de Base de Dados -->
        <div class="rounded-3xl glass-panel p-6 sm:p-7 shadow-floating-card">
            <h2 class="text-base font-bold text-white tracking-tight border-b border-white/10 pb-3 mb-5 flex items-center gap-2">
                <svg class="w-4 h-4 text-cobalt-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
                Conexão SQL Server
            </h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-[11px] font-mono uppercase tracking-wider text-slate-400 mb-2">Connection String (ADO.NET)</label>
                    <textarea @bind="connString" rows="4" class="w-full glass-input rounded-2xl p-3 text-white font-mono text-xs focus:ring-cobalt-500/50"></textarea>
                </div>
                
                @if(!string.IsNullOrEmpty(mensagem))
                {
                    <div class="p-3.5 rounded-2xl text-xs font-mono border flex items-center gap-2 @(sucesso ? "bg-emerald-500/10 text-emerald-300 border-emerald-500/30" : "bg-rose-500/10 text-rose-300 border-rose-500/30")">
                        @if (sucesso)
                        {
                            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        }
                        else
                        {
                            <svg class="w-4 h-4 text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        }
                        <span>@mensagem</span>
                    </div>
                }

                <div class="flex justify-end gap-3 pt-2">
                    <button @onclick="TestarConexao" class="px-4 py-2 rounded-2xl bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 text-xs font-semibold transition">
                        Testar Conexão
                    </button>
                    <button @onclick="GuardarConexao" class="px-5 py-2 rounded-2xl bg-cobalt-600 hover:bg-cobalt-500 text-white font-bold text-xs shadow-glow-cobalt transition">
                        Guardar Alterações
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private string connString = "";
    private string mensagem = "";
    private bool sucesso = false;

    protected override void OnInitialized()
    {
        connString = DatabaseConfig.ConnectionString;
    }

    private void TestarConexao()
    {
        string stringOriginal = DatabaseConfig.ConnectionString;
        DatabaseConfig.ConnectionString = connString.Trim();

        if (DatabaseConfig.TestarConexao(out string erro))
        {
            sucesso = true;
            mensagem = "Conexão estabelecida com sucesso!";
        }
        else
        {
            sucesso = false;
            mensagem = "Falha: " + erro;
            DatabaseConfig.ConnectionString = stringOriginal;
        }
    }

    private void GuardarConexao()
    {
        if (string.IsNullOrWhiteSpace(connString))
        {
            sucesso = false;
            mensagem = "A Connection String não pode estar vazia.";
            return;
        }

        DatabaseConfig.ConnectionString = connString.Trim();
        sucesso = true;
        mensagem = "Configurações guardadas com sucesso!";
    }
}
