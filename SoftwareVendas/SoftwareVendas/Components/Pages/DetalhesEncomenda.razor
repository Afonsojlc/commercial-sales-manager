@page "/encomendas/{IdEncomenda}"
@using System.Data
@using Microsoft.Data.SqlClient
@inject NavigationManager NavManager
@inject IJSRuntime JS

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        #printArea, #printArea * {
            visibility: visible;
        }
        #printArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            padding: 24px;
            margin: 0;
            border: none !important;
            box-shadow: none !important;
            background: white !important;
        }
        .no-print {
            display: none !important;
        }
    }
</style>

<div class="p-8 h-full overflow-auto">
    <!-- Top Action Bar (hidden in print) -->
    <div class="flex justify-between items-center mb-8 no-print">
        <button @onclick="Voltar" class="text-gray-600 hover:text-gray-900 flex items-center font-medium transition">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Voltar às Encomendas
        </button>

        <div class="flex items-center space-x-3">
            <button @onclick="ModificarEncomenda" class="bg-[#F59E0B] hover:bg-amber-600 text-white font-medium px-4 py-2 rounded shadow transition flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                Modificar Encomenda
            </button>

            <button @onclick="Imprimir" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-4 py-2 rounded border border-gray-300 transition flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                Imprimir Nota de Encomenda
            </button>

            @if (estadoOriginal != estadoSelecionado)
            {
                <button @onclick="GuardarEstado" class="bg-green-600 hover:bg-green-700 text-white font-medium px-4 py-2 rounded shadow transition flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Gravar Novo Estado
                </button>
            }
        </div>
    </div>

    @if (carregando)
    {
        <div class="flex justify-center items-center h-64 text-gray-400">
            <svg class="animate-spin -ml-1 mr-3 h-8 w-8 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            A carregar dados da encomenda...
        </div>
    }
    else
    {
        <!-- Documento Oficial / Nota de Encomenda Printable Layout -->
        <div id="printArea" class="bg-white p-10 rounded-xl shadow-sm border border-gray-200 max-w-5xl mx-auto">
            
            <!-- 1. Document Header -->
            <div class="border-b-2 border-[#2C3E50] pb-4 mb-6">
                <div class="flex justify-between items-start">
                    <div>
                        <h1 class="text-3xl font-black text-[#2B3347] tracking-wider uppercase">NOTA DE ENCOMENDA</h1>
                        <p class="text-sm font-medium text-gray-500 mt-1">Gestão Comercial & Distribuição de Material Elétrico</p>
                    </div>
                    <div class="text-right">
                        <h2 class="text-xl font-bold text-[#3F6CD8]">AJLC Soluctions</h2>
                        <p class="text-xs text-gray-500">Comercial: <strong>@(string.IsNullOrEmpty(vendedorNome) ? Sessao.Nome : vendedorNome)</strong></p>
                    </div>
                </div>
            </div>

            <!-- 2. Meta Info Strip -->
            <div class="bg-gray-50 rounded-lg p-4 mb-6 border border-gray-100 flex justify-between items-center text-sm">
                <div>
                    <span class="text-gray-500">Encomenda Nº:</span>
                    <strong class="text-gray-900 ml-1 text-base">#@IdEncomenda</strong>
                </div>
                <div>
                    <span class="text-gray-500">Data:</span>
                    <strong class="text-gray-900 ml-1">@dataEncomenda.ToString("dd/MM/yyyy")</strong>
                </div>
                <div class="flex items-center space-x-2">
                    <span class="text-gray-500">Estado:</span>
                    <div class="no-print inline-block">
                        <select @bind="estadoSelecionado" class="border border-gray-300 rounded px-2.5 py-1 text-xs font-bold focus:ring-blue-500 bg-white">
                            <option value="PENDENTE">PENDENTE</option>
                            <option value="FECHADA">FECHADA</option>
                            <option value="PAGA">PAGA</option>
                            <option value="DESPACHADO">DESPACHADO</option>
                            <option value="A ENTREGAR">A ENTREGAR</option>
                            <option value="CANCELADA">CANCELADA</option>
                        </select>
                    </div>
                    <strong class="hidden print:inline text-gray-900">@estadoOriginal</strong>
                </div>
            </div>

            <!-- 3. Client Details Box -->
            <div class="border border-gray-200 rounded-lg p-5 mb-8">
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">DADOS DO CLIENTE</h3>
                <div class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                        <p class="text-gray-500 text-xs">Cliente</p>
                        <p class="font-bold text-gray-800 text-base">@clienteNome</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs">NIF</p>
                        <p class="font-semibold text-gray-800">@clienteNIF</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs">Email</p>
                        <p class="text-gray-700">@(string.IsNullOrEmpty(clienteEmail) ? "Não especificado" : clienteEmail)</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs">Telefone</p>
                        <p class="text-gray-700">@(string.IsNullOrEmpty(clienteTelefone) ? "Não especificado" : clienteTelefone)</p>
                    </div>
                </div>
            </div>

            <!-- 4. Products Table -->
            <div class="mb-8">
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">ARTIGOS ENCOMENDADOS</h3>
                <table class="w-full text-left border-collapse border border-gray-200 rounded">
                    <thead>
                        <tr class="bg-gray-100 text-gray-700 text-xs uppercase font-bold border-b border-gray-200">
                            <th class="py-3 px-4">Código</th>
                            <th class="py-3 px-4">Descrição do Artigo</th>
                            <th class="py-3 px-4 text-right">Qtd</th>
                            <th class="py-3 px-4 text-right">Preço Unit.</th>
                            <th class="py-3 px-4 text-center">Desc. (%)</th>
                            <th class="py-3 px-4 text-right">IVA</th>
                            <th class="py-3 px-4 text-right">Total</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm divide-y divide-gray-200">
                        @foreach (var l in linhas)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="py-3 px-4 font-mono font-medium text-gray-900">@l.Codigo</td>
                                <td class="py-3 px-4 text-gray-800">@l.Descricao</td>
                                <td class="py-3 px-4 text-right font-semibold">@l.Qtd</td>
                                <td class="py-3 px-4 text-right">€ @l.Preco.ToString("N2")</td>
                                <td class="py-3 px-4 text-center font-medium text-blue-600">@(string.IsNullOrEmpty(l.DescontoTexto) ? "-" : l.DescontoTexto)</td>
                                <td class="py-3 px-4 text-right text-gray-500">@l.Iva%</td>
                                <td class="py-3 px-4 text-right font-bold text-gray-900">€ @l.Subtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- 5. Totals Section -->
            <div class="flex justify-end mb-12">
                <div class="w-72 space-y-2 text-sm">
                    <div class="flex justify-between text-gray-600">
                        <span>Subtotal (c/ IVA):</span>
                        <span class="font-medium">€ @((linhas.Count > 0 ? linhas.Sum(l => l.Subtotal) : valorTotal + descontoGlobal).ToString("N2"))</span>
                    </div>
                    @if (descontoGlobal > 0)
                    {
                        <div class="flex justify-between text-red-600">
                            <span>Desconto Global:</span>
                            <span class="font-medium">- € @descontoGlobal.ToString("N2")</span>
                        </div>
                    }
                    <div class="flex justify-between text-xl font-black text-[#2B3347] border-t-2 border-gray-800 pt-3 mt-2">
                        <span>TOTAL A PAGAR:</span>
                        <span class="text-[#3F6CD8]">€ @valorTotal.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <!-- 6. Dual Signatures Section (Matching FormDetalhesEncomenda) -->
            <div class="mt-16 pt-6 border-t border-gray-200">
                <div class="grid grid-cols-2 gap-16 text-center text-xs text-gray-500">
                    <div>
                        <div class="border-b-2 border-gray-400 pb-1 mb-2"></div>
                        <p class="font-semibold text-gray-700">Assinatura do Cliente / Carimbo</p>
                    </div>
                    <div>
                        <div class="border-b-2 border-gray-400 pb-1 mb-2"></div>
                        <p class="font-semibold text-gray-700">O Comercial / Responsável de Vendas</p>
                    </div>
                </div>
                <div class="text-center text-[10px] text-gray-400 mt-8">
                    Documento processado por computador • AJLC Soluctions
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string IdEncomenda { get; set; } = "";
    
    private bool carregando = true;

    private DateTime dataEncomenda;
    private decimal valorTotal;
    private decimal descontoGlobal;
    private string estadoOriginal = "";
    private string estadoSelecionado = "";
    private string vendedorNome = "";
    
    private string clienteNome = "";
    private string clienteNIF = "";
    private string clienteEmail = "";
    private string clienteTelefone = "";

    private List<LinhaView> linhas = new List<LinhaView>();

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        carregando = true;
        linhas.Clear();

        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                // 1. Dados Cabeçalho e Cliente
                string queryE = @"
                    SELECT 
                        E.Data_Encomenda, E.Valor_Total, E.Estado, E.Desconto_Global,
                        ISNULL(C.Nome_Cliente, 'Cliente Não Identificado') AS Nome_Cliente, 
                        ISNULL(C.NIF, '-') AS NIF, 
                        ISNULL(C.Email, '') AS Email, 
                        ISNULL(C.Telefone, '') AS Telefone,
                        ISNULL(V.Nome, '') AS VendedorNome
                    FROM Encomenda E
                    LEFT JOIN Clientes C ON E.ID_Cliente = C.ID_Cliente
                    LEFT JOIN Vendedores V ON E.ID_Vendedor = V.ID_Vendedor
                    WHERE E.Numero_Encomenda = @id";
                
                using (SqlCommand cmd = new SqlCommand(queryE, con))
                {
                    cmd.Parameters.AddWithValue("@id", IdEncomenda);
                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        if (rd.Read())
                        {
                            dataEncomenda = rd["Data_Encomenda"] != DBNull.Value ? Convert.ToDateTime(rd["Data_Encomenda"]) : DateTime.Now;
                            valorTotal = rd["Valor_Total"] != DBNull.Value ? Convert.ToDecimal(rd["Valor_Total"]) : 0m;
                            estadoOriginal = rd["Estado"]?.ToString() ?? "PENDENTE";
                            estadoSelecionado = estadoOriginal;
                            descontoGlobal = rd["Desconto_Global"] != DBNull.Value ? Convert.ToDecimal(rd["Desconto_Global"]) : 0m;
                            
                            clienteNome = rd["Nome_Cliente"]?.ToString() ?? "";
                            clienteNIF = rd["NIF"]?.ToString() ?? "";
                            clienteEmail = rd["Email"]?.ToString() ?? "";
                            clienteTelefone = rd["Telefone"]?.ToString() ?? "";
                            vendedorNome = rd["VendedorNome"]?.ToString() ?? "";
                        }
                    }
                }

                // 2. Linhas
                string queryL = @"
                    SELECT Codigo_Material, Descricao, Quantidade, Preco, Imposto, Desconto_Texto
                    FROM Linha_Encomenda 
                    WHERE NE = @id
                    ORDER BY Linha_Encomenda ASC";
                
                using (SqlCommand cmd = new SqlCommand(queryL, con))
                {
                    cmd.Parameters.AddWithValue("@id", IdEncomenda);
                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        while (rd.Read())
                        {
                            linhas.Add(new LinhaView
                            {
                                Codigo = rd["Codigo_Material"]?.ToString() ?? "",
                                Descricao = rd["Descricao"]?.ToString() ?? "",
                                Qtd = rd["Quantidade"] != DBNull.Value ? Convert.ToInt32(rd["Quantidade"]) : 0,
                                Preco = rd["Preco"] != DBNull.Value ? Convert.ToDecimal(rd["Preco"]) : 0m,
                                Iva = rd["Imposto"] != DBNull.Value ? Convert.ToDecimal(rd["Imposto"]) : 23m,
                                DescontoTexto = rd["Desconto_Texto"]?.ToString() ?? ""
                            });
                        }
                    }
                }
            }
            catch { }
        }
        carregando = false;
    }

    private void ModificarEncomenda()
    {
        NavManager.NavigateTo($"/novavenda/{IdEncomenda}");
    }

    private void GuardarEstado()
    {
        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = "UPDATE Encomenda SET Estado = @estado WHERE Numero_Encomenda = @id";
                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@estado", estadoSelecionado);
                    cmd.Parameters.AddWithValue("@id", IdEncomenda);
                    cmd.ExecuteNonQuery();
                }
                estadoOriginal = estadoSelecionado;
            }
            catch { }
        }
    }

    private void Voltar()
    {
        NavManager.NavigateTo("/encomendas");
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    public class LinhaView
    {
        public string Codigo { get; set; } = "";
        public string Descricao { get; set; } = "";
        public int Qtd { get; set; }
        public decimal Preco { get; set; }
        public decimal Iva { get; set; }
        public string DescontoTexto { get; set; } = "";

        private decimal PrecoCalculado 
        {
            get 
            {
                if (string.IsNullOrWhiteSpace(DescontoTexto)) return Preco;
                string textoLimpo = DescontoTexto.Replace("%", "").Replace(" ", "").Replace(",", ".");
                decimal final = Preco;
                foreach (var d in textoLimpo.Split('+'))
                {
                    if (decimal.TryParse(d, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal p))
                    {
                        final -= (final * (p / 100m));
                    }
                }
                return final;
            }
        }
        public decimal Subtotal => Qtd * PrecoCalculado * (1 + Iva/100m);
    }
}
