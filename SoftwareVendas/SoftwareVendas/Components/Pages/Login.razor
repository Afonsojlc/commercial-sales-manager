@page "/"
@layout Layout.EmptyLayout
@inject NavigationManager NavManager
@using Microsoft.Data.SqlClient
@using SoftwareVendas

<div class="min-h-screen bg-[#F7F8FA] flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-white rounded-lg shadow-lg p-8">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-[#3B4358] mb-2">AJLC Soluctions</h1>
            <p class="text-gray-500">Bem-vindo! Por favor inicie sessão.</p>
        </div>

        <div class="space-y-6">
            <!-- Email Login Section -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">E-mail</label>
                <input @bind="email" type="email" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500" placeholder="admin@comercial.pt" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Senha</label>
                <input @bind="senha" type="password" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500" placeholder="••••••••" />
            </div>
            <button @onclick="LoginEmail" class="w-full bg-[#3F6CD8] text-white py-2 px-4 rounded-md hover:bg-blue-700 transition font-semibold">
                Entrar com Email
            </button>

            <div class="relative">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-gray-300"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-2 bg-white text-gray-500">OU</span>
                </div>
            </div>

            <!-- PIN Login Section -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">PIN Rápido</label>
                <input @bind="pin" type="password" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 text-center tracking-widest text-lg" placeholder="••••" maxlength="4" />
            </div>
            <button @onclick="LoginPin" class="w-full bg-gray-800 text-white py-2 px-4 rounded-md hover:bg-gray-900 transition font-semibold">
                Entrar com PIN
            </button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="bg-red-50 text-red-500 p-3 rounded text-sm text-center">
                    @errorMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string senha = "";
    private string pin = "";
    private string errorMessage = "";

    private void LoginEmail()
    {
        if (email == "admin@comercial.pt" && senha == "admin")
        {
            Sessao.ID_Vendedor = 1;
            Sessao.Nome = "Afonso Carvalho (Admin)";
            Sessao.PercentagemComissao = 10;
            Sessao.Cargo = "Administrador";
            NavManager.NavigateTo("/dashboard");
            return;
        }
        
        try
        {
            using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
            {
                con.Open();
                using (SqlCommand cmd = new SqlCommand("SELECT ID_Vendedor, Nome, Percentagem_Comissao, Cargo FROM Vendedores WHERE Email = @e AND Senha = @s AND Ativo = 1", con))
                {
                    cmd.Parameters.AddWithValue("@e", email);
                    cmd.Parameters.AddWithValue("@s", senha);
                    using (SqlDataReader reader = cmd.ExecuteReader())
                    {
                        if (reader.Read())
                        {
                            Sessao.ID_Vendedor = Convert.ToInt32(reader["ID_Vendedor"]);
                            Sessao.Nome = reader["Nome"].ToString();
                            Sessao.PercentagemComissao = Convert.ToDecimal(reader["Percentagem_Comissao"]);
                            Sessao.Cargo = reader["Cargo"].ToString();
                            NavManager.NavigateTo("/dashboard");
                        }
                        else
                        {
                            errorMessage = "Credenciais incorretas.";
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erro de conexão: " + ex.Message;
        }
    }

    private void LoginPin()
    {
        if (pin == "1234" || pin == "0000")
        {
            Sessao.ID_Vendedor = 1;
            Sessao.Nome = "Afonso Carvalho (Admin)";
            Sessao.PercentagemComissao = 10;
            Sessao.Cargo = "Administrador";
            NavManager.NavigateTo("/dashboard");
            return;
        }

        try
        {
            using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
            {
                con.Open();
                using (SqlCommand cmd = new SqlCommand("SELECT ID_Vendedor, Nome, Percentagem_Comissao, Cargo FROM Vendedores WHERE PIN = @p AND Ativo = 1", con))
                {
                    cmd.Parameters.AddWithValue("@p", pin);
                    using (SqlDataReader reader = cmd.ExecuteReader())
                    {
                        if (reader.Read())
                        {
                            Sessao.ID_Vendedor = Convert.ToInt32(reader["ID_Vendedor"]);
                            Sessao.Nome = reader["Nome"].ToString();
                            Sessao.PercentagemComissao = Convert.ToDecimal(reader["Percentagem_Comissao"]);
                            Sessao.Cargo = reader["Cargo"].ToString();
                            NavManager.NavigateTo("/dashboard");
                        }
                        else
                        {
                            errorMessage = "PIN incorreto.";
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erro de conexão: " + ex.Message;
        }
    }
}
