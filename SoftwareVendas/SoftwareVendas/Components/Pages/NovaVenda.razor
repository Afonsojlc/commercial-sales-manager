@page "/novavenda"
@page "/novavenda/{IdEditar:int}"
@using System.Data
@using Microsoft.Data.SqlClient
@inject NavigationManager NavManager

<div class="p-8 max-w-7xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold text-slate-900">
                    @(modoEdicao ? $"Modificar Encomenda #{idEncomendaEditar}" : "Nova Nota de Encomenda")
                </h1>
                @if (modoEdicao)
                {
                    <span class="bg-amber-100 text-amber-800 font-bold px-3 py-1 rounded-full text-xs uppercase tracking-wider border border-amber-300">
                        Modo de Edição
                    </span>
                }
            </div>
            <p class="text-xs text-slate-500 mt-1">
                @(modoEdicao 
                    ? "Os artigos e descontos desta encomenda serão atualizados e o inventário (stock) reajustado automaticamente." 
                    : "Registo rápido de encomenda. Dica: use Enter para navegar entre artigo, quantidade e desconto sem usar o rato.")
            </p>
        </div>

        <div class="flex gap-3">
            @if (modoEdicao)
            {
                <button @onclick="CancelarEdicao" class="corp-btn-secondary">
                    Cancelar
                </button>
                <button @onclick="FinalizarEncomenda" class="corp-btn-primary bg-amber-600 hover:bg-amber-700">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Guardar Alterações
                </button>
            }
            else
            {
                <button @onclick="FinalizarEncomenda" class="corp-btn-primary">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Finalizar Encomenda (Gravar)
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAviso))
    {
        <div class="p-4 rounded-xl shadow-sm border flex justify-between items-center @(mensagemAviso.Contains("sucesso") ? "bg-emerald-50 text-emerald-800 border-emerald-200" : "bg-amber-50 text-amber-800 border-amber-200")">
            <div class="font-medium text-sm flex items-center gap-2">
                @if (mensagemAviso.Contains("sucesso"))
                {
                    <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                }
                else
                {
                    <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                }
                <span>@mensagemAviso</span>
            </div>
            @if (modoEdicao && mensagemAviso.Contains("sucesso"))
            {
                <button @onclick="VoltarDetalhes" class="bg-emerald-600 text-white px-3.5 py-1.5 rounded-lg text-xs font-bold hover:bg-emerald-700 transition">
                    Ver Nota de Encomenda &rarr;
                </button>
            }
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Column: Client & Line Items -->
        <div class="lg:col-span-2 space-y-6">
            
            <!-- 1. Dados do Cliente -->
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <div class="flex justify-between items-center border-b border-slate-200 pb-3 mb-4">
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        Identificação do Cliente
                    </h2>
                    @if (clienteSelecionado != null)
                    {
                        <button @onclick="LimparCliente" class="text-xs text-blue-600 hover:text-blue-800 font-semibold">
                            Trocar Cliente
                        </button>
                    }
                </div>
                
                <div class="relative">
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Pesquisar Cliente (NIF ou Nome Comercial)</label>
                    <div class="relative">
                        <input type="text" 
                               @bind="PesquisaCliente" 
                               @bind:event="oninput" 
                               @onkeydown="OnKeyDownPesquisaCliente"
                               placeholder="Comece a escrever o Nome ou NIF..." 
                               autocomplete="off" 
                               class="w-full corp-input" />
                    </div>

                    @if (clientesResultados != null && clientesResultados.Count > 0)
                    {
                        <div class="absolute z-50 left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-xl max-h-56 overflow-y-auto divide-y divide-slate-100">
                            @foreach (var c in clientesResultados)
                            {
                                <div class="p-3 hover:bg-blue-50 cursor-pointer transition" 
                                     @onclick="() => SelecionarCliente(c)"
                                     @ondblclick="() => SelecionarCliente(c)">
                                    <div class="flex justify-between items-center">
                                        <span class="font-bold text-sm text-slate-800">@c.Nome_Cliente</span>
                                        <span class="text-xs font-mono text-blue-600 bg-blue-50 px-2 py-0.5 rounded border border-blue-200">NIF: @c.NIF</span>
                                    </div>
                                    <div class="text-xs text-slate-500 mt-1">@c.Morada_Completa</div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Dados do Cliente Selecionado -->
                <div class="mt-4 bg-slate-50 p-4 rounded-lg border border-slate-200 grid grid-cols-2 sm:grid-cols-3 gap-4 text-xs">
                    <div class="sm:col-span-2">
                        <p class="font-semibold text-slate-400 uppercase text-[10px]">Cliente / Razão Social</p>
                        <p class="font-bold text-slate-800 text-sm mt-0.5">@(clienteSelecionado?.Nome_Cliente ?? "-- Nenhum cliente selecionado --")</p>
                    </div>
                    <div>
                        <p class="font-semibold text-slate-400 uppercase text-[10px]">NIF</p>
                        <p class="font-mono font-bold text-slate-800 text-sm mt-0.5">@(clienteSelecionado?.NIF ?? "--")</p>
                    </div>
                    <div class="sm:col-span-3">
                        <p class="font-semibold text-slate-400 uppercase text-[10px]">Morada de Faturação</p>
                        <p class="text-slate-700 mt-0.5">@(clienteSelecionado?.Morada_Completa ?? "--")</p>
                    </div>
                </div>
            </div>

            <!-- 2. Adicionar Produto Rápido (Keyboard-First Flow) -->
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <div class="flex justify-between items-center border-b border-slate-200 pb-3 mb-4">
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        Adicionar Artigo à Encomenda
                    </h2>
                    <span class="text-[11px] font-mono text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                        Atalho: Digitar &rarr; Enter &rarr; Qtd &rarr; Enter
                    </span>
                </div>

                <div class="grid grid-cols-12 gap-3 items-end">
                    <!-- Produto Search Autocomplete -->
                    <div class="col-span-12 sm:col-span-4 relative">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Código / Referência</label>
                        <input @ref="inputPesquisaRef"
                               type="text" 
                               @bind="PesquisaProduto" 
                               @bind:event="oninput" 
                               @onkeydown="OnKeyDownPesquisaProduto"
                               autocomplete="off" 
                               placeholder="Ex: CAB-001 ou Disjuntor..." 
                               class="w-full corp-input text-xs font-mono font-semibold" />
                        
                        @if (produtosResultados != null && produtosResultados.Count > 0)
                        {
                            <div class="absolute z-50 left-0 w-88 sm:w-96 mt-1 bg-white border border-slate-200 rounded-xl shadow-xl max-h-56 overflow-y-auto divide-y divide-slate-100">
                                @foreach (var p in produtosResultados)
                                {
                                    <div class="p-2.5 hover:bg-blue-50 cursor-pointer text-xs transition" 
                                         @onclick="() => SelecionarProduto(p)"
                                         @ondblclick="() => SelecionarProduto(p)">
                                        <div class="flex justify-between font-bold text-slate-800">
                                            <span class="font-mono text-blue-700">@p.Codigo</span>
                                            <span class="text-slate-900">€ @p.PVP_Unidade.ToString("N2")</span>
                                        </div>
                                        <div class="text-slate-600 mt-0.5 truncate">@p.Descricao</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="col-span-12 sm:col-span-3">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Descrição</label>
                        <input type="text" @bind="novoArtigoDescricao" readonly class="w-full corp-input text-xs bg-slate-100 text-slate-600 truncate" />
                    </div>

                    <div class="col-span-4 sm:col-span-2">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Preço s/ IVA</label>
                        <input type="text" value="@("€ " + novoArtigoPreco.ToString("N2"))" readonly class="w-full corp-input text-xs bg-slate-100 text-slate-600 font-mono text-right" />
                    </div>

                    <div class="col-span-4 sm:col-span-1">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Qtd</label>
                        <input @ref="inputQtdRef"
                               type="number" 
                               min="1" 
                               @bind="novoArtigoQtd" 
                               @onkeydown="OnKeyDownQtd"
                               class="w-full corp-input text-xs font-mono font-bold text-center" />
                    </div>

                    <div class="col-span-4 sm:col-span-1">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Desc.(%)</label>
                        <input @ref="inputDescontoRef"
                               type="text" 
                               @bind="novoArtigoDesconto" 
                               @onkeydown="OnKeyDownDesconto"
                               placeholder="50+10" 
                               class="w-full corp-input text-xs font-mono text-center" />
                    </div>

                    <div class="col-span-12 sm:col-span-1">
                        <button @onclick="AdicionarLinha" class="w-full corp-btn-primary py-2 text-xs">
                            + Adicionar
                        </button>
                    </div>
                </div>
            </div>

            <!-- 3. Tabela de Linhas da Encomenda (Com Edição Direta) -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                        Artigos Encomendados
                    </h2>
                    <span class="text-xs font-semibold text-slate-600 bg-white border border-slate-200 px-2.5 py-1 rounded-full">
                        @linhas.Count linha(s)
                    </span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200 uppercase tracking-wider">
                            <tr>
                                <th class="py-3 px-3">Código</th>
                                <th class="py-3 px-3">Descrição do Artigo</th>
                                <th class="py-3 px-3 text-center w-24">Qtd (Editar)</th>
                                <th class="py-3 px-3 text-right">Preço Unit.</th>
                                <th class="py-3 px-3 text-center w-28">Desc. (%)</th>
                                <th class="py-3 px-3 text-right">IVA</th>
                                <th class="py-3 px-3 text-right">Total c/ IVA</th>
                                <th class="py-3 px-3 text-center w-12"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200">
                            @if (linhas.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-12 text-slate-400 text-sm">
                                        Nenhum artigo adicionado. Escreva o código acima e carregue em Enter.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var linha in linhas)
                                {
                                    <tr class="hover:bg-slate-50 transition">
                                        <td class="py-3 px-3 font-mono font-bold text-slate-900">@linha.Codigo</td>
                                        <td class="py-3 px-3 font-medium text-slate-800">@linha.Descricao</td>
                                        <td class="py-2 px-2 text-center">
                                            <input type="number" 
                                                   min="1"
                                                   value="@linha.Quantidade" 
                                                   @onchange="(e) => AtualizarQuantidadeLinha(linha, e.Value)"
                                                   class="w-20 corp-input py-1 text-center font-bold text-xs" />
                                        </td>
                                        <td class="py-3 px-3 text-right font-mono text-slate-700">€ @linha.PrecoUnitario.ToString("N2")</td>
                                        <td class="py-2 px-2 text-center">
                                            <input type="text" 
                                                   value="@linha.DescontoTexto" 
                                                   @onchange="(e) => AtualizarDescontoLinha(linha, e.Value)"
                                                   placeholder="0"
                                                   class="w-24 corp-input py-1 text-center font-mono text-xs text-blue-700 font-semibold" />
                                        </td>
                                        <td class="py-3 px-3 text-right text-slate-500">@linha.TaxaIva%</td>
                                        <td class="py-3 px-3 text-right font-mono font-bold text-slate-900 text-sm">€ @linha.TotalLinha.ToString("N2")</td>
                                        <td class="py-3 px-3 text-center">
                                            <button @onclick="() => RemoverLinha(linha)" class="text-red-500 hover:text-red-700 hover:bg-red-50 p-1 rounded transition" title="Remover Artigo">
                                                ✕
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Column: Financial Summary -->
        <div class="space-y-6">
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sticky top-6">
                <h2 class="text-base font-bold text-slate-800 border-b border-slate-200 pb-3 mb-4 flex items-center justify-between">
                    <span>Resumo Financeiro</span>
                    <span class="text-[10px] font-mono font-bold bg-blue-50 text-blue-700 px-2 py-0.5 rounded border border-blue-200">
                        NOTA DE VENDA
                    </span>
                </h2>
                
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between text-slate-600">
                        <span>Subtotal (s/ IVA):</span>
                        <span class="font-mono font-semibold text-slate-900">€ @subtotal.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between text-slate-600">
                        <span>Total de IVA:</span>
                        <span class="font-mono font-semibold text-slate-900">€ @totalIva.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between items-center text-slate-600 border-t border-slate-200 pt-3">
                        <span class="font-medium text-slate-700">Desconto Global (€):</span>
                        <input type="number" 
                               step="0.01"
                               @bind="descontoGlobal" 
                               @bind:event="oninput" 
                               class="w-28 corp-input py-1 text-right font-mono font-bold" />
                    </div>
                </div>

                <div class="mt-6 pt-4 border-t-2 border-slate-900">
                    <div class="flex justify-between items-baseline">
                        <span class="text-sm font-bold uppercase text-slate-700">Total a Pagar:</span>
                        <span class="text-3xl font-black text-blue-700 font-mono tracking-tight">
                            € @totalFinal.ToString("N2")
                        </span>
                    </div>
                    
                    <!-- Commission Pill -->
                    <div class="bg-emerald-50 border border-emerald-200 p-3 rounded-lg flex justify-between items-center text-xs mt-4">
                        <span class="text-emerald-800 font-semibold">Comissão Comercial (@Sessao.PercentagemComissao.ToString("N1")%):</span>
                        <span class="font-mono font-bold text-emerald-700 text-sm">+ € @((totalFinal * (Sessao.PercentagemComissao / 100m)).ToString("N2"))</span>
                    </div>
                </div>

                <div class="mt-6">
                    <button @onclick="FinalizarEncomenda" class="w-full corp-btn-primary py-3 text-sm font-bold shadow-md">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        @(modoEdicao ? "Guardar Alterações" : "Gravar Encomenda")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int? IdEditar { get; set; }

    [SupplyParameterFromQuery]
    public string? editar { get; set; }

    [SupplyParameterFromQuery]
    public string? cliente { get; set; }

    private ElementReference inputPesquisaRef;
    private ElementReference inputQtdRef;
    private ElementReference inputDescontoRef;

    private bool modoEdicao = false;
    private int idEncomendaEditar = 0;
    private string mensagemAviso = "";
    
    // Cliente
    private string _pesquisaCliente = "";
    private string PesquisaCliente
    {
        get => _pesquisaCliente;
        set
        {
            _pesquisaCliente = value;
            ExecutarPesquisaCliente(_pesquisaCliente);
        }
    }
    private List<ClienteSearchResult> clientesResultados = new List<ClienteSearchResult>();
    private ClienteSearchResult? clienteSelecionado = null;

    // Novo Artigo
    private string _pesquisaProduto = "";
    private string PesquisaProduto
    {
        get => _pesquisaProduto;
        set
        {
            _pesquisaProduto = value;
            ExecutarPesquisaProduto(_pesquisaProduto);
        }
    }
    private List<ProdutoSearchResult> produtosResultados = new List<ProdutoSearchResult>();
    private string novoArtigoCodigo = "";
    private string novoArtigoDescricao = "";
    private decimal novoArtigoPreco = 0;
    private decimal novoArtigoIva = 23;
    private string novoArtigoDesconto = "";
    private int novoArtigoQtd = 1;

    // Linhas
    private List<LinhaEncomendaModel> linhas = new List<LinhaEncomendaModel>();

    // Totais
    private decimal descontoGlobal = 0;
    private decimal subtotal => linhas.Sum(l => l.PrecoFinalCalculado * l.Quantidade);
    private decimal totalIva => linhas.Sum(l => (l.PrecoFinalCalculado * (l.TaxaIva / 100m)) * l.Quantidade);
    private decimal totalFinal => Math.Max(0, (subtotal + totalIva) - descontoGlobal);

    protected override void OnParametersSet()
    {
        int idParaCarregar = IdEditar ?? 0;
        if (idParaCarregar == 0 && !string.IsNullOrWhiteSpace(editar) && int.TryParse(editar, out int qId))
        {
            idParaCarregar = qId;
        }

        if (idParaCarregar > 0 && (!modoEdicao || idEncomendaEditar != idParaCarregar))
        {
            CarregarDadosEdicao(idParaCarregar);
        }
        else if (idParaCarregar == 0 && modoEdicao)
        {
            modoEdicao = false;
            idEncomendaEditar = 0;
            clienteSelecionado = null;
            linhas.Clear();
            descontoGlobal = 0;
            _pesquisaCliente = "";
            _pesquisaProduto = "";
            mensagemAviso = "";
        }

        // Se passar query parameter de cliente direto
        if (!string.IsNullOrWhiteSpace(cliente) && clienteSelecionado == null)
        {
            CarregarClientePorId(cliente);
        }
    }

    private void CarregarClientePorId(string id)
    {
        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = "SELECT ID_Cliente, Nome_Cliente, NIF, Morada_Completa FROM Clientes WHERE ID_Cliente = @id";
                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@id", id);
                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        if (rd.Read())
                        {
                            clienteSelecionado = new ClienteSearchResult
                            {
                                ID_Cliente = rd["ID_Cliente"].ToString()!,
                                Nome_Cliente = rd["Nome_Cliente"]?.ToString() ?? "",
                                NIF = rd["NIF"]?.ToString() ?? "",
                                Morada_Completa = rd["Morada_Completa"]?.ToString() ?? ""
                            };
                        }
                    }
                }
            }
            catch { }
        }
    }

    private void CarregarDadosEdicao(int id)
    {
        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();

                // 1. Cabeçalho e Cliente
                string queryEnc = @"
                    SELECT E.Numero_Encomenda, E.Desconto_Global,
                           C.ID_Cliente, C.Nome_Cliente, C.NIF, C.Morada_Completa
                    FROM Encomenda E
                    LEFT JOIN Clientes C ON E.ID_Cliente = C.ID_Cliente
                    WHERE E.Numero_Encomenda = @id";

                using (SqlCommand cmd = new SqlCommand(queryEnc, con))
                {
                    cmd.Parameters.AddWithValue("@id", id);
                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        if (rd.Read())
                        {
                            modoEdicao = true;
                            idEncomendaEditar = id;
                            descontoGlobal = rd["Desconto_Global"] != DBNull.Value ? Convert.ToDecimal(rd["Desconto_Global"]) : 0m;

                            if (rd["ID_Cliente"] != DBNull.Value)
                            {
                                clienteSelecionado = new ClienteSearchResult
                                {
                                    ID_Cliente = rd["ID_Cliente"].ToString()!,
                                    Nome_Cliente = rd["Nome_Cliente"]?.ToString() ?? "",
                                    NIF = rd["NIF"]?.ToString() ?? "",
                                    Morada_Completa = rd["Morada_Completa"]?.ToString() ?? ""
                                };
                            }
                        }
                    }
                }

                // 2. Linhas da Encomenda
                if (modoEdicao)
                {
                    linhas.Clear();
                    string queryLinhas = @"
                        SELECT Codigo_Material, Descricao, Quantidade, Preco, Imposto, Desconto_Texto
                        FROM Linha_Encomenda
                        WHERE NE = @id
                        ORDER BY Linha_Encomenda ASC";

                    using (SqlCommand cmdL = new SqlCommand(queryLinhas, con))
                    {
                        cmdL.Parameters.AddWithValue("@id", id);
                        using (SqlDataReader rdL = cmdL.ExecuteReader())
                        {
                            while (rdL.Read())
                            {
                                string cod = rdL["Codigo_Material"]?.ToString() ?? "";
                                string desc = rdL["Descricao"]?.ToString() ?? "";
                                int qtd = Convert.ToInt32(rdL["Quantidade"]);
                                decimal preco = Convert.ToDecimal(rdL["Preco"]);
                                decimal iva = Convert.ToDecimal(rdL["Imposto"]);
                                string descTxt = rdL["Desconto_Texto"]?.ToString() ?? "";

                                linhas.Add(new LinhaEncomendaModel
                                {
                                    Codigo = cod,
                                    Descricao = desc,
                                    Quantidade = qtd,
                                    PrecoUnitario = preco,
                                    TaxaIva = iva,
                                    DescontoTexto = descTxt,
                                    PrecoFinalCalculado = CalcularDescontoComposto(preco, descTxt)
                                });
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                mensagemAviso = "Erro ao carregar dados para edição: " + ex.Message;
            }
        }
    }

    private decimal CalcularDescontoComposto(decimal precoOriginal, string textoDesconto)
    {
        if (string.IsNullOrWhiteSpace(textoDesconto)) return precoOriginal;
        string textoLimpo = textoDesconto.Replace("%", "").Replace(" ", "").Replace(",", ".");
        string[] descontos = textoLimpo.Split('+');
        decimal precoFinal = precoOriginal;
        foreach (string desc in descontos)
        {
            if (decimal.TryParse(desc, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal percentagem))
            {
                precoFinal -= (precoFinal * (percentagem / 100m));
            }
        }
        return precoFinal;
    }

    private void ExecutarPesquisaCliente(string termo)
    {
        clientesResultados.Clear();
        mensagemAviso = "";
        if (string.IsNullOrWhiteSpace(termo)) return;

        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = "SELECT ID_Cliente, Nome_Cliente, NIF, Morada_Completa FROM Clientes WHERE NIF LIKE @t OR Nome_Cliente LIKE @t";
                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@t", "%" + termo.Trim() + "%");
                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        while (rd.Read())
                        {
                            clientesResultados.Add(new ClienteSearchResult {
                                ID_Cliente = rd["ID_Cliente"]?.ToString() ?? "",
                                Nome_Cliente = rd["Nome_Cliente"]?.ToString() ?? "",
                                NIF = rd["NIF"]?.ToString() ?? "",
                                Morada_Completa = rd["Morada_Completa"]?.ToString() ?? ""
                            });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                mensagemAviso = "Erro ao pesquisar cliente: " + ex.Message;
            }
        }
    }

