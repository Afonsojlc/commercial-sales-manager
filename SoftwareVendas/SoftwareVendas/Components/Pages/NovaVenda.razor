@page "/novavenda"
@using Microsoft.Data.SqlClient
@using SoftwareVendas

<div class="p-8 h-full overflow-auto">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Nova Encomenda</h1>
        <button class="bg-[#3F6CD8] text-white px-6 py-2 rounded shadow hover:bg-blue-700 transition font-semibold">
            Finalizar Encomenda
        </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Client Selection -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <h2 class="text-lg font-semibold text-[#2B3347] border-b pb-2 mb-4">Dados do Cliente</h2>
                <div class="flex space-x-4">
                    <div class="flex-1">
                        <label class="block text-sm text-gray-600 mb-1">Pesquisar Cliente</label>
                        <div class="flex">
                            <input type="text" placeholder="NIF ou Nome..." class="flex-1 border border-gray-300 rounded-l px-4 py-2 focus:ring-blue-500 focus:border-blue-500" />
                            <button class="bg-gray-100 border border-l-0 border-gray-300 px-4 rounded-r text-gray-600 hover:bg-gray-200">
                                Procurar
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Dados Preenchidos Placeholder -->
                <div class="mt-4 bg-gray-50 p-4 rounded border border-gray-200 grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-xs text-gray-500">Nome</p>
                        <p class="font-semibold text-gray-800">--</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500">NIF</p>
                        <p class="font-semibold text-gray-800">--</p>
                    </div>
                    <div class="col-span-2">
                        <p class="text-xs text-gray-500">Morada</p>
                        <p class="font-semibold text-gray-800">--</p>
                    </div>
                </div>
            </div>

            <!-- Line Items -->
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <div class="flex justify-between items-center border-b pb-2 mb-4">
                    <h2 class="text-lg font-semibold text-[#2B3347]">Linhas da Encomenda</h2>
                    <button class="text-sm bg-green-50 text-green-600 px-3 py-1 rounded hover:bg-green-100 font-semibold">
                        + Adicionar Produto
                    </button>
                </div>
                
                <table class="w-full text-left border-collapse">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm">Artigo</th>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm text-right">Qtd</th>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm text-right">Preço Unit.</th>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm text-right">Desc. %</th>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm text-right">Total</th>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6" class="text-center py-8 text-gray-400">
                                Nenhum artigo adicionado.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Totals Panel -->
        <div class="space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <h2 class="text-lg font-semibold text-[#2B3347] border-b pb-2 mb-4">Resumo Financeiro</h2>
                
                <div class="space-y-3">
                    <div class="flex justify-between text-gray-600">
                        <span>Subtotal (s/ IVA):</span>
                        <span class="font-medium">€ 0.00</span>
                    </div>
                    <div class="flex justify-between text-gray-600">
                        <span>Total IVA:</span>
                        <span class="font-medium">€ 0.00</span>
                    </div>
                    <div class="flex justify-between items-center text-gray-600 border-t pt-3">
                        <span>Desconto Global:</span>
                        <input type="number" class="w-20 border border-gray-300 rounded px-2 py-1 text-right focus:ring-blue-500" placeholder="0" />
                    </div>
                    <div class="flex justify-between items-center text-gray-600">
                        <span>Portes / Outros:</span>
                        <input type="number" class="w-24 border border-gray-300 rounded px-2 py-1 text-right focus:ring-blue-500" placeholder="0.00" />
                    </div>
                </div>

                <div class="mt-6 pt-4 border-t-2 border-gray-800">
                    <div class="flex justify-between items-end">
                        <span class="text-xl font-bold text-gray-800">Total Final:</span>
                        <span class="text-3xl font-black text-[#3F6CD8]">€ 0.00</span>
                    </div>
                </div>
                
                <div class="mt-6">
                    <label class="block text-sm text-gray-600 mb-1">Estado Inicial</label>
                    <select class="w-full border border-gray-300 rounded px-3 py-2 bg-yellow-50 font-bold text-yellow-800 focus:ring-yellow-500">
                        <option value="PENDENTE">PENDENTE</option>
                        <option value="PAGA">PAGA</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Boilerplate for PoC UI
}
