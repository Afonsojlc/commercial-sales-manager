@page "/novavenda"
@using System.Data
@using Microsoft.Data.SqlClient
@inject NavigationManager NavManager

<div class="p-8 h-full overflow-auto">
    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Nova Encomenda</h1>
        <button @onclick="FinalizarEncomenda" class="bg-[#3F6CD8] text-white px-6 py-2 rounded shadow hover:bg-blue-700 transition font-semibold">
            Finalizar Encomenda
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAviso))
    {
        <div class="p-3 mb-6 rounded shadow-sm border @(mensagemAviso.Contains("sucesso") ? "bg-green-50 text-green-800 border-green-200" : "bg-yellow-50 text-yellow-800 border-yellow-200")">
            @mensagemAviso
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Client Selection & Line Items -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Dados do Cliente -->
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <h2 class="text-lg font-semibold text-[#2B3347] border-b pb-2 mb-4">Dados do Cliente</h2>
                
                <div class="relative">
                    <label class="block text-sm text-gray-600 mb-1">Pesquisar Cliente (Nome ou NIF)</label>
                    <div class="flex">
                        <input type="text" @bind="PesquisaCliente" @bind:event="oninput" placeholder="Escreva o NIF ou Nome do cliente..." autocomplete="off" class="flex-1 border border-gray-300 rounded px-4 py-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>

                    @if (clientesResultados != null && clientesResultados.Count > 0)
                    {
                        <div class="absolute z-50 left-0 right-0 mt-1 bg-white border border-gray-200 rounded shadow-xl max-h-56 overflow-y-auto">
                            @foreach (var c in clientesResultados)
                            {
                                <div class="p-3 hover:bg-blue-50 cursor-pointer border-b last:border-0 transition" @onclick="() => SelecionarCliente(c)">
                                    <div class="font-bold text-sm text-gray-800">@c.Nome_Cliente</div>
                                    <div class="text-xs text-gray-500 flex justify-between mt-1">
                                        <span>NIF: <strong>@c.NIF</strong></span>
                                        <span>@c.Morada_Completa</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Dados Preenchidos -->
                <div class="mt-4 bg-gray-50 p-4 rounded border border-gray-200 grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-xs text-gray-500">Nome</p>
                        <p class="font-semibold text-gray-800">@(clienteSelecionado?.Nome_Cliente ?? "--")</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500">NIF</p>
                        <p class="font-semibold text-gray-800">@(clienteSelecionado?.NIF ?? "--")</p>
                    </div>
                    <div class="col-span-2">
                        <p class="text-xs text-gray-500">Morada</p>
                        <p class="font-semibold text-gray-800">@(clienteSelecionado?.Morada_Completa ?? "--")</p>
                    </div>
                </div>
            </div>

            <!-- Adicionar Artigos -->
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <h2 class="text-lg font-semibold text-[#2B3347] border-b pb-2 mb-4">Adicionar Produto</h2>
                <div class="grid grid-cols-12 gap-4 items-end">
                    <!-- Produto Search Autocomplete -->
                    <div class="col-span-4 relative">
                        <label class="block text-xs text-gray-600 mb-1">Artigo (Código ou Nome)</label>
                        <input type="text" @bind="PesquisaProduto" @bind:event="oninput" autocomplete="off" placeholder="Pesquisar artigo..." class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-blue-500" />
                        
                        @if (produtosResultados != null && produtosResultados.Count > 0)
                        {
                            <div class="absolute z-50 left-0 w-80 mt-1 bg-white border border-gray-200 rounded shadow-xl max-h-56 overflow-y-auto">
                                @foreach (var p in produtosResultados)
                                {
                                    <div class="p-2.5 hover:bg-blue-50 cursor-pointer border-b last:border-0 text-xs transition" @onclick="() => SelecionarProduto(p)">
                                        <div class="flex justify-between font-bold text-gray-800">
                                            <span>@p.Codigo</span>
                                            <span class="text-blue-600">€ @p.PVP_Unidade.ToString("N2")</span>
                                        </div>
                                        <div class="text-gray-500 text-xs mt-0.5 truncate">@p.Descricao</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="col-span-3">
                        <label class="block text-xs text-gray-600 mb-1">Descrição</label>
                        <input type="text" @bind="novoArtigoDescricao" readonly class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm bg-gray-50 text-gray-600" />
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs text-gray-600 mb-1">Preço (€)</label>
                        <input type="number" @bind="novoArtigoPreco" readonly class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm bg-gray-50 text-gray-600" />
                    </div>
                    <div class="col-span-1">
                        <label class="block text-xs text-gray-600 mb-1">Desc.(%)</label>
                        <input type="text" @bind="novoArtigoDesconto" placeholder="10+5" class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm" />
                    </div>
                    <div class="col-span-1">
                        <label class="block text-xs text-gray-600 mb-1">Qtd</label>
                        <input type="number" min="1" @bind="novoArtigoQtd" class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm" />
                    </div>
                    <div class="col-span-1">
                        <button @onclick="AdicionarLinha" class="w-full bg-green-50 text-green-700 py-1.5 rounded hover:bg-green-100 font-semibold border border-green-200 text-sm">
                            + Add
                        </button>
                    </div>
                </div>
            </div>

            <!-- Line Items Table -->
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <h2 class="text-lg font-semibold text-[#2B3347] border-b pb-2 mb-4">Linhas da Encomenda</h2>
                <table class="w-full text-left border-collapse">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm">Cód</th>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm">Artigo</th>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm text-right">Qtd</th>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm text-right">Preço Unit.</th>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm text-center">Desc. (%)</th>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm text-right">IVA</th>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm text-right">Total</th>
                            <th class="px-3 py-2 border-b font-medium text-gray-600 text-sm"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (linhas.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-8 text-gray-400">Nenhum artigo adicionado.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var linha in linhas)
                            {
                                <tr class="border-b hover:bg-gray-50">
                                    <td class="px-3 py-2 text-sm font-medium text-gray-800">@linha.Codigo</td>
                                    <td class="px-3 py-2 text-sm text-gray-600">@linha.Descricao</td>
                                    <td class="px-3 py-2 text-sm text-right font-semibold">@linha.Quantidade</td>
                                    <td class="px-3 py-2 text-sm text-right">€ @linha.PrecoUnitario.ToString("N2")</td>
                                    <td class="px-3 py-2 text-sm text-center text-blue-600 font-medium">@(string.IsNullOrEmpty(linha.DescontoTexto) ? "-" : linha.DescontoTexto)</td>
                                    <td class="px-3 py-2 text-sm text-right">@linha.TaxaIva%</td>
                                    <td class="px-3 py-2 text-sm text-right font-bold text-gray-800">€ @linha.TotalLinha.ToString("N2")</td>
                                    <td class="px-3 py-2 text-sm text-center">
                                        <button @onclick="() => RemoverLinha(linha)" class="text-red-500 hover:bg-red-50 px-2 py-1 rounded">✕</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Totals Panel -->
        <div class="space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <h2 class="text-lg font-semibold text-[#2B3347] border-b pb-2 mb-4">Resumo Financeiro</h2>
                
                <div class="space-y-3">
                    <div class="flex justify-between text-gray-600">
                        <span>Subtotal (s/ IVA):</span>
                        <span class="font-medium">€ @subtotal.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between text-gray-600">
                        <span>Total IVA:</span>
                        <span class="font-medium">€ @totalIva.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between items-center text-gray-600 border-t pt-3">
                        <span>Desconto Global (€):</span>
                        <input type="number" @bind="descontoGlobal" @bind:event="oninput" class="w-24 border border-gray-300 rounded px-2 py-1 text-right focus:ring-blue-500" />
                    </div>
                </div>

                <div class="mt-6 pt-4 border-t-2 border-gray-800">
                    <div class="flex justify-between items-end">
                        <span class="text-xl font-bold text-gray-800">Total Final:</span>
                        <span class="text-3xl font-black text-[#3F6CD8]">€ @totalFinal.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string mensagemAviso = "";
    
    // Cliente
    private string _pesquisaCliente = "";
    private string PesquisaCliente
    {
        get => _pesquisaCliente;
        set
        {
            _pesquisaCliente = value;
            ExecutarPesquisaCliente(_pesquisaCliente);
        }
    }
    private List<ClienteSearchResult> clientesResultados = new List<ClienteSearchResult>();
    private ClienteSearchResult? clienteSelecionado = null;

    // Novo Artigo
    private string _pesquisaProduto = "";
    private string PesquisaProduto
    {
        get => _pesquisaProduto;
        set
        {
            _pesquisaProduto = value;
            ExecutarPesquisaProduto(_pesquisaProduto);
        }
    }
    private List<ProdutoSearchResult> produtosResultados = new List<ProdutoSearchResult>();
    private string novoArtigoCodigo = "";
    private string novoArtigoDescricao = "";
    private decimal novoArtigoPreco = 0;
    private decimal novoArtigoIva = 23;
    private string novoArtigoDesconto = "";
    private int novoArtigoQtd = 1;

    // Linhas
    private List<LinhaEncomendaModel> linhas = new List<LinhaEncomendaModel>();

    // Totais
    private decimal descontoGlobal = 0;
    private decimal subtotal => linhas.Sum(l => l.PrecoFinalCalculado * l.Quantidade);
    private decimal totalIva => linhas.Sum(l => (l.PrecoFinalCalculado * (l.TaxaIva / 100m)) * l.Quantidade);
    private decimal totalFinal => (subtotal + totalIva) - descontoGlobal;

    private decimal CalcularDescontoComposto(decimal precoOriginal, string textoDesconto)
    {
        if (string.IsNullOrWhiteSpace(textoDesconto)) return precoOriginal;
        string textoLimpo = textoDesconto.Replace("%", "").Replace(" ", "");
        string[] descontos = textoLimpo.Split('+');
        decimal precoFinal = precoOriginal;
        foreach (string desc in descontos)
        {
            if (decimal.TryParse(desc, out decimal percentagem))
            {
                precoFinal -= (precoFinal * (percentagem / 100m));
            }
        }
        return precoFinal;
    }

    private void ExecutarPesquisaCliente(string termo)
    {
        clientesResultados.Clear();
        mensagemAviso = "";
        if (string.IsNullOrWhiteSpace(termo)) return;

        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = "SELECT ID_Cliente, Nome_Cliente, NIF, Morada_Completa FROM Clientes WHERE NIF LIKE @t OR Nome_Cliente LIKE @t";
                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@t", "%" + termo.Trim() + "%");
                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        while (rd.Read())
                        {
                            clientesResultados.Add(new ClienteSearchResult {
                                ID_Cliente = rd["ID_Cliente"]?.ToString() ?? "",
                                Nome_Cliente = rd["Nome_Cliente"]?.ToString() ?? "",
                                NIF = rd["NIF"]?.ToString() ?? "",
                                Morada_Completa = rd["Morada_Completa"]?.ToString() ?? ""
                            });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                mensagemAviso = "Erro ao pesquisar cliente: " + ex.Message;
            }
        }
    }

    private void SelecionarCliente(ClienteSearchResult c)
    {
        clienteSelecionado = c;
        clientesResultados.Clear();
        _pesquisaCliente = "";
    }

    private void ExecutarPesquisaProduto(string termo)
    {
        produtosResultados.Clear();
        mensagemAviso = "";
        if (string.IsNullOrWhiteSpace(termo))
        {
            return;
        }

        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = "SELECT Codigo, Descricao, PVP_Unidade, Taxa_IVA FROM Material WHERE Codigo LIKE @cod OR Descricao LIKE @cod";
                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@cod", "%" + termo.Trim() + "%");
                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        while (rd.Read())
                        {
                            produtosResultados.Add(new ProdutoSearchResult {
                                Codigo = rd["Codigo"]?.ToString() ?? "",
                                Descricao = rd["Descricao"]?.ToString() ?? "",
                                PVP_Unidade = rd["PVP_Unidade"] != DBNull.Value ? Convert.ToDecimal(rd["PVP_Unidade"]) : 0m,
                                Taxa_IVA = rd["Taxa_IVA"] != DBNull.Value ? Convert.ToDecimal(rd["Taxa_IVA"]) : 23m
                            });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                mensagemAviso = "Erro ao pesquisar produto: " + ex.Message;
            }
        }
    }

    private void SelecionarProduto(ProdutoSearchResult p)
    {
        novoArtigoCodigo = p.Codigo;
        novoArtigoDescricao = p.Descricao;
        novoArtigoPreco = p.PVP_Unidade;
        novoArtigoIva = p.Taxa_IVA;
        _pesquisaProduto = p.Codigo + " - " + p.Descricao;
        produtosResultados.Clear();
    }

    private void AdicionarLinha()
    {
        if (string.IsNullOrWhiteSpace(novoArtigoCodigo) || novoArtigoPreco <= 0 || novoArtigoQtd <= 0) return;

        linhas.Add(new LinhaEncomendaModel
        {
            Codigo = novoArtigoCodigo,
            Descricao = novoArtigoDescricao,
            PrecoUnitario = novoArtigoPreco,
            Quantidade = novoArtigoQtd,
            TaxaIva = novoArtigoIva,
            DescontoTexto = novoArtigoDesconto,
            PrecoFinalCalculado = CalcularDescontoComposto(novoArtigoPreco, novoArtigoDesconto)
        });

        novoArtigoCodigo = "";
        novoArtigoDescricao = "";
        novoArtigoPreco = 0;
        novoArtigoQtd = 1;
        novoArtigoDesconto = "";
        _pesquisaProduto = "";
    }

    private void RemoverLinha(LinhaEncomendaModel l)
    {
        linhas.Remove(l);
    }

    private void FinalizarEncomenda()
    {
        if (clienteSelecionado == null)
        {
            mensagemAviso = "Por favor selecione um cliente.";
            return;
        }
        if (linhas.Count == 0)
        {
            mensagemAviso = "Adicione pelo menos um artigo à encomenda.";
            return;
        }

        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            con.Open();
            using (SqlTransaction transacao = con.BeginTransaction())
            {
                try
                {
                    // 1. Inserir Cabeçalho
                    string queryEnc = @"
                        INSERT INTO Encomenda (Data_Encomenda, Valor_Total, Estado, ID_Cliente, Desconto_Global, ID_Vendedor) 
                        VALUES (@data, @total, 'Fechada', @idCliente, @descGlobal, @idVend);
                        SELECT SCOPE_IDENTITY();";

                    int idEncomenda = 0;
                    using (SqlCommand cmdEnc = new SqlCommand(queryEnc, con, transacao))
                    {
                        cmdEnc.Parameters.AddWithValue("@data", DateTime.Now);
                        cmdEnc.Parameters.AddWithValue("@total", totalFinal);
                        cmdEnc.Parameters.AddWithValue("@idCliente", clienteSelecionado.ID_Cliente);
                        cmdEnc.Parameters.AddWithValue("@descGlobal", descontoGlobal);
                        cmdEnc.Parameters.AddWithValue("@idVend", Sessao.ID_Vendedor);

                        idEncomenda = Convert.ToInt32(cmdEnc.ExecuteScalar());
                    }

                    // 2. Inserir Linhas
                    int linhaNum = 1;
                    foreach (var linha in linhas)
                    {
                        string queryLinha = @"
                            INSERT INTO Linha_Encomenda 
                            (NE, Linha_Encomenda, Quantidade, Descricao, Preco, Desconto, Imposto, Codigo_Material, Desconto_Texto)
                            VALUES 
                            (@ne, @numLinha, @qtd, @desc, @preco, 0, @iva, @codMat, @descTxt)";

                        using (SqlCommand cmdLinha = new SqlCommand(queryLinha, con, transacao))
                        {
                            cmdLinha.Parameters.AddWithValue("@ne", idEncomenda);
                            cmdLinha.Parameters.AddWithValue("@numLinha", linhaNum++);
                            cmdLinha.Parameters.AddWithValue("@qtd", linha.Quantidade);
                            cmdLinha.Parameters.AddWithValue("@desc", linha.Descricao);
                            cmdLinha.Parameters.AddWithValue("@preco", linha.PrecoUnitario);
                            cmdLinha.Parameters.AddWithValue("@iva", linha.TaxaIva);
                            cmdLinha.Parameters.AddWithValue("@codMat", linha.Codigo);
                            cmdLinha.Parameters.AddWithValue("@descTxt", linha.DescontoTexto);
                            cmdLinha.ExecuteNonQuery();
                        }
                        
                        // Abater Stock
                        string queryStock = "UPDATE Material SET Stock = Stock - @qtd WHERE Codigo = @cod";
                        using (SqlCommand cmdStock = new SqlCommand(queryStock, con, transacao))
                        {
                            cmdStock.Parameters.AddWithValue("@qtd", linha.Quantidade);
                            cmdStock.Parameters.AddWithValue("@cod", linha.Codigo);
                            cmdStock.ExecuteNonQuery();
                        }
                    }

                    transacao.Commit();
                    
                    // Reset View
                    clienteSelecionado = null;
                    linhas.Clear();
                    descontoGlobal = 0;
                    _pesquisaCliente = "";
                    _pesquisaProduto = "";
                    mensagemAviso = "Encomenda #" + idEncomenda + " finalizada com sucesso!";
                }
                catch (Exception ex)
                {
                    transacao.Rollback();
                    mensagemAviso = "Erro ao finalizar venda: " + ex.Message;
                }
            }
        }
    }

    public class LinhaEncomendaModel
    {
        public string Codigo { get; set; } = "";
        public string Descricao { get; set; } = "";
        public int Quantidade { get; set; }
        public decimal PrecoUnitario { get; set; }
        public decimal TaxaIva { get; set; }
        public string DescontoTexto { get; set; } = "";
        public decimal PrecoFinalCalculado { get; set; }
        public decimal TotalLinha => Quantidade * PrecoFinalCalculado * (1 + TaxaIva / 100m);
    }

    public class ClienteSearchResult 
    {
        public string ID_Cliente { get; set; } = "";
        public string Nome_Cliente { get; set; } = "";
        public string NIF { get; set; } = "";
        public string Morada_Completa { get; set; } = "";
    }

    public class ProdutoSearchResult 
    {
        public string Codigo { get; set; } = "";
        public string Descricao { get; set; } = "";
        public decimal PVP_Unidade { get; set; }
        public decimal Taxa_IVA { get; set; }
    }
}
