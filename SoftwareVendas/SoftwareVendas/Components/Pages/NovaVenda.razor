@page "/novavenda"
@page "/novavenda/{IdEditar:int}"
@using System.Data
@using Microsoft.Data.SqlClient
@inject NavigationManager NavManager

<div class="p-4 sm:p-6 space-y-6 max-w-[1720px] mx-auto w-full">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                    @(modoEdicao ? $"Modificar Encomenda #{idEncomendaEditar}" : "Nova Encomenda")
                </h1>
                @if (modoEdicao)
                {
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium tracking-wide bg-amber-500/10 text-amber-400 border border-amber-500/30">
                        MODO EDIÇÃO
                    </span>
                }
                else
                {
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium tracking-wide bg-cobalt-500/10 text-cobalt-400 border border-cobalt-500/20">
                        AJLC // NOVA VENDA
                    </span>
                }
            </div>
            <p class="text-xs text-slate-400 mt-1">
                @(modoEdicao ? "Os artigos e descontos desta encomenda serão atualizados e o inventário (stock) reajustado automaticamente." : "Registo de nova nota de encomenda de venda com cálculo automático de margem e comissões.")
            </p>
        </div>

        <div class="flex items-center gap-3">
            @if (modoEdicao)
            {
                <button @onclick="CancelarEdicao" class="px-4 py-2.5 rounded-2xl bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 font-semibold text-xs transition">
                    Cancelar
                </button>
                <button @onclick="FinalizarEncomenda" class="px-5 py-2.5 rounded-2xl bg-amber-500 hover:bg-amber-400 text-obsidian-950 font-bold text-xs shadow-[0_0_20px_rgba(245,158,11,0.3)] transition-all flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>Guardar Alterações</span>
                </button>
            }
            else
            {
                <button @onclick="FinalizarEncomenda" class="px-6 py-2.5 rounded-2xl bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs shadow-glow-cobalt transition-all flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>Emitir Encomenda</span>
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAviso))
    {
        <div class="p-4 rounded-2xl shadow-floating-card border flex justify-between items-center @(mensagemAviso.Contains("sucesso") ? "bg-emerald-500/10 text-emerald-300 border-emerald-500/30" : "bg-amber-500/10 text-amber-300 border-amber-500/30")">
            <div class="text-xs font-medium flex items-center gap-2">
                @if (mensagemAviso.Contains("sucesso"))
                {
                    <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                }
                else
                {
                    <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                }
                <span>@mensagemAviso</span>
            </div>
            @if (modoEdicao && mensagemAviso.Contains("sucesso"))
            {
                <button @onclick="VoltarDetalhes" class="bg-emerald-500 hover:bg-emerald-400 text-obsidian-950 px-3 py-1.5 rounded-xl text-xs font-bold transition">
                    Ver Detalhes da Encomenda &rarr;
                </button>
            }
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Client Selection & Line Items -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Dados do Cliente -->
            <div class="rounded-3xl glass-panel p-6 shadow-floating-card">
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/10">
                    <h2 class="text-base font-bold text-white tracking-tight flex items-center gap-2">
                        <svg class="w-4 h-4 text-cobalt-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        Identificação do Cliente
                    </h2>
                    @if (clienteSelecionado != null)
                    {
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                            CLIENTE VINCULADO
                        </span>
                    }
                </div>
                
                <div class="relative">
                    <label class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-1.5">Pesquisar Cliente (Nome ou NIF)</label>
                    <div class="relative">
                        <input type="text" @bind="PesquisaCliente" @bind:event="oninput" placeholder="Escreva o NIF ou Nome do cliente..." autocomplete="off" class="w-full glass-input rounded-2xl px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500" />
                        <svg class="w-4 h-4 text-slate-400 absolute right-3.5 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>

                    @if (clientesResultados != null && clientesResultados.Count > 0)
                    {
                        <div class="absolute z-50 left-0 right-0 mt-2 bg-obsidian-900/95 backdrop-blur-xl border border-cobalt-500/30 rounded-2xl shadow-2xl max-h-60 overflow-y-auto divide-y divide-white/5">
                            @foreach (var c in clientesResultados)
                            {
                                <div class="p-3.5 hover:bg-cobalt-500/10 cursor-pointer transition flex items-center justify-between" @onclick="() => SelecionarCliente(c)">
                                    <div>
                                        <div class="font-bold text-sm text-white">@c.Nome_Cliente</div>
                                        <div class="text-xs text-slate-400 mt-0.5">@c.Morada_Completa</div>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-xs font-mono text-cobalt-400 bg-cobalt-500/10 px-2 py-0.5 rounded-lg border border-cobalt-500/20">NIF: @c.NIF</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Dados Preenchidos -->
                <div class="mt-4 bg-obsidian-950/70 p-4 rounded-2xl border border-white/10 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
                    <div>
                        <p class="font-mono uppercase tracking-wider text-[10px] text-slate-400">Nome / Razão Social</p>
                        <p class="font-semibold text-white mt-0.5 truncate">@(clienteSelecionado?.Nome_Cliente ?? "--")</p>
                    </div>
                    <div>
                        <p class="font-mono uppercase tracking-wider text-[10px] text-slate-400">NIF Contribuinte</p>
                        <p class="font-mono font-semibold text-cobalt-400 mt-0.5">@(clienteSelecionado?.NIF ?? "--")</p>
                    </div>
                    <div class="sm:col-span-1">
                        <p class="font-mono uppercase tracking-wider text-[10px] text-slate-400">Morada</p>
                        <p class="font-medium text-slate-300 mt-0.5 truncate">@(clienteSelecionado?.Morada_Completa ?? "--")</p>
                    </div>
                </div>
            </div>

            <!-- Adicionar Artigos -->
            <div class="rounded-3xl glass-panel p-6 shadow-floating-card">
                <h2 class="text-base font-bold text-white tracking-tight flex items-center gap-2 pb-3 mb-4 border-b border-white/10">
                    <svg class="w-4 h-4 text-cobalt-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                    Adicionar Produto ao Pedido
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
                    <!-- Produto Search Autocomplete -->
                    <div class="sm:col-span-4 relative">
                        <label class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1">Artigo (Cód / Descrição)</label>
                        <input type="text" @bind="PesquisaProduto" @bind:event="oninput" autocomplete="off" placeholder="Pesquisar artigo..." class="w-full glass-input rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500" />
                        
                        @if (produtosResultados != null && produtosResultados.Count > 0)
                        {
                            <div class="absolute z-50 left-0 w-80 mt-2 bg-obsidian-900/95 backdrop-blur-xl border border-cobalt-500/30 rounded-2xl shadow-2xl max-h-60 overflow-y-auto divide-y divide-white/5">
                                @foreach (var p in produtosResultados)
                                {
                                    <div class="p-3 hover:bg-cobalt-500/10 cursor-pointer text-xs transition" @onclick="() => SelecionarProduto(p)">
                                        <div class="flex justify-between items-center font-mono">
                                            <span class="font-bold text-white">@p.Codigo</span>
                                            <span class="text-cobalt-400 font-bold">€ @p.PVP_Unidade.ToString("N2")</span>
                                        </div>
                                        <div class="text-slate-400 text-xs mt-1 truncate">@p.Descricao</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="sm:col-span-3">
                        <label class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1">Descrição</label>
                        <input type="text" @bind="novoArtigoDescricao" readonly class="w-full glass-input rounded-xl px-3 py-2 text-xs bg-white/[0.03] text-slate-300 border-white/5" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1">Preço Unit (€)</label>
                        <input type="number" @bind="novoArtigoPreco" readonly class="w-full glass-input rounded-xl px-3 py-2 text-xs font-mono bg-white/[0.03] text-slate-300 border-white/5" />
                    </div>
                    <div class="sm:col-span-1">
                        <label class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1" title="Ex: 50+10">Desc.(%)</label>
                        <input type="text" @bind="novoArtigoDesconto" placeholder="50+10" class="w-full glass-input rounded-xl px-2 py-2 text-xs font-mono text-center text-cobalt-300 placeholder-slate-600" />
                    </div>
                    <div class="sm:col-span-1">
                        <label class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1">Qtd</label>
                        <input type="number" min="1" @bind="novoArtigoQtd" class="w-full glass-input rounded-xl px-2 py-2 text-xs font-mono text-center text-white" />
                    </div>
                    <div class="sm:col-span-1">
                        <button @onclick="AdicionarLinha" class="w-full bg-cobalt-600 hover:bg-cobalt-500 text-white py-2 rounded-xl font-bold text-xs shadow-glow-cobalt transition flex items-center justify-center">
                            + Add
                        </button>
                    </div>
                </div>
            </div>

            <!-- Line Items Table -->
            <div class="rounded-3xl glass-panel p-6 shadow-floating-card">
                <div class="flex justify-between items-center pb-3 mb-4 border-b border-white/10">
                    <h2 class="text-base font-bold text-white tracking-tight">Artigos da Encomenda</h2>
                    <span class="text-xs font-mono text-slate-400 bg-white/5 px-2.5 py-1 rounded-xl border border-white/5">
                        @(linhas.Count) item(ns) adicionados
                    </span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="text-[11px] font-mono uppercase tracking-wider text-slate-400 border-b border-white/5">
                                <th class="py-3 px-3 font-semibold">Cód</th>
                                <th class="py-3 px-3 font-semibold">Artigo</th>
                                <th class="py-3 px-3 font-semibold text-right">Qtd</th>
                                <th class="py-3 px-3 font-semibold text-right">Preço Unit.</th>
                                <th class="py-3 px-3 font-semibold text-center">Desc. (%)</th>
                                <th class="py-3 px-3 font-semibold text-right">IVA</th>
                                <th class="py-3 px-3 font-semibold text-right">Total</th>
                                <th class="py-3 px-3 font-semibold text-center"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/[0.03] text-xs">
                            @if (linhas.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-10 text-slate-500 font-mono">
                                        Nenhum artigo adicionado à encomenda. Utilize a barra acima para pesquisar.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var linha in linhas)
                                {
                                    <tr class="hover:bg-white/[0.03] transition-colors">
                                        <td class="py-3.5 px-3 font-mono font-bold text-white">@linha.Codigo</td>
                                        <td class="py-3.5 px-3 text-slate-300 font-medium">@linha.Descricao</td>
                                        <td class="py-3.5 px-3 text-right font-mono font-bold text-white">@linha.Quantidade</td>
                                        <td class="py-3.5 px-3 text-right font-mono text-slate-300">€ @linha.PrecoUnitario.ToString("N2")</td>
                                        <td class="py-3.5 px-3 text-center">
                                            @if (!string.IsNullOrEmpty(linha.DescontoTexto))
                                            {
                                                <span class="px-2 py-0.5 rounded-lg text-[10px] font-mono bg-cobalt-500/10 text-cobalt-400 border border-cobalt-500/20 font-bold">
                                                    @linha.DescontoTexto
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-slate-500 font-mono">-</span>
                                            }
                                        </td>
                                        <td class="py-3.5 px-3 text-right font-mono text-slate-400">@linha.TaxaIva%</td>
                                        <td class="py-3.5 px-3 text-right font-mono font-bold text-white">€ @linha.TotalLinha.ToString("N2")</td>
                                        <td class="py-3.5 px-3 text-center">
                                            <button @onclick="() => RemoverLinha(linha)" class="text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 p-1.5 rounded-lg transition" title="Remover item">
                                                ✕
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Totals Panel -->
        <div class="space-y-6">
            <div class="rounded-3xl glass-panel-glow p-6 sm:p-7 shadow-floating-card border-cobalt-500/30 sticky top-4">
                <h2 class="text-base font-bold text-white tracking-tight border-b border-white/10 pb-3 mb-5 flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-cobalt-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                        Resumo Financeiro
                    </span>
                    <span class="text-[10px] font-mono text-cobalt-400 bg-cobalt-500/10 px-2 py-0.5 rounded-full border border-cobalt-500/20">
                        AJLC // RESUMO
                    </span>
                </h2>
                
                <div class="space-y-3.5 text-xs">
                    <div class="flex justify-between text-slate-400">
                        <span>Subtotal (s/ IVA):</span>
                        <span class="font-mono font-medium text-slate-200">€ @subtotal.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between text-slate-400">
                        <span>Incidência IVA:</span>
                        <span class="font-mono font-medium text-slate-200">€ @totalIva.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between items-center text-slate-400 border-t border-white/10 pt-3.5">
                        <span class="text-slate-300">Desconto Global (€):</span>
                        <input type="number" @bind="descontoGlobal" @bind:event="oninput" class="w-28 glass-input rounded-xl px-2.5 py-1 text-right font-mono text-xs text-white" />
                    </div>
                </div>

                <div class="mt-6 pt-5 border-t border-white/10">
                    <div class="flex justify-between items-baseline mb-2">
                        <span class="text-sm font-semibold uppercase tracking-wider text-slate-400">Total Final:</span>
                        <span class="text-3xl font-extrabold font-mono text-cobalt-400 tracking-tight drop-shadow-[0_0_15px_rgba(59,130,246,0.3)]">
                            € @totalFinal.ToString("N2")
                        </span>
                    </div>
                    <div class="bg-obsidian-950/80 p-3 rounded-2xl border border-white/10 flex justify-between items-center text-xs mt-4">
                        <span class="text-slate-400">Comissão Estimada:</span>
                        <span class="font-mono font-bold text-emerald-400">+ € @((totalFinal * (Sessao.PercentagemComissao / 100m)).ToString("N2"))</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int? IdEditar { get; set; }

    [SupplyParameterFromQuery]
    public string? editar { get; set; }

    private bool modoEdicao = false;
    private int idEncomendaEditar = 0;
    private string mensagemAviso = "";
    
    // Cliente
    private string _pesquisaCliente = "";
    private string PesquisaCliente
    {
        get => _pesquisaCliente;
        set
        {
            _pesquisaCliente = value;
            ExecutarPesquisaCliente(_pesquisaCliente);
        }
    }
    private List<ClienteSearchResult> clientesResultados = new List<ClienteSearchResult>();
    private ClienteSearchResult? clienteSelecionado = null;

    // Novo Artigo
    private string _pesquisaProduto = "";
    private string PesquisaProduto
    {
        get => _pesquisaProduto;
        set
        {
            _pesquisaProduto = value;
            ExecutarPesquisaProduto(_pesquisaProduto);
        }
    }
    private List<ProdutoSearchResult> produtosResultados = new List<ProdutoSearchResult>();
    private string novoArtigoCodigo = "";
    private string novoArtigoDescricao = "";
    private decimal novoArtigoPreco = 0;
    private decimal novoArtigoIva = 23;
    private string novoArtigoDesconto = "";
    private int novoArtigoQtd = 1;

    // Linhas
    private List<LinhaEncomendaModel> linhas = new List<LinhaEncomendaModel>();

    // Totais
    private decimal descontoGlobal = 0;
    private decimal subtotal => linhas.Sum(l => l.PrecoFinalCalculado * l.Quantidade);
    private decimal totalIva => linhas.Sum(l => (l.PrecoFinalCalculado * (l.TaxaIva / 100m)) * l.Quantidade);
    private decimal totalFinal => (subtotal + totalIva) - descontoGlobal;

    protected override void OnParametersSet()
    {
        int idParaCarregar = IdEditar ?? 0;
        if (idParaCarregar == 0 && !string.IsNullOrWhiteSpace(editar) && int.TryParse(editar, out int qId))
        {
            idParaCarregar = qId;
        }

        if (idParaCarregar > 0 && (!modoEdicao || idEncomendaEditar != idParaCarregar))
        {
            CarregarDadosEdicao(idParaCarregar);
        }
        else if (idParaCarregar == 0 && modoEdicao)
        {
            modoEdicao = false;
            idEncomendaEditar = 0;
            clienteSelecionado = null;
            linhas.Clear();
            descontoGlobal = 0;
            _pesquisaCliente = "";
            _pesquisaProduto = "";
            mensagemAviso = "";
        }
    }

    private void CarregarDadosEdicao(int id)
    {
        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();

                // 1. Cabeçalho e Cliente
                string queryEnc = @"
                    SELECT E.Numero_Encomenda, E.Desconto_Global,
                           C.ID_Cliente, C.Nome_Cliente, C.NIF, C.Morada_Completa
                    FROM Encomenda E
                    LEFT JOIN Clientes C ON E.ID_Cliente = C.ID_Cliente
                    WHERE E.Numero_Encomenda = @id";

                using (SqlCommand cmd = new SqlCommand(queryEnc, con))
                {
                    cmd.Parameters.AddWithValue("@id", id);
                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        if (rd.Read())
                        {
                            modoEdicao = true;
                            idEncomendaEditar = id;
                            descontoGlobal = rd["Desconto_Global"] != DBNull.Value ? Convert.ToDecimal(rd["Desconto_Global"]) : 0m;

                            if (rd["ID_Cliente"] != DBNull.Value)
                            {
                                clienteSelecionado = new ClienteSearchResult
                                {
                                    ID_Cliente = rd["ID_Cliente"].ToString()!,
                                    Nome_Cliente = rd["Nome_Cliente"]?.ToString() ?? "",
                                    NIF = rd["NIF"]?.ToString() ?? "",
                                    Morada_Completa = rd["Morada_Completa"]?.ToString() ?? ""
                                };
                            }
                        }
                    }
                }

                // 2. Linhas da Encomenda
                if (modoEdicao)
                {
                    linhas.Clear();
                    string queryLinhas = @"
                        SELECT Codigo_Material, Descricao, Quantidade, Preco, Imposto, Desconto_Texto
                        FROM Linha_Encomenda
                        WHERE NE = @id
                        ORDER BY Linha_Encomenda ASC";

                    using (SqlCommand cmdL = new SqlCommand(queryLinhas, con))
                    {
                        cmdL.Parameters.AddWithValue("@id", id);
                        using (SqlDataReader rdL = cmdL.ExecuteReader())
                        {
                            while (rdL.Read())
                            {
                                string cod = rdL["Codigo_Material"]?.ToString() ?? "";
                                string desc = rdL["Descricao"]?.ToString() ?? "";
                                int qtd = Convert.ToInt32(rdL["Quantidade"]);
                                decimal preco = Convert.ToDecimal(rdL["Preco"]);
                                decimal iva = Convert.ToDecimal(rdL["Imposto"]);
                                string descTxt = rdL["Desconto_Texto"]?.ToString() ?? "";

                                linhas.Add(new LinhaEncomendaModel
                                {
                                    Codigo = cod,
                                    Descricao = desc,
                                    Quantidade = qtd,
                                    PrecoUnitario = preco,
                                    TaxaIva = iva,
                                    DescontoTexto = descTxt,
                                    PrecoFinalCalculado = CalcularDescontoComposto(preco, descTxt)
                                });
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                mensagemAviso = "Erro ao carregar dados para edição: " + ex.Message;
            }
        }
    }

    private decimal CalcularDescontoComposto(decimal precoOriginal, string textoDesconto)
    {
        if (string.IsNullOrWhiteSpace(textoDesconto)) return precoOriginal;
        string textoLimpo = textoDesconto.Replace("%", "").Replace(" ", "").Replace(",", ".");
        string[] descontos = textoLimpo.Split('+');
        decimal precoFinal = precoOriginal;
        foreach (string desc in descontos)
        {
            if (decimal.TryParse(desc, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal percentagem))
            {
                precoFinal -= (precoFinal * (percentagem / 100m));
            }
        }
        return precoFinal;
    }

    private void ExecutarPesquisaCliente(string termo)
    {
        clientesResultados.Clear();
        mensagemAviso = "";
        if (string.IsNullOrWhiteSpace(termo)) return;

        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = "SELECT ID_Cliente, Nome_Cliente, NIF, Morada_Completa FROM Clientes WHERE NIF LIKE @t OR Nome_Cliente LIKE @t";
                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@t", "%" + termo.Trim() + "%");
                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        while (rd.Read())
                        {
                            clientesResultados.Add(new ClienteSearchResult {
                                ID_Cliente = rd["ID_Cliente"]?.ToString() ?? "",
                                Nome_Cliente = rd["Nome_Cliente"]?.ToString() ?? "",
                                NIF = rd["NIF"]?.ToString() ?? "",
                                Morada_Completa = rd["Morada_Completa"]?.ToString() ?? ""
                            });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                mensagemAviso = "Erro ao pesquisar cliente: " + ex.Message;
            }
        }
    }

    private void SelecionarCliente(ClienteSearchResult c)
    {
        clienteSelecionado = c;
        clientesResultados.Clear();
        _pesquisaCliente = "";
    }

    private void ExecutarPesquisaProduto(string termo)
    {
        produtosResultados.Clear();
        mensagemAviso = "";
        if (string.IsNullOrWhiteSpace(termo)) return;

        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = "SELECT Codigo, Descricao, PVP_Unidade, Taxa_IVA FROM Material WHERE Codigo LIKE @cod OR Descricao LIKE @cod";
                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@cod", "%" + termo.Trim() + "%");
                    using (SqlDataReader rd = cmd.ExecuteReader())
                    {
                        while (rd.Read())
                        {
                            produtosResultados.Add(new ProdutoSearchResult {
                                Codigo = rd["Codigo"]?.ToString() ?? "",
                                Descricao = rd["Descricao"]?.ToString() ?? "",
                                PVP_Unidade = rd["PVP_Unidade"] != DBNull.Value ? Convert.ToDecimal(rd["PVP_Unidade"]) : 0m,
                                Taxa_IVA = rd["Taxa_IVA"] != DBNull.Value ? Convert.ToDecimal(rd["Taxa_IVA"]) : 23m
                            });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                mensagemAviso = "Erro ao pesquisar produto: " + ex.Message;
            }
        }
    }

    private void SelecionarProduto(ProdutoSearchResult p)
    {
        novoArtigoCodigo = p.Codigo;
        novoArtigoDescricao = p.Descricao;
        novoArtigoPreco = p.PVP_Unidade;
        novoArtigoIva = p.Taxa_IVA;
        _pesquisaProduto = p.Codigo + " - " + p.Descricao;
        produtosResultados.Clear();
    }

    private void AdicionarLinha()
    {
        if (string.IsNullOrWhiteSpace(novoArtigoCodigo) || novoArtigoPreco <= 0 || novoArtigoQtd <= 0) return;

        linhas.Add(new LinhaEncomendaModel
        {
            Codigo = novoArtigoCodigo,
            Descricao = novoArtigoDescricao,
            PrecoUnitario = novoArtigoPreco,
            Quantidade = novoArtigoQtd,
            TaxaIva = novoArtigoIva,
            DescontoTexto = novoArtigoDesconto,
            PrecoFinalCalculado = CalcularDescontoComposto(novoArtigoPreco, novoArtigoDesconto)
        });

        novoArtigoCodigo = "";
        novoArtigoDescricao = "";
        novoArtigoPreco = 0;
        novoArtigoQtd = 1;
        novoArtigoDesconto = "";
        _pesquisaProduto = "";
    }

    private void RemoverLinha(LinhaEncomendaModel l)
    {
        linhas.Remove(l);
    }

    private void CancelarEdicao()
    {
        if (modoEdicao)
        {
            NavManager.NavigateTo($"/encomendas/{idEncomendaEditar}");
        }
        else
        {
            NavManager.NavigateTo("/encomendas");
        }
    }

    private void VoltarDetalhes()
    {
        NavManager.NavigateTo($"/encomendas/{idEncomendaEditar}");
    }

    private void FinalizarEncomenda()
    {
        if (clienteSelecionado == null)
        {
            mensagemAviso = "Por favor selecione um cliente.";
            return;
        }
        if (linhas.Count == 0)
        {
            mensagemAviso = "Adicione pelo menos um artigo à encomenda.";
            return;
        }

        using (SqlConnection con = new SqlConnection(DatabaseConfig.ConnectionString))
        {
            con.Open();
            using (SqlTransaction transacao = con.BeginTransaction())
            {
                try
                {
                    int idEncomenda = 0;

                    if (modoEdicao)
                    {
                        idEncomenda = idEncomendaEditar;

                        // 1. Atualizar Cabeçalho
                        string queryUpdate = @"
                            UPDATE Encomenda 
                            SET Valor_Total = @total, Desconto_Global = @descGlobal, ID_Cliente = @idCliente
                            WHERE Numero_Encomenda = @id";

                        using (SqlCommand cmdUpdate = new SqlCommand(queryUpdate, con, transacao))
                        {
                            cmdUpdate.Parameters.AddWithValue("@total", totalFinal);
                            cmdUpdate.Parameters.AddWithValue("@descGlobal", descontoGlobal);
                            cmdUpdate.Parameters.AddWithValue("@idCliente", clienteSelecionado.ID_Cliente);
                            cmdUpdate.Parameters.AddWithValue("@id", idEncomenda);
                            cmdUpdate.ExecuteNonQuery();
                        }

                        // 2. Reverter Stock das Linhas Antigas
                        string queryReverterStock = @"
                            UPDATE Material SET Stock = Stock + L.Quantidade
                            FROM Material M 
                            INNER JOIN Linha_Encomenda L ON M.Codigo = L.Codigo_Material
                            WHERE L.NE = @id";

                        using (SqlCommand cmdReverter = new SqlCommand(queryReverterStock, con, transacao))
                        {
                            cmdReverter.Parameters.AddWithValue("@id", idEncomenda);
                            cmdReverter.ExecuteNonQuery();
                        }

                        // 3. Apagar Linhas Antigas
                        string queryApagar = "DELETE FROM Linha_Encomenda WHERE NE = @id";
                        using (SqlCommand cmdApagar = new SqlCommand(queryApagar, con, transacao))
                        {
                            cmdApagar.Parameters.AddWithValue("@id", idEncomenda);
                            cmdApagar.ExecuteNonQuery();
                        }
                    }
                    else
                    {
                        // 1. Inserir Novo Cabeçalho
                        string queryEnc = @"
                            INSERT INTO Encomenda (Data_Encomenda, Valor_Total, Estado, ID_Cliente, Desconto_Global, ID_Vendedor) 
                            VALUES (@data, @total, 'Fechada', @idCliente, @descGlobal, @idVend);
                            SELECT SCOPE_IDENTITY();";

                        using (SqlCommand cmdEnc = new SqlCommand(queryEnc, con, transacao))
                        {
                            cmdEnc.Parameters.AddWithValue("@data", DateTime.Now);
                            cmdEnc.Parameters.AddWithValue("@total", totalFinal);
                            cmdEnc.Parameters.AddWithValue("@idCliente", clienteSelecionado.ID_Cliente);
                            cmdEnc.Parameters.AddWithValue("@descGlobal", descontoGlobal);
                            cmdEnc.Parameters.AddWithValue("@idVend", Sessao.ID_Vendedor);

                            idEncomenda = Convert.ToInt32(cmdEnc.ExecuteScalar());
                        }
                    }

                    // 4. Inserir Linhas
                    int linhaNum = 1;
                    foreach (var linha in linhas)
                    {
                        string queryLinha = @"
                            INSERT INTO Linha_Encomenda 
                            (NE, Linha_Encomenda, Quantidade, Descricao, Preco, Desconto, Imposto, Codigo_Material, Desconto_Texto)
                            VALUES 
                            (@ne, @numLinha, @qtd, @desc, @preco, 0, @iva, @codMat, @descTxt)";

                        using (SqlCommand cmdLinha = new SqlCommand(queryLinha, con, transacao))
                        {
                            cmdLinha.Parameters.AddWithValue("@ne", idEncomenda);
                            cmdLinha.Parameters.AddWithValue("@numLinha", linhaNum++);
                            cmdLinha.Parameters.AddWithValue("@qtd", linha.Quantidade);
                            cmdLinha.Parameters.AddWithValue("@desc", linha.Descricao);
                            cmdLinha.Parameters.AddWithValue("@preco", linha.PrecoUnitario);
                            cmdLinha.Parameters.AddWithValue("@iva", linha.TaxaIva);
                            cmdLinha.Parameters.AddWithValue("@codMat", linha.Codigo);
                            cmdLinha.Parameters.AddWithValue("@descTxt", linha.DescontoTexto);
                            cmdLinha.ExecuteNonQuery();
                        }
                        
                        // Abater Stock
                        string queryStock = "UPDATE Material SET Stock = Stock - @qtd WHERE Codigo = @cod";
                        using (SqlCommand cmdStock = new SqlCommand(queryStock, con, transacao))
                        {
                            cmdStock.Parameters.AddWithValue("@qtd", linha.Quantidade);
                            cmdStock.Parameters.AddWithValue("@cod", linha.Codigo);
                            cmdStock.ExecuteNonQuery();
                        }
                    }

                    transacao.Commit();
                    
                    if (modoEdicao)
                    {
                        mensagemAviso = $"Encomenda #{idEncomenda} modificada com sucesso! O inventário (stock) foi reajustado.";
                    }
                    else
                    {
                        clienteSelecionado = null;
                        linhas.Clear();
                        descontoGlobal = 0;
                        _pesquisaCliente = "";
                        _pesquisaProduto = "";
                        mensagemAviso = $"Encomenda #{idEncomenda} finalizada com sucesso!";
                    }
                }
                catch (Exception ex)
                {
                    transacao.Rollback();
                    mensagemAviso = "Erro ao processar venda: " + ex.Message;
                }
            }
        }
    }

    public class LinhaEncomendaModel
    {
        public string Codigo { get; set; } = "";
        public string Descricao { get; set; } = "";
        public int Quantidade { get; set; }
        public decimal PrecoUnitario { get; set; }
        public decimal TaxaIva { get; set; }
        public string DescontoTexto { get; set; } = "";
        public decimal PrecoFinalCalculado { get; set; }
        public decimal TotalLinha => Quantidade * PrecoFinalCalculado * (1 + TaxaIva / 100m);
    }

    public class ClienteSearchResult 
    {
        public string ID_Cliente { get; set; } = "";
        public string Nome_Cliente { get; set; } = "";
        public string NIF { get; set; } = "";
        public string Morada_Completa { get; set; } = "";
    }

    public class ProdutoSearchResult 
    {
        public string Codigo { get; set; } = "";
        public string Descricao { get; set; } = "";
        public decimal PVP_Unidade { get; set; }
        public decimal Taxa_IVA { get; set; }
    }
}
