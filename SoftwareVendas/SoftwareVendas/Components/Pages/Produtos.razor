@page "/produtos"
@using System.Data.SqlClient
@using SoftwareVendas

<div class="p-8 flex flex-col h-full">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Catálogo de Produtos</h1>
        <button @onclick="AbrirModalNovoProduto" class="bg-[#3F6CD8] text-white px-4 py-2 rounded shadow hover:bg-blue-700 transition flex items-center font-semibold">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Criar Produto
        </button>
    </div>

    <!-- Search -->
    <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 flex items-center mb-6 shrink-0">
        <svg class="w-6 h-6 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <input @bind="termo" @bind:event="oninput" @onkeyup="Pesquisar" type="text" placeholder="Pesquise por código ou descrição..." class="flex-1 border-none outline-none text-lg" />
    </div>

    <!-- Grid of Products -->
    <div class="flex-1 overflow-auto">
        @if (produtos != null && produtos.Count > 0)
        {
            <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 pb-6">
                @foreach (var p in produtos)
                {
                    <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden flex flex-col hover:shadow-md transition group">
                        <div class="bg-[#2B3347] h-2"></div>
                        <div class="p-5 flex-1 flex flex-col">
                            <div class="flex justify-between items-start mb-2">
                                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">@p.Codigo</span>
                                @if(p.Stock > 0)
                                {
                                    <span class="px-2 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded-full">@p.Stock em Stock</span>
                                }
                                else
                                {
                                    <span class="px-2 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded-full">Esgotado</span>
                                }
                            </div>
                            <h3 class="text-lg font-bold text-gray-800 mb-2 leading-tight flex-1">@p.Descricao</h3>
                            
                            <div class="mt-4 flex items-end justify-between">
                                <div>
                                    <p class="text-sm text-gray-500 mb-1">PVP s/ IVA</p>
                                    <p class="text-2xl font-bold text-[#3F6CD8]">€ @p.Preco.ToString("N2")</p>
                                </div>
                                <div class="text-right">
                                    <span class="text-xs text-gray-500">IVA 23%</span>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Actions -->
                        <div class="border-t border-gray-100 bg-gray-50 p-3 flex justify-end space-x-2 opacity-0 group-hover:opacity-100 transition-opacity">
                            <button @onclick="() => ConfirmarApagar(p.Codigo, p.Descricao)" class="text-red-500 hover:bg-red-50 p-2 rounded transition" title="Eliminar">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                            <button @onclick="() => ConfirmarUpdate(p.Codigo, p.Descricao)" class="text-blue-500 hover:bg-blue-50 p-2 rounded transition" title="Atualizar Stock">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @if (mostrarModalDelete)
    {
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div class="bg-white rounded-lg p-6 max-w-md w-full shadow-xl">
                <h3 class="text-xl font-bold text-gray-800 mb-4">Confirmar Eliminação</h3>
                <p class="text-gray-600 mb-6">Tem a certeza que deseja eliminar o produto <strong>@produtoApagarNome</strong>?</p>
                <div class="flex justify-end space-x-3">
                    <button @onclick="CancelarApagar" class="px-4 py-2 text-gray-600 bg-gray-100 hover:bg-gray-200 rounded">Cancelar</button>
                    <button @onclick="ExecutarApagar" class="px-4 py-2 text-white bg-red-600 hover:bg-red-700 rounded shadow">Eliminar Produto</button>
                </div>
            </div>
        </div>
    }

    @if (mostrarModalUpdate)
    {
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div class="bg-white rounded-lg p-6 max-w-md w-full shadow-xl">
                <h3 class="text-xl font-bold text-gray-800 mb-4">Atualizar Stock: @produtoUpdateNome</h3>
                <div class="mb-6">
                    <label class="block text-sm text-gray-600 mb-1">Nova Quantidade (Somar/Subtrair)</label>
                    <input type="number" @bind="produtoUpdateQtd" class="w-full border border-gray-300 rounded px-4 py-2 focus:ring-blue-500" />
                </div>
                <div class="flex justify-end space-x-3">
                    <button @onclick="CancelarUpdate" class="px-4 py-2 text-gray-600 bg-gray-100 hover:bg-gray-200 rounded">Cancelar</button>
                    <button @onclick="ExecutarUpdate" class="px-4 py-2 text-white bg-blue-600 hover:bg-blue-700 rounded shadow">Atualizar Stock</button>
                </div>
            </div>
        </div>
    }

    @if (mostrarModalNovo)
    {
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div class="bg-white rounded-lg p-6 max-w-xl w-full shadow-xl">
                <h3 class="text-xl font-bold text-gray-800 mb-4">Novo Produto</h3>
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-sm text-gray-600 mb-1">Código *</label>
                        <input type="text" @bind="novoProdCodigo" placeholder="Ex: MAT-010" class="w-full border border-gray-300 rounded px-3 py-2 focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-sm text-gray-600 mb-1">Categoria</label>
                        <select @bind="novoProdTipo" class="w-full border border-gray-300 rounded px-3 py-2 focus:ring-blue-500">
                            <option value="Material">Material</option>
                            <option value="Equipamento">Equipamento</option>
                            <option value="Acessórios">Acessórios</option>
                            <option value="Geral">Geral</option>
                        </select>
                    </div>
                    <div class="col-span-2">
                        <label class="block text-sm text-gray-600 mb-1">Descrição *</label>
                        <input type="text" @bind="novoProdDescricao" placeholder="Descrição detalhada do artigo..." class="w-full border border-gray-300 rounded px-3 py-2 focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-sm text-gray-600 mb-1">Preço (s/ IVA)</label>
                        <input type="number" @bind="novoProdPreco" step="0.01" class="w-full border border-gray-300 rounded px-3 py-2 focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-sm text-gray-600 mb-1">Stock Inicial</label>
                        <input type="number" @bind="novoProdStock" class="w-full border border-gray-300 rounded px-3 py-2 focus:ring-blue-500" />
                    </div>
                </div>
                @if(!string.IsNullOrEmpty(novoProdErro)) { <p class="text-red-500 mb-4 text-sm">@novoProdErro</p> }
                <div class="flex justify-end space-x-3">
                    <button @onclick="CancelarNovoProduto" class="px-4 py-2 text-gray-600 bg-gray-100 hover:bg-gray-200 rounded">Cancelar</button>
                    <button @onclick="GuardarNovoProduto" class="px-4 py-2 text-white bg-blue-600 hover:bg-blue-700 rounded shadow">Guardar</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string termo = "";
    private List<ProdutoDTO>? produtos;

    private bool mostrarModalDelete = false;
    private string produtoApagarCodigo = "";
    private string produtoApagarNome = "";

    private bool mostrarModalUpdate = false;
    private string produtoUpdateCodigo = "";
    private string produtoUpdateNome = "";
    private int produtoUpdateQtd = 0;

    private bool mostrarModalNovo = false;
    private string novoProdCodigo = "";
    private string novoProdDescricao = "";
    private decimal novoProdPreco = 0;
    private int novoProdStock = 0;
    private string novoProdTipo = "Material";
    private string novoProdErro = "";

    private void AbrirModalNovoProduto()
    {
        novoProdCodigo = ""; novoProdDescricao = ""; novoProdPreco = 0; novoProdStock = 0; novoProdErro = "";
        mostrarModalNovo = true;
    }

    private void CancelarNovoProduto() => mostrarModalNovo = false;

    private void GuardarNovoProduto()
    {
        if(string.IsNullOrWhiteSpace(novoProdCodigo) || string.IsNullOrWhiteSpace(novoProdDescricao)) {
            novoProdErro = "Preencha os campos obrigatórios."; return;
        }

        using (Microsoft.Data.SqlClient.SqlConnection con = new Microsoft.Data.SqlClient.SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string q = @"
                    INSERT INTO Material (Codigo, Descricao, PVP_Unidade, Stock, Taxa_IVA, ID_Tipo, Unidade_Venda) 
                    VALUES (@c, @d, @p, @s, 23, @t, 'UN')";

                using (Microsoft.Data.SqlClient.SqlCommand cmd = new Microsoft.Data.SqlClient.SqlCommand(q, con))
                {
                    cmd.Parameters.AddWithValue("@c", novoProdCodigo.Trim());
                    cmd.Parameters.AddWithValue("@d", novoProdDescricao.Trim());
                    cmd.Parameters.AddWithValue("@p", novoProdPreco);
                    cmd.Parameters.AddWithValue("@s", novoProdStock);
                    cmd.Parameters.AddWithValue("@t", novoProdTipo);
                    cmd.ExecuteNonQuery();
                }
                mostrarModalNovo = false;
                CarregarProdutos();
            }
            catch (Exception ex)
            {
                novoProdErro = "Erro: " + ex.Message;
            }
        }
    }

    protected override void OnInitialized()
    {
        CarregarProdutos();
    }

    private void Pesquisar()
    {
        CarregarProdutos();
    }

    private void CarregarProdutos()
    {
        produtos = new List<ProdutoDTO>();
        using (Microsoft.Data.SqlClient.SqlConnection conn = new Microsoft.Data.SqlClient.SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                conn.Open();
                string query = "SELECT TOP 50 Codigo, Descricao, PVP_Unidade, Stock FROM Material WHERE Codigo LIKE @Search OR Descricao LIKE @Search";
                using (Microsoft.Data.SqlClient.SqlCommand cmd = new Microsoft.Data.SqlClient.SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@Search", "%" + termo + "%");
                    using (Microsoft.Data.SqlClient.SqlDataReader reader = cmd.ExecuteReader())
                    {
                        while (reader.Read())
                        {
                            produtos.Add(new ProdutoDTO
                            {
                                Codigo = reader["Codigo"].ToString()!,
                                Descricao = reader["Descricao"].ToString()!,
                                Preco = Convert.ToDecimal(reader["PVP_Unidade"]),
                                Stock = Convert.ToInt32(reader["Stock"])
                            });
                        }
                    }
                }
            }
            catch { }
        }
    }

    private void ConfirmarUpdate(string codigo, string nome)
    {
        produtoUpdateCodigo = codigo;
        produtoUpdateNome = nome;
        produtoUpdateQtd = 0;
        mostrarModalUpdate = true;
    }

    private void CancelarUpdate()
    {
        mostrarModalUpdate = false;
    }

    private void ExecutarUpdate()
    {
        if (produtoUpdateQtd == 0)
        {
            mostrarModalUpdate = false;
            return;
        }

        using (Microsoft.Data.SqlClient.SqlConnection con = new Microsoft.Data.SqlClient.SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = "UPDATE Material SET Stock = Stock + @qtd WHERE Codigo = @cod";
                using (Microsoft.Data.SqlClient.SqlCommand cmd = new Microsoft.Data.SqlClient.SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@qtd", produtoUpdateQtd);
                    cmd.Parameters.AddWithValue("@cod", produtoUpdateCodigo);
                    cmd.ExecuteNonQuery();
                }
            }
            catch { }
        }
        mostrarModalUpdate = false;
        CarregarProdutos();
    }

    private void ConfirmarApagar(string codigo, string nome)
    {
        produtoApagarCodigo = codigo;
        produtoApagarNome = nome;
        mostrarModalDelete = true;
    }

    private void CancelarApagar()
    {
        mostrarModalDelete = false;
    }

    private void ExecutarApagar()
    {
        using (Microsoft.Data.SqlClient.SqlConnection con = new Microsoft.Data.SqlClient.SqlConnection(DatabaseConfig.ConnectionString))
        {
            try
            {
                con.Open();
                string query = "DELETE FROM Material WHERE Codigo = @cod AND NOT EXISTS (SELECT 1 FROM Linha_Encomenda WHERE Codigo_Material = @cod)";
                using (Microsoft.Data.SqlClient.SqlCommand cmd = new Microsoft.Data.SqlClient.SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@cod", produtoApagarCodigo);
                    cmd.ExecuteNonQuery();
                }
            }
            catch { }
        }
        mostrarModalDelete = false;
        CarregarProdutos();
    }
}
